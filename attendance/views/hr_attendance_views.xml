<record id="view_hr_attendance_tree" model="ir.ui.view">
    <field name="name">hr.attendance.tree</field>
    <field name="model">hr.attendance</field>
    <field name="arch" type="xml">
        <tree>
            <field name="employee_id" widget="many2one_avatar_user"/>
            <field name="check_in"/>
            <field name="check_out"/>
            <field name="worked_hours" string="Work Hours" widget="float_time"/>
            <field name="overtime_hours" string="Over Time" optional="show" widget="float_time"/>
            <field name="late_arr"/> <!-- Ensure this field is present -->
        </tree>
    </field>
</record>
