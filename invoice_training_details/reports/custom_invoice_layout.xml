<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="custom_invoice_report_layout"
              inherit_id="web.external_layout_standard"
              primary="True">

        <!-- IMPORTANT:
             Odoo 17 external_layout_standard adds a <div class="pt-5">
             before the report body. That pt-5 is the extra blank space.
             Keep the structure, remove ONLY that padding. -->
        <xpath expr="//div[contains(@t-attf-class, 'article')]/div[@class='pt-5']"
               position="attributes">
            <attribute name="class"></attribute>
            <attribute name="style">padding-top:0 !important; margin-top:0 !important;</attribute>
        </xpath>

        <!-- HEADER -->
        <div t-attf-class="header o_company_#{company.id}_layout" position="replace">

            <t t-set="company" t-value="o.company_id if o else request.env.company"/>

            <div t-attf-class="header o_company_#{company.id}_layout"
                 style="padding:0; margin:0;">

                <div class="row"
                     style="
                        margin:0;
                        padding:0;
                        width:100%;
                        align-items:flex-start;
                     ">

                    <!-- COMPANY INFORMATION -->
                    <div class="col-9"
                         style="
                            padding:0;
                            margin:0;
                            line-height:1.35;
                         ">

                        <!-- Company Name -->
                        <div style="
                            margin:0 0 4px 0;
                            padding:0;
                            max-width:540px;
                            font-size:17px;
                            font-weight:700;
                            line-height:1.25;
                            letter-spacing:0;
                            white-space:normal;
                            word-break:normal;
                        ">
                            <t t-esc="company.name"/>
                        </div>

                        <!-- Address without P.O Box -->
                        <div style="
                            margin:0 0 2px 0;
                            padding:0;
                            font-size:12px;
                            font-weight:400;
                            line-height:1.35;
                        ">
                            <t t-if="company.street or company.street2">
                                <span t-if="company.street"
                                      t-esc="(company.street or '').replace('P.O Box 338408', '').replace('P.O. Box 338408', '').strip(' ,')"/>
                                <t t-if="company.street and company.street2">, </t>
                                <span t-if="company.street2"
                                      t-esc="(company.street2 or '').replace('P.O Box 338408', '').replace('P.O. Box 338408', '').strip(' ,')"/>
                            </t>
                        </div>

                        <!-- P.O Box -->
                        <div t-if="'P.O Box 338408' in (company.street or '') or 'P.O. Box 338408' in (company.street or '') or 'P.O Box 338408' in (company.street2 or '') or 'P.O. Box 338408' in (company.street2 or '')"
                             style="margin:0 0 2px 0; padding:0; font-size:12px; font-weight:400; line-height:1.35;">
                            P.O Box 338408
                        </div>

                        <div t-if="company.city or company.state_id or company.zip or company.country_id"
                             style="margin:0 0 3px 0; padding:0; font-size:12px; font-weight:400; line-height:1.35;">

                            <span t-if="company.city" t-field="company.city"/>

                            <t t-if="company.state_id">
                                <t t-if="company.city">, </t>
                                <span t-field="company.state_id.name"/>
                            </t>

                            <t t-if="company.zip">
                                <t t-if="company.city or company.state_id"> </t>
                                <span t-field="company.zip"/>
                            </t>

                            <t t-if="company.country_id">
                                <t t-if="company.city or company.state_id or company.zip">, </t>
                                <span t-field="company.country_id.name"/>
                            </t>

                        </div>

                        <!-- Contact -->
                        <div t-if="company.phone"
                             style="margin:0 0 2px 0; font-size:12px; line-height:1.35;">
                            <span t-field="company.phone"/>
                        </div>

                        <!-- Email + Tax Number -->
                        <div t-if="company.email or company.vat"
                             style="margin:0 0 2px 0; font-size:12px; line-height:1.35;">
                            <span t-if="company.email" t-field="company.email"/>
                            <t t-if="company.email and company.vat"> | </t>
                            <t t-if="company.vat">
                                <strong style="font-weight:600;">Tax Number:</strong>
                                <span t-esc="company.vat"/>
                            </t>
                        </div>

                        <!-- Saudi CRN -->
                        <div t-if="company.country_id and company.country_id.name == 'Saudi Arabia' and company.l10n_sa_additional_identification_number"
                             style="margin:0; font-size:12px; line-height:1.35;">
                            <strong style="font-weight:600;">CRN:</strong>
                            <span t-esc="company.l10n_sa_additional_identification_number"/>
                        </div>

                    </div>

                    <!-- LOGO -->
                    <div class="col-3"
                         style="
                            padding:0;
                            margin:0;
                            text-align:right;
                         ">

                        <img t-if="company.logo"
                             t-att-src="image_data_uri(company.logo)"
                             style="
                                max-height:105px;
                                max-width:180px;
                                width:auto;
                                height:auto;
                                object-fit:contain;
                                margin:0;
                                padding:0;
                             "
                             alt="Logo"/>

                    </div>

                </div>

                <!-- =====================================================
                     PO / WO REPEAT META
                     Repeats naturally because it is inside the PDF header.
                     Enabled ONLY by report_po_document_training through
                     o.env.context['po_repeat_header'].
                     ===================================================== -->
                <t t-if="o and o.env.context.get('po_repeat_header')">

                    <t t-set="po_vendor_partner"
                       t-value="o.partner_id if o.partner_id.is_company else (o.partner_id.parent_id or o.partner_id)"/>

                    <t t-set="po_is_clc_order"
                       t-value="'clc' in [(method or '').lower() for method in o.training_course_ids.mapped('payment_method')]"/>

                    <div style="
                        width:100%;
                        margin:7px 0 0 0;
                        padding:0;
                        line-height:1.25;
                    ">

                        <div style="
                            display:table;
                            width:100%;
                            table-layout:fixed;
                            margin:0;
                            padding:0;
                        ">

                            <!-- LEFT -->
                            <div style="
                                display:table-cell;
                                width:66%;
                                vertical-align:top;
                                padding:0 16px 0 0;
                            ">

                                <div style="
                                    margin:0 0 3px 0;
                                    padding:0;
                                    font-size:16px;
                                    font-weight:500;
                                    color:#0DCAF0;
                                ">
                                    <span t-if="po_is_clc_order">Work Order</span>
                                    <span t-if="not po_is_clc_order">Purchase Order</span>
                                </div>

                                <div style="margin:0 0 2px 0; font-size:12px;">
                                    <strong style="color:#0DCAF0;">Company Name:</strong>
                                    <span t-field="po_vendor_partner.name"/>
                                </div>

                                <div style="margin:0 0 2px 0; font-size:12px;">
                                    <strong style="color:#0DCAF0;">Address:</strong>

                                    <span t-if="po_vendor_partner.street"
                                          t-field="po_vendor_partner.street"/>

                                    <t t-if="po_vendor_partner.street2">
                                        <t t-if="po_vendor_partner.street">, </t>
                                        <span t-field="po_vendor_partner.street2"/>
                                    </t>

                                    <t t-if="po_vendor_partner.city">
                                        <t t-if="po_vendor_partner.street or po_vendor_partner.street2">, </t>
                                        <span t-field="po_vendor_partner.city"/>
                                    </t>

                                    <t t-if="po_vendor_partner.state_id">
                                        <t t-if="po_vendor_partner.street or po_vendor_partner.street2 or po_vendor_partner.city">, </t>
                                        <span t-field="po_vendor_partner.state_id.name"/>
                                    </t>

                                    <t t-if="po_vendor_partner.zip">
                                        <t t-if="po_vendor_partner.street or po_vendor_partner.street2 or po_vendor_partner.city or po_vendor_partner.state_id"> </t>
                                        <span t-field="po_vendor_partner.zip"/>
                                    </t>

                                    <t t-if="po_vendor_partner.country_id">
                                        <t t-if="po_vendor_partner.street or po_vendor_partner.street2 or po_vendor_partner.city or po_vendor_partner.state_id or po_vendor_partner.zip">, </t>
                                        <span t-field="po_vendor_partner.country_id.name"/>
                                    </t>
                                </div>

                                <div t-if="o.partner_id.email or po_vendor_partner.email"
                                     style="margin:0; font-size:12px;">
                                    <strong style="color:#0DCAF0;">Email:</strong>

                                    <span t-if="o.partner_id.email"
                                          t-field="o.partner_id.email"/>

                                    <span t-else=""
                                          t-field="po_vendor_partner.email"/>
                                </div>

                            </div>


                            <!-- RIGHT -->
                            <div style="
                                display:table-cell;
                                width:34%;
                                vertical-align:top;
                                padding:20px 0 0 0;
                            ">

                                <div style="
                                    margin-left:auto;
                                    width:220px;
                                    font-size:12px;
                                    line-height:1.3;
                                ">

                                    <div style="margin:0 0 2px 0; white-space:nowrap;">
                                        <strong style="color:#0DCAF0;">
                                            <span t-if="po_is_clc_order">Work Order:</span>
                                            <span t-if="not po_is_clc_order">Purchase Order:</span>
                                        </strong>

                                        <span t-if="po_is_clc_order"
                                              t-esc="o.name.replace('PO-', 'WO-', 1) if o.name.startswith('PO-') else ('WO-' + o.name if not o.name.startswith('WO-') else o.name)"/>

                                        <span t-if="not po_is_clc_order"
                                              t-field="o.name"/>
                                    </div>

                                    <div style="margin:0 0 2px 0; white-space:nowrap;">
                                        <strong style="color:#0DCAF0;">DATE:</strong>
                                        <span t-field="o.date_order"
                                              t-options="{&quot;widget&quot;:&quot;date&quot;}"/>
                                    </div>

                                    <div t-if="o.validity_date"
                                         style="margin:0; white-space:nowrap;">
                                        <strong style="color:#0DCAF0;">Validity Date:</strong>
                                        <span t-field="o.validity_date"/>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </t>

            </div>

        </div>

        <!-- FOOTER -->
        <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
            <div class="text-center">
                <strong> </strong>
            </div>
        </div>

    </template>
</odoo>
