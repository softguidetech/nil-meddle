from odoo import models, fields, api

class InvoiceReport(models.AbstractModel):
    _name = 'report.nilmiddleeast.report_invoice_document_training'
    _description = 'Custom Invoice Report for Training'

    @api.model
    def _get_report_values(self, docids, data=None):
        # جلب البيانات بناءً على الـ docids الذي تم تمريره
        docs = self.env['account.move'].browse(docids)
        
        # إرجاع القيم الخاصة بالتقرير
        return {
            'doc_ids': docids,
            'doc_model': 'account.move',  # يجب أن يتوافق مع النموذج الذي تريد استخدامه
            'docs': docs,
            'data': data,
        }
