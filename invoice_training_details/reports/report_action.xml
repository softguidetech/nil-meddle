<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_invoice_document_training" name="Invoice Report Training">

        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <t t-set="lang" t-value="o.partner_id.lang"/>

                <t t-call="invoice_training_details.custom_invoice_report_layout">

                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>

                    <div class="row">
                        <div class="col-12">
                            <span class="h4 text-info">TAX INVOICE</span>
                        </div>
                    </div>

                    <div class="row pt-3 pb-3">

                        <div class="col-8">
                            <div>

                                <!--<strong>INVOICE TO</strong>-->

                                <strong t-if="o.partner_id.is_company == True">
                                    Company Name:
                                </strong>
                                <br/>

                                <div
                                    t-if="o.partner_id.is_company == True"
                                    t-field="o.partner_id.name"
                                />

                                <strong t-if="o.partner_id.is_company == False">
                                    Company Name:
                                </strong>
                                <br/>

                                <div
                                    t-if="o.partner_id.is_company == False"
                                    t-field="o.partner_id.parent_id.name"
                                />


                                <!-- TAX# - ONLY IF VALUE EXISTS -->
                                <div t-if="o.partner_id.vat">
                                    TAX#:
                                    <strong t-field="o.partner_id.vat"/>
                                </div>


                                <strong t-if="o.partner_id.is_company == False">
                                    Attention:
                                </strong>
                                <br/>

                                <div
                                    t-if="o.partner_id.is_company == False"
                                    t-field="o.partner_id.name"
                                />


                                <!-- ================== ADDED: CUSTOMER CR + FULL ADDRESS (EN) ================== -->

                                <!-- COMMERCIAL REGISTRATION - ONLY IF VALUE EXISTS -->
                                <div
                                    class="pt-1"
                                    t-if="(o.partner_id.is_company and o.partner_id.l10n_sa_additional_identification_number) or (not o.partner_id.is_company and o.partner_id.parent_id.l10n_sa_additional_identification_number)"
                                >
                                    <strong>Commercial Registration:</strong>

                                    <span
                                        t-if="o.partner_id.is_company"
                                        t-field="o.partner_id.l10n_sa_additional_identification_number"
                                    />

                                    <span
                                        t-if="not o.partner_id.is_company"
                                        t-field="o.partner_id.parent_id.l10n_sa_additional_identification_number"
                                    />
                                </div>


                                <div class="pt-1">

                                    <strong>Customer Address:</strong>
                                    <br/>

                                    <t t-if="o.partner_id.is_company == True">

                                        <span
                                            t-if="o.partner_id.street"
                                            t-field="o.partner_id.street"
                                        />

                                        <br t-if="o.partner_id.street"/>

                                        <span
                                            t-if="o.partner_id.street2"
                                            t-field="o.partner_id.street2"
                                        />

                                        <br t-if="o.partner_id.street2"/>

                                        <t t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip">

                                            <span
                                                t-if="o.partner_id.city"
                                                t-field="o.partner_id.city"
                                            />

                                            <t t-if="o.partner_id.state_id">
                                                ,
                                                <span t-field="o.partner_id.state_id.name"/>
                                            </t>

                                            <t t-if="o.partner_id.zip">
                                                <span t-field="o.partner_id.zip"/>
                                            </t>

                                            <br/>

                                        </t>

                                        <span
                                            t-if="o.partner_id.country_id"
                                            t-field="o.partner_id.country_id.name"
                                        />

                                    </t>


                                    <t t-if="o.partner_id.is_company == False">

                                        <span
                                            t-if="o.partner_id.parent_id.street"
                                            t-field="o.partner_id.parent_id.street"
                                        />

                                        <br t-if="o.partner_id.parent_id.street"/>

                                        <span
                                            t-if="o.partner_id.parent_id.street2"
                                            t-field="o.partner_id.parent_id.street2"
                                        />

                                        <br t-if="o.partner_id.parent_id.street2"/>

                                        <t t-if="o.partner_id.parent_id.city or o.partner_id.parent_id.state_id or o.partner_id.parent_id.zip">

                                            <span
                                                t-if="o.partner_id.parent_id.city"
                                                t-field="o.partner_id.parent_id.city"
                                            />

                                            <t t-if="o.partner_id.parent_id.state_id">
                                                ,
                                                <span t-field="o.partner_id.parent_id.state_id.name"/>
                                            </t>

                                            <t t-if="o.partner_id.parent_id.zip">
                                                <span t-field="o.partner_id.parent_id.zip"/>
                                            </t>

                                            <br/>

                                        </t>

                                        <span
                                            t-if="o.partner_id.parent_id.country_id"
                                            t-field="o.partner_id.parent_id.country_id.name"
                                        />

                                    </t>

                                </div>

                                <!-- ================== /ADDED ================== -->

                                <!--<div t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>-->

                            </div>
                        </div>


                        <div class="col-4">
                            <div>

                                <table class="table table-borderless">

                                    <tr class="p-0">
                                        <td class="p-0">
                                            INVOICE
                                        </td>
                                        <td class="p-0">
                                            <span t-field="o.name"/>
                                        </td>
                                    </tr>

                                    <tr class="p-0">
                                        <td class="p-0">
                                            Date
                                        </td>
                                        <td class="p-0">
                                            <span t-field="o.invoice_date"/>
                                        </td>
                                    </tr>

                                    <tr
                                        class="p-0"
                                        t-if="o.invoice_payment_term_id"
                                    >
                                        <td class="p-0">
                                            Payment Terms
                                        </td>
                                        <td class="p-0">
                                            <span t-field="o.invoice_payment_term_id"/>
                                        </td>
                                    </tr>

                                    <tr class="p-0">
                                        <td class="p-0">
                                            Due Date
                                        </td>
                                        <td class="p-0">
                                            <span t-field="o.invoice_date_due"/>
                                        </td>
                                    </tr>

                                </table>

                            </div>
                        </div>

                    </div>


                    <table
                        class="table table-sm o_main_table table-borderless"
                        name="invoice_line_table"
                    >

                        <thead class="bg-light text-info">

                            <tr>

                                <th
                                    name="th_description"
                                    class="text-start"
                                >
                                    <span>DESCRIPTION</span>
                                </th>

                                <th
                                    name="th_quantity"
                                    class="text-end"
                                >
                                    <span>QTY</span>
                                </th>

                                <th
                                    name="th_rate"
                                    class="text-end"
                                >
                                    <span>RATE</span>
                                </th>

                                <th
                                    name="th_taxes"
                                    t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"
                                >
                                    <span>Taxes</span>
                                </th>

                                <th
                                    name="th_amount"
                                    class="text-end"
                                >
                                    <span>Taxable Amount</span>
                                </th>

                                <th
                                    name="th_amount"
                                    class="text-end"
                                >
                                    <span>Total Tax.inc</span>
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <t
                                t-foreach="o.invoice_line_ids"
                                t-as="line"
                            >

                                <tr>

                                    <td
                                        class="text-start"
                                        style="max-width:50px;"
                                    >
                                        <span t-field="line.name"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-field="line.quantity"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-field="line.price_unit"/>
                                    </td>

                                    <t
                                        t-set="taxes"
                                        t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"
                                    />

                                    <td
                                        name="td_taxes"
                                        t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}"
                                    >
                                        <span
                                            t-out="taxes"
                                            id="line_tax_ids"
                                        >
                                            Tax
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <span t-field="line.price_subtotal"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-field="line.price_total"/>
                                    </td>

                                </tr>

                            </t>

                        </tbody>

                    </table>


                    <div class="row pt-3 pb-2">
                        <div class="col-12">
                        </div>
                    </div>


                    <table
                        t-if="o.display_training_table"
                        class="table table-sm o_main_table table-bordered text-center"
                        name="training_line_table"
                    >

                        <thead>

                            <tr>

                                <th
                                    name="th_item"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Item</span>
                                </th>

                                <th
                                    name="th_training_name"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Training Name</span>
                                </th>

                                <th
                                    t-if="o.display_description"
                                    name="th_training_name"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Description</span>
                                </th>

                                <th
                                    t-if="o.display_instructor"
                                    name="th_training_name"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Instructor Name</span>
                                </th>

                                <th
                                    name="th_of_students"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span># Of Students</span>
                                </th>

                                <th
                                    t-if="o.display_location"
                                    name="th_training_name"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Location</span>
                                </th>

                                <th
                                    t-if="o.display_where"
                                    name="th_training_name"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Where?</span>
                                </th>

                                <th
                                    name="th_duration"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Duration</span>
                                </th>

                                <th
                                    name="th_training_date"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Training Dates</span>
                                </th>

                                <th
                                    name="th_training_date"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Training Price</span>
                                </th>

                                <th
                                    t-if="o.display_total"
                                    name="th_training_date"
                                    style="max-width:80px;text-align: center; vertical-align: middle;"
                                >
                                    <span>Total Price</span>
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <t
                                t-set="item"
                                t-value="1"
                            />

                            <t
                                t-set="total_rows"
                                t-value="len(o.training_course_ids)"
                            />

                            <t
                                t-foreach="o.training_course_ids"
                                t-as="training"
                            >

                                <tr>

                                    <td style="text-align: center; vertical-align: middle;">
                                        <span t-esc="item"/>
                                    </td>

                                    <td style="text-align: center; vertical-align: middle;">
                                        <span t-field="training.training_id"/>
                                    </td>

                                    <td
                                        t-if="o.display_description"
                                        style="text-align: center; vertical-align: middle;"
                                    >
                                        <span t-field="training.descriptions"/>
                                    </td>

                                    <td
                                        t-if="o.display_instructor"
                                        style="text-align: center; vertical-align: middle;"
                                    >
                                        <span t-field="training.instructor_id.name"/>
                                    </td>

                                    <td style="text-align: center; vertical-align: middle;">
                                        <span t-field="training.no_of_student"/>
                                    </td>

                                    <td
                                        t-if="o.display_location"
                                        style="text-align: center; vertical-align: middle;"
                                    >
                                        <span t-field="training.location"/>
                                    </td>

                                    <td
                                        t-if="o.display_where"
                                        style="text-align: center; vertical-align: middle;"
                                    >
                                        <span t-field="training.where_location2"/>
                                    </td>

                                    <td style="text-align: center; vertical-align: middle;">
                                        <span t-field="training.duration"/>
                                    </td>

                                    <td style="text-align: center; vertical-align: middle;">
                                        <span t-field="training.training_date_start"/>
                                        -
                                        <span t-field="training.training_date_end"/>
                                    </td>

                                    <td style="text-align: center; vertical-align: middle;">
                                        <span t-field="training.price"/>
                                    </td>

                                    <t t-if="item == 1">

                                        <td
                                            t-if="o.display_total"
                                            t-att-rowspan="total_rows"
                                            style="text-align: center; vertical-align: middle;"
                                        >
                                            <span t-field="o.total_training_price"/>
                                        </td>

                                    </t>

                                </tr>

                                <t
                                    t-set="item"
                                    t-value="item + 1"
                                />

                            </t>

                        </tbody>

                    </table>


                    <div
                        id="right-elements"
                        t-attf-class="#{'col-5' if report_type != 'html' else 'col-12 col-md-5'} ms-5 d-inline-block float-end"
                    >

                        <div
                            id="total"
                            class="clearfix row"
                        >

                            <div class="ms-auto">

                                <table
                                    class="table table-sm table-borderless avoid-page-break-inside"
                                    style="background-color:#fff;"
                                >

                                    <!--Tax totals-->

                                    <t
                                        t-set="tax_totals"
                                        t-value="o.tax_totals or {}"
                                    />

                                    <t t-call="account.document_tax_totals"/>


                                    <!--Payments-->

                                    <t t-if="o.payment_state != 'invoicing_legacy'">

                                        <t
                                            t-set="payments_vals"
                                            t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"
                                        />

                                        <t
                                            t-foreach="payments_vals"
                                            t-as="payment_vals"
                                        >

                                            <tr t-if="payment_vals['is_exchange'] == 0">

                                                <td style="background-color:#fff;">

                                                    <i class="oe_form_field text-end oe_payment_label">

                                                        Paid on

                                                        <t
                                                            t-out="payment_vals['date']"
                                                            t-options="{&quot;widget&quot;: &quot;date&quot;}"
                                                        >
                                                            2021-09-19
                                                        </t>

                                                    </i>

                                                </td>

                                                <td
                                                    style="background-color:#fff;"
                                                    class="text-end"
                                                >

                                                    <span
                                                        t-out="payment_vals['amount']"
                                                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"
                                                    >
                                                        20.00
                                                    </span>

                                                </td>

                                            </tr>

                                        </t>


                                        <t t-if="len(payments_vals) &gt; 0">

                                            <tr class="border-black fw-bold">

                                                <td style="background-color:#fff;">
                                                    Amount Due
                                                </td>

                                                <td
                                                    style="background-color:#fff;"
                                                    class="text-end"
                                                >
                                                    <span t-field="o.amount_residual">
                                                        11.05
                                                    </span>
                                                </td>

                                            </tr>

                                        </t>

                                    </t>


                                    <!-- ================== CURRENCY (ONLY CHANGE HERE) ================== -->

                                    <t
                                        t-set="company_currency"
                                        t-value="o.company_id.currency_id"
                                    />

                                    <t
                                        t-set="invoice_currency"
                                        t-value="o.currency_id"
                                    />

                                    <t
                                        t-set="rate_date"
                                        t-value="o.invoice_date or o.date or o.create_date"
                                    />

                                    <!-- company_per_unit: company currency per 1 unit of invoice currency -->

                                    <t
                                        t-set="company_per_unit"
                                        t-value="invoice_currency._get_conversion_rate(invoice_currency, company_currency, o.company_id, rate_date) if invoice_currency and company_currency else 1.0"
                                    />

                                    <t
                                        t-set="tax_amount_company"
                                        t-value="(o.amount_tax or 0.0) * company_per_unit"
                                    />

                                    <t
                                        t-set="untaxed_amount_company"
                                        t-value="(o.amount_untaxed or 0.0) * company_per_unit"
                                    />


                                    <tr class="border-black o_total">

                                        <td style="background-color:#fff;">

                                            <strong>
                                                <span t-esc="company_currency.name"/>
                                                per Unit
                                            </strong>

                                        </td>

                                        <td
                                            style="background-color:#fff;"
                                            class="text-end"
                                        >

                                            <span
                                                t-out="company_per_unit"
                                                t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 6}"
                                            >
                                                0.000000
                                            </span>

                                        </td>

                                    </tr>


                                    <tr class="border-black o_total">

                                        <td style="background-color:#fff;">

                                            <strong>
                                                Untaxed Currency @
                                                <span t-field="o.company_id.currency_id.symbol"/>
                                            </strong>

                                        </td>

                                        <td
                                            style="background-color:#fff;"
                                            class="text-end"
                                        >

                                            <span
                                                t-out="untaxed_amount_company"
                                                t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.company_id.currency_id}"
                                            >
                                                0.00
                                            </span>

                                        </td>

                                    </tr>


                                    <tr class="border-black o_total">

                                        <td style="background-color:#fff;">

                                            <strong>
                                                Tax Currency @
                                                <span t-field="o.company_id.currency_id.symbol"/>
                                            </strong>

                                        </td>

                                        <td
                                            style="background-color:#fff;"
                                            class="text-end"
                                        >

                                            <span
                                                t-out="tax_amount_company"
                                                t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.company_id.currency_id}"
                                            >
                                                0.00
                                            </span>

                                        </td>

                                    </tr>


                                    <tr class="border-black o_total">

                                        <td style="background-color:#fff;">

                                            <strong>
                                                Total Currency @
                                                <span t-field="o.company_id.currency_id.symbol"/>
                                            </strong>

                                        </td>

                                        <td
                                            style="background-color:#fff;"
                                            class="text-end"
                                        >

                                            <span
                                                t-out="o.amount_total * company_per_unit"
                                                t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.company_id.currency_id}"
                                            >
                                                0.00
                                            </span>

                                        </td>

                                    </tr>

                                    <!-- ================== /CURRENCY (ONLY CHANGE HERE) ================== -->

                                </table>

                            </div>

                        </div>

                    </div>


                    <div
                        id="right-elements"
                        t-attf-class="#{'col-5' if report_type != 'html' else 'col-12 col-md-5'} ms-5 d-inline-block float-end"
                    >

                        <div
                            id="total"
                            class="clearfix row"
                        >

                            <div class="ms-auto">

                                <table class="table table-sm table-borderless avoid-page-break-inside">
                                </table>

                            </div>

                        </div>

                    </div>


                    <!-- ================== REORDERED BOTTOM SECTION (ONLY CHANGE HERE) ================== -->

                    <!-- 1) Terms and Conditions FIRST -->

                    <div
                        class="row pt-3 pb-2"
                        style="page-break-inside:avoid;"
                    >

                        <div class="col-12">

                            <p>
                                <span t-field="o.term_and_cond"/>
                            </p>

                        </div>

                    </div>


                    <!-- 2) Bank Details SECOND -->

                    <div
                        class="row pt-3 pb-2"
                        style="page-break-inside:avoid;"
                    >

                        <div class="col-12">

                            <p>
                                <span t-field="o.bank_details"/>
                            </p>

                        </div>

                    </div>


                    <!-- 3) QR Code THIRD + 4) Stamp/Signature far right bottom corner -->

                    <div
                        class="row pt-3 pb-2"
                        style="page-break-inside:avoid;"
                    >

                        <!-- QR on the left -->

                        <div
                            name="ksa_qr"
                            class="col-4"
                        >

                            <t t-if="o.display_ksa_qr">

                                <img
                                    t-if="o.ks_qr_code"
                                    class="pt-2"
                                    t-att-src="image_data_uri(o.ks_qr_code)"
                                    style="max-height: 200px;"
                                    alt="KSA QR"
                                />

                            </t>

                        </div>


                        <!-- Spacer -->

                        <div class="col-4"/>


                        <!-- Stamp + Signature at extreme right -->

                        <div
                            class="col-4 text-end"
                            style="padding-right: 0;"
                        >

                            <div
                                class="d-flex flex-column align-items-end"
                                style="gap: 10px;"
                            >

                                <img
                                    t-if="o.company_id.stamp and o.display_stamp"
                                    class="pt-2"
                                    t-att-src="image_data_uri(o.company_id.stamp)"
                                    style="max-height: 200px;"
                                    alt="Stamp"
                                />

                                <img
                                    t-if="o.company_id.signature and o.display_signature"
                                    class="pt-2"
                                    t-att-src="image_data_uri(o.company_id.signature)"
                                    style="max-height: 200px;"
                                    alt="Signature"
                                />

                            </div>

                        </div>

                    </div>

                    <!-- ================== /REORDERED BOTTOM SECTION ================== -->

                </t>

            </t>
        </t>

    </template>

</odoo>
