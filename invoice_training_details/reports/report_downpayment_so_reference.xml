<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Read-only sales order items. Only called from the PS down-payment PDF. -->
    <template id="downpayment_source_sale_items_block">
        <t t-set="nil_source_items"
           t-value="o._nil_downpayment_source_sale_lines()"/>

        <div t-if="nil_source_items"
             style="width:100%;text-align:center;margin:4px 0 8px 0;font-family:Arial,Helvetica,sans-serif;">
            <table class="table table-sm table-bordered"
                   style="display:table;width:auto !important;max-width:100%;table-layout:auto;border-collapse:collapse;margin:4px auto 6px auto;font-size:13px;line-height:1.25;">
                <thead>
                    <tr style="background-color:#F6F7F8;">
                        <th style="padding:4px 8px;text-align:center;vertical-align:middle;min-width:260px;">DESCRIPTION</th>
                        <th style="padding:4px 8px;text-align:center;vertical-align:middle;white-space:nowrap;">QTY</th>
                        <th style="padding:4px 8px;text-align:center;vertical-align:middle;white-space:nowrap;">RATE</th>
                        <th style="padding:4px 8px;text-align:center;vertical-align:middle;white-space:nowrap;">AMOUNT</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="nil_source_items" t-as="nil_so_line">
                        <tr>
                            <td style="max-width:360px;padding:4px 8px !important;text-align:center;vertical-align:middle;line-height:1.25 !important;">
                                <div style="font-weight:700;text-align:center;margin:0 0 2px 0;">
                                    <span t-field="nil_so_line.product_id"/>
                                </div>
                                <div t-if="nil_so_line.name"
                                     style="font-size:12px;font-weight:400;text-align:center;white-space:normal;word-wrap:break-word;margin:0;">
                                    <span t-field="nil_so_line.name"/>
                                </div>
                            </td>
                            <td style="padding:4px 8px !important;text-align:center;vertical-align:middle;white-space:nowrap;">
                                <span t-field="nil_so_line.product_uom_qty"/>
                            </td>
                            <td style="padding:4px 8px !important;text-align:center;vertical-align:middle;white-space:nowrap;">
                                <span t-out="nil_so_line.price_unit"
                                      t-options="{'widget':'monetary','display_currency':nil_so_line.currency_id}"/>
                            </td>
                            <td style="padding:4px 8px !important;text-align:center;vertical-align:middle;white-space:nowrap;">
                                <span t-out="nil_so_line.price_subtotal"
                                      t-options="{'widget':'monetary','display_currency':nil_so_line.currency_id}"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </template>
</odoo>
