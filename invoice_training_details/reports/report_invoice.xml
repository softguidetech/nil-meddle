<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_invoice_document_training" name="Invoice Report Training">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="invoice_training_details.custom_invoice_report_layout">
                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>

                    <div class="row">
                        <div class="col-12">
                            <span class="h4 text-info">TAX INVOICE</span>
                        </div>
                    </div>

                    <div class="row pt-3 pb-3">
                        <div class="col-8">
                            <div>
                                <strong t-if="o.partner_id.is_company == True">Company Name:</strong><br/>
                                <div t-if="o.partner_id.is_company == True" t-field="o.partner_id.name"/>
                                <strong t-if="o.partner_id.is_company == False">Company Name:</strong><br/>
                                <div t-if="o.partner_id.is_company == False" t-field="o.partner_id.parent_id.name"/>
                                TAX#: <strong t-field="o.partner_id.vat"/><br/>
                                <strong t-if="o.partner_id.is_company == False">Attention:</strong><br/>
                                <div t-if="o.partner_id.is_company == False" t-field="o.partner_id.name"/>
                            </div>
                        </div>
                        <div class="col-4">
                            <div>
                                <table class="table table-borderless">
                                    <tr><td>INVOICE</td><td><span t-field="o.name"/></td></tr>
                                    <tr><td>Date</td><td><span t-field="o.invoice_date"/></td></tr>
                                    <tr t-if="o.invoice_payment_term_id"><td>Payment Terms</td><td><span t-field="o.invoice_payment_term_id"/></td></tr>
                                    <tr><td>Due Date</td><td><span t-field="o.invoice_date_due"/></td></tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <table class="table table-sm o_main_table table-borderless">
                        <thead class="bg-light text-info">
                            <tr>
                                <th>DESCRIPTION</th><th class="text-end">QTY</th><th class="text-end">RATE</th><th class="text-end">Taxes</th><th class="text-end">Taxable Amount</th><th class="text-end">Total Tax.inc</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <tr>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                                    <td class="text-end"><span t-out="taxes"/></td>
                                    <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                    <td class="text-end"><span t-field="line.price_total"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="row pt-3 pb-2">
                        <div class="col-12">
                            Training Courses Details: <span t-field="o.training_name"/>
                        </div>
                    </div>

                    <table t-if="o.display_training_table" class="table table-sm o_main_table table-bordered text-center">
                        <thead>
                            <tr>
                                <th>Item</th><th>Training Name</th><th t-if="o.display_description">Description</th><th t-if="o.display_instructor">Instructor Name</th><th>Language</th><th># Of Students</th><th t-if="o.display_location">Location</th><th t-if="o.display_where">Where?</th><th>Duration</th><th>Training Dates</th><th>Training Price</th><th t-if="o.display_total">Total Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="item" t-value="1"/>
                            <t t-set="total_rows" t-value="len(o.training_course_ids)"/>
                            <t t-foreach="o.training_course_ids" t-as="training">
                                <tr>
                                    <td><span t-esc="item"/></td>
                                    <td><span t-field="training.training_id"/></td>
                                    <td t-if="o.display_description"><span t-field="training.descriptions"/></td>
                                    <td t-if="o.display_instructor"><span t-field="training.instructor_id.name"/></td>
                                    <td><span t-field="training.train_language"/></td>
                                    <td><span t-field="training.no_of_student"/></td>
                                    <td t-if="o.display_location"><span t-field="training.location"/></td>
                                    <td t-if="o.display_where"><span t-field="training.where_location2"/></td>
                                    <td><span t-field="training.duration"/></td>
                                    <td><span t-field="training.training_date_start"/> - <span t-field="training.training_date_end"/></td>
                                    <td><span t-field="training.price"/></td>
                                    <t t-if="item == 1"><td t-if="o.display_total" t-att-rowspan="total_rows"><span t-field="o.total_training_price"/></td></t>
                                </tr>
                                <t t-set="item" t-value="item + 1"/>
                            </t>
                        </tbody>
                    </table>

                    <div id="right-elements" class="ms-5 d-inline-block float-end col-5">
                        <div id="total" class="clearfix row">
                            <div class="ms-auto">
                                <table class="table table-sm table-borderless avoid-page-break-inside" style="background-color:#fff;">
                                    <t t-set="tax_totals" t-value="o.tax_totals or {}"/>
                                    <t t-call="account.document_tax_totals"/>

                                    <!-- Payments -->
                                    <t t-if="o.payment_state != 'invoicing_legacy'">
                                        <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                                        <t t-foreach="payments_vals" t-as="payment_vals">
                                            <tr t-if="payment_vals['is_exchange'] == 0">
                                                <td><i class="oe_form_field text-end oe_payment_label">Paid on <t t-out="payment_vals['date']" t-options="{&quot;widget&quot;: &quot;date&quot;}"/></i></td>
                                                <td class="text-end"><span t-out="payment_vals['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="len(payments_vals) &gt; 0">
                                            <tr class="border-black fw-bold">
                                                <td>Amount Due</td>
                                                <td class="text-end"><span t-field="o.amount_residual"/></td>
                                            </tr>
                                        </t>
                                    </t>

                                    <!-- Added block (Taxes summary like your image) -->
                                    <t t-if="o.amount_tax &gt; 0">
                                        <tr class="border-black o_total">
                                            <td><strong>Taxes <span t-field="o.company_id.currency_id.symbol"/></strong></td>
                                            <td class="text-end"><span t-field="o.amount_tax"/></td>
                                        </tr>
                                        <tr class="border-black o_total">
                                            <td><strong>Untaxed Amount @ <span t-field="o.company_id.currency_id.symbol"/></strong></td>
                                            <td class="text-end"><span t-field="o.amount_untaxed"/></td>
                                        </tr>
                                        <tr class="border-black o_total">
                                            <td><strong>VAT @ <span t-field="o.company_id.currency_id.symbol"/></strong></td>
                                            <td class="text-end"><span t-field="o.amount_tax"/></td>
                                        </tr>
                                        <tr class="border-black o_total">
                                            <td><strong>Total with VAT @ <span t-field="o.company_id.currency_id.symbol"/></strong></td>
                                            <td class="text-end"><span t-field="o.amount_total"/></td>
                                        </tr>
                                    </t>

                                    <tr class="border-black o_total">
                                        <td><strong>Currency Rate</strong></td>
                                        <td class="text-end"><span t-field="o.currency_id.rate"/></td>
                                    </tr>
                                    <tr class="border-black o_total">
                                        <td><strong>Total Currency @ <span t-field="o.company_id.currency_id.symbol"/></strong></td>
                                        <td class="text-end"><span t-field="o.currency_total"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="row pt-3 pb-2" style="page-break-inside:avoid;">
                        <div class="col-12"><p><span t-field="o.term_and_cond"/></p></div>
                    </div>

                    <hr/>

                    <div class="row" style="page-break-inside:avoid;">
                        <div name="ksa_qr" class="col-4">
                            <t t-if="o.display_ksa_qr">
                                <img t-if="o.ks_qr_code" class="pt-5" t-att-src="image_data_uri(o.ks_qr_code)" style="max-height: 200px;" alt="KSA QR"/>
                            </t>
                        </div>
                        <div name="stamp" class="col-4">
                            <img t-if="o.company_id.stamp and o.display_stamp" class="pt-5" t-att-src="image_data_uri(o.company_id.stamp)" style="max-height: 200px;" alt="Stamp"/>
                        </div>
                        <div name="signature" class="col-4">
                            <img t-if="o.company_id.signature and o.display_signature" class="pt-5" t-att-src="image_data_uri(o.company_id.signature)" style="max-height: 200px;" alt="Signature"/>
                        </div>
                    </div>

                    <div class="row pt-3 pb-2" style="page-break-inside:avoid;">
                        <div class="col-12"><p><span t-field="o.bank_details"/></p></div>
                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>
