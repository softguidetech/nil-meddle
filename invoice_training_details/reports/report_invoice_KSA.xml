<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_invoice_document_training" name="Invoice Report Training">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="invoice_training_details.custom_invoice_report_layout">
                    <t t-set="o" t-value="o.with_context(lang=lang).with_company(o.company_id)"/>
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>

                    <div class="row">
                        <div class="col-12">
                            <span class="h4 text-info">TAX INVOICE</span>
                        </div>
                    </div>

                    <!-- ================= CUSTOMER DETAILS ================= -->
                    <div class="row pt-3 pb-3">
                        <div class="col-8">
                            <div>

                                <strong>Customer Name:</strong><br/>
                                <span t-field="o.partner_id.name"/><br/><br/>

                                <strong>Commercial Registration:</strong><br/>
                                <span t-field="o.partner_id.l10n_sa_additional_identification_number"/><br/><br/>

                                <strong>VAT Number:</strong><br/>
                                <span t-field="o.partner_id.vat"/><br/><br/>

                                <strong>Address:</strong><br/>
                                <span t-field="o.partner_id.street"/><br/>
                                <span t-field="o.partner_id.street2"/><br/>
                                <span t-field="o.partner_id.city"/>
                                <span t-field="o.partner_id.zip"/><br/>
                                <span t-field="o.partner_id.country_id.name"/><br/><br/>

                                <t t-if="not o.partner_id.is_company">
                                    <strong>Attention:</strong><br/>
                                    <span t-field="o.partner_id.name"/>
                                </t>

                            </div>
                        </div>

                        <div class="col-4">
                            <table class="table table-borderless">
                                <tr>
                                    <td>Invoice</td>
                                    <td><span t-field="o.name"/></td>
                                </tr>
                                <tr>
                                    <td>Date</td>
                                    <td><span t-field="o.invoice_date"/></td>
                                </tr>
                                <tr t-if="o.invoice_payment_term_id">
                                    <td>Payment Terms</td>
                                    <td><span t-field="o.invoice_payment_term_id"/></td>
                                </tr>
                                <tr>
                                    <td>Due Date</td>
                                    <td><span t-field="o.invoice_date_due"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <!-- ===================================================== -->

                    <table class="table table-sm o_main_table table-borderless">
                        <thead class="bg-light text-info">
                            <tr>
                                <th>Description</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Rate</th>
                                <th class="text-end">Taxes</th>
                                <th class="text-end">Taxable Amount</th>
                                <th class="text-end">Total Tax Inc.</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <tr>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <td class="text-end">
                                        <t t-set="taxes" t-value="', '.join([t.name for t in line.tax_ids])"/>
                                        <span t-esc="taxes"/>
                                    </td>
                                    <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                    <td class="text-end"><span t-field="line.price_total"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <hr/>

                    <div class="row" style="page-break-inside:avoid;">
                        <div class="col-4">
                            <img t-if="o.ks_qr_code and o.display_ksa_qr"
                                 t-att-src="image_data_uri(o.ks_qr_code)"
                                 style="max-height:200px;"/>
                        </div>
                        <div class="col-4">
                            <img t-if="o.company_id.stamp and o.display_stamp"
                                 t-att-src="image_data_uri(o.company_id.stamp)"
                                 style="max-height:200px;"/>
                        </div>
                        <div class="col-4">
                            <img t-if="o.company_id.signature and o.display_signature"
                                 t-att-src="image_data_uri(o.company_id.signature)"
                                 style="max-height:200px;"/>
                        </div>
                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>
