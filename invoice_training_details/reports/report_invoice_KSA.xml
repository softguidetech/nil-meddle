<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_invoice_document_training" name="Invoice Report Training">
          <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="invoice_training_details.custom_invoice_report_layout">
                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>
                    <div class="row">
                        <div class="col-12">
                            <span class="h4 text-info">TAX INVOICE</span>
                        </div>
                    </div>

                    <div class="row pt-3 pb-3">
                        <div class="col-8">
                            <div>
                                <strong t-if="o.partner_id.is_company == True">Company Name:</strong><br/>
                                <div t-if="o.partner_id.is_company == True" t-field="o.partner_id.name"/>
                                <strong t-if="o.partner_id.is_company == False">Company Name:</strong><br/>
                                <div t-if="o.partner_id.is_company == False" t-field="o.partner_id.parent_id.name"/>
                                TAX#: <strong t-field="o.partner_id.vat"/>
                                <strong t-if="o.partner_id.is_company == False">Attention:</strong><br/>
                                <div t-if="o.partner_id.is_company == False" t-field="o.partner_id.name"/>

                               <div class="pt-1">
                                    <strong>Commercial Registration:</strong>
                                    <span t-if="o.partner_id.is_company" t-field="o.partner_id.l10n_sa_additional_identification_number"/>
                                    <span t-if="not o.partner_id.is_company" t-field="o.partner_id.parent_id.l10n_sa_additional_identification_number"/>
                                </div>

                                <div class="pt-1">
                                    <strong>Customer Address:</strong><br/>
                                    <t t-if="o.partner_id.is_company == True">
                                        <span t-if="o.partner_id.street" t-field="o.partner_id.street"/><br/>
                                        <span t-if="o.partner_id.street2" t-field="o.partner_id.street2"/><br/>
                                        <span t-if="o.partner_id.city" t-field="o.partner_id.city"/> ,
                                        <span t-if="o.partner_id.state_id" t-field="o.partner_id.state_id.name"/>
                                        <span t-if="o.partner_id.zip" t-field="o.partner_id.zip"/><br/>
                                        <span t-if="o.partner_id.country_id" t-field="o.partner_id.country_id.name"/>
                                    </t>

                                    <t t-if="o.partner_id.is_company == False">
                                        <span t-if="o.partner_id.parent_id.street" t-field="o.partner_id.parent_id.street"/><br/>
                                        <span t-if="o.partner_id.parent_id.street2" t-field="o.partner_id.parent_id.street2"/><br/>
                                        <span t-if="o.partner_id.parent_id.city" t-field="o.partner_id.parent_id.city"/> ,
                                        <span t-if="o.partner_id.parent_id.state_id" t-field="o.partner_id.parent_id.state_id.name"/>
                                        <span t-if="o.partner_id.parent_id.zip" t-field="o.partner_id.parent_id.zip"/><br/>
                                        <span t-if="o.partner_id.parent_id.country_id" t-field="o.partner_id.parent_id.country_id.name"/>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <div class="col-4">
                            <table class="table table-borderless">
                                <tr><td>INVOICE</td><td><span t-field="o.name"/></td></tr>
                                <tr><td>Date</td><td><span t-field="o.invoice_date"/></td></tr>
                                <tr t-if="o.invoice_payment_term_id">
                                    <td>Payment Terms</td><td><span t-field="o.invoice_payment_term_id"/></td>
                                </tr>
                                <tr><td>Due Date</td><td><span t-field="o.invoice_date_due"/></td></tr>
                            </table>
                        </div>
                    </div>

                    <table class="table table-sm o_main_table table-borderless">
                        <thead class="bg-light text-info">
                            <tr>
                                <th>DESCRIPTION</th>
                                <th class="text-end">QTY</th>
                                <th class="text-end">RATE</th>
                                <th class="text-end">Taxes</th>
                                <th class="text-end">Taxable Amount</th>
                                <th class="text-end">Total Tax.inc</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <tr>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <td class="text-end">
                                        <span t-out="', '.join([(t.invoice_label or t.name) for t in line.tax_ids])"/>
                                    </td>
                                    <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                    <td class="text-end"><span t-field="line.price_total"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div id="right-elements" class="col-12 col-md-5 ms-5 d-inline-block float-end">
                        <table class="table table-sm table-borderless">

                            <t t-set="tax_totals" t-value="o.tax_totals or {}"/>
                            <t t-call="account.document_tax_totals"/>

                            <t t-set="company_currency" t-value="o.company_id.currency_id"/>
                            <t t-set="invoice_currency" t-value="o.currency_id"/>
                            <t t-set="rate_date" t-value="o.invoice_date or o.date or o.create_date"/>

                            <t t-set="company_per_unit"
                               t-value="invoice_currency._get_conversion_rate(invoice_currency, company_currency, o.company_id, rate_date)"/>

                            <tr class="border-black o_total">
                                <td><strong><span t-esc="company_currency.name"/> per Unit</strong></td>
                                <td class="text-end">
                                    <span t-out="company_per_unit" t-options='{"widget":"float","precision":6}'/>
                                </td>
                            </tr>

                            <tr class="border-black o_total">
                                <td><strong>Total Currency @ <span t-field="company_currency.symbol"/></strong></td>
                                <td class="text-end">
                                    <span t-out="o.amount_total * company_per_unit"
                                          t-options='{"widget":"monetary","display_currency":company_currency}'/>
                                </td>
                            </tr>

                        </table>
                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>
