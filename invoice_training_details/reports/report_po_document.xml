<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_po_document_training" name="Training PUrchase Order">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="invoice_training_details.custom_invoice_report_layout">
                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>

                    <!-- العنوان الرئيسي -->
                    <div class="row">
                        <div class="col-18">
                            <span style="font-size:30px; font-weight:bold; color:#0DCAF0;">Purchase Order</span>
                        </div>
                    </div>

                    <!-- بيانات العميل -->
                    <div class="row pt-3 pb-3">
                        <div class="col-8">
                            <div>
                                <strong t-if="o.partner_id.is_company == True" style="font-size:20px;">Company Name:</strong>
                                <div t-if="o.partner_id.is_company == True" t-field="o.partner_id.name" style="font-size:20px;"/>
                                <strong t-if="o.partner_id.is_company == False" style="font-size:20px;">Company Name:</strong>
                                <div t-if="o.partner_id.is_company == False" t-field="o.partner_id.parent_id.name" style="font-size:20px;"/>

                                <strong style="font-size:20px;">Address:</strong>
                                <div style="font-size:20px;">
                                    <span t-field="o.partner_id.street"/> <span t-field="o.partner_id.street2"/>
                                </div>
                                <div style="font-size:20px;">
                                    <span t-field="o.partner_id.city"/>, <span t-field="o.partner_id.country_id.name"/>
                                </div>

                                <strong t-if="o.partner_id.is_company == True and o.partner_id.vat" style="font-size:20px;">Tax Number:</strong>
                                <div t-if="o.partner_id.is_company == True and o.partner_id.vat" t-field="o.partner_id.vat" style="font-size:20px;"/>
                                <strong t-if="o.partner_id.is_company == False and o.partner_id.parent_id.vat" style="font-size:20px;">Tax Number:</strong>
                                <div t-if="o.partner_id.is_company == False and o.partner_id.parent_id.vat" t-field="o.partner_id.parent_id.vat" style="font-size:20px;"/>

                                <strong t-if="o.partner_id.is_company == False" style="font-size:20px;">Attention:</strong>
                                <div t-if="o.partner_id.is_company == False" t-field="o.partner_id.name" style="font-size:20px;"/>
                            </div>
                        </div>

                        <!-- بيانات PO -->
                        <div class="col-4">
                            <div>
                                <table class="table table-borderless">
    <tr>
        <td style="font-size:20px; vertical-align: middle;">Purchase Order</td>
        <td style="font-size:20px; vertical-align: middle;"><span t-field="o.name"/></td>
    </tr>
    <tr>
        <td style="font-size:20px; vertical-align: middle;">Date</td>
        <td style="font-size:20px; vertical-align: middle;"><span t-field="o.date_order"/></td>
    </tr>
    <tr>
        <td style="font-size:20px; vertical-align: middle;">Validity Date</td>
        <td style="font-size:20px; vertical-align: middle;"><span t-field="o.validity_date"/></td>
    </tr>
</table>

                            </div>
                        </div>
                    </div>

                    <!-- جدول التدريب -->
                    <table t-if="o.display_training_table" class="table table-sm o_main_table table-bordered text-center" name="training_line_table">
                        <thead>
                            <tr>
                                <th style="font-size:18px; text-align:center; vertical-align:middle;">Item</th>
<th style="font-size:18px; text-align:center; vertical-align:middle;">Training Name</th>
<th t-if="o.display_instructor" style="font-size:18px; text-align:center; vertical-align:middle;">Instructor Name</th>
<th style="font-size:18px; text-align:center; vertical-align:middle;"># Of Students</th>
<th style="font-size:18px; text-align:center; vertical-align:middle;">
    <span t-if="o.display_location">Location</span>
    <span t-elif="o.display_where">Location1</span>
</th>
<th style="font-size:18px; text-align:center; vertical-align:middle;">Duration</th>
<th style="font-size:18px; text-align:center; vertical-align:middle;">Training Dates</th>
<th style="font-size:18px; text-align:center; vertical-align:middle;">Training Price</th>
<th t-if="o.display_total" style="font-size:18px; text-align:center; vertical-align:middle;">Total Price</th>

                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="item" t-value="1"/>
                            <t t-set="total_rows" t-value="len(o.training_course_ids)"/>
                            <t t-foreach="o.training_course_ids" t-as="training">
                                <tr>
                                    <td style="font-size:18px;"><span t-esc="item"/></td>
                                    <td style="font-size:18px;"><span t-field="training.training_id"/></td>
                                    <td t-if="o.display_instructor" style="font-size:20px;"><span t-field="training.instructor_id.name"/></td>
                                    <td style="font-size:18px;"><span t-field="training.no_of_student"/></td>
                                    <td style="font-size:18px;">
                                        <span t-if="o.display_location" t-field="training.location"/>
                                        <span t-if="o.display_location and o.display_where">, </span>
                                        <span t-if="o.display_where" t-field="training.where_location2"/>
                                    </td>
                                    <td style="font-size:18px;"><span t-field="training.duration"/></td>
                                    <td style="font-size:18px;"><span t-field="training.training_date_start"/> - <span t-field="training.training_date_end"/></td>
                                    <td style="font-size:18px;"><span t-field="training.price"/></td>
                                    <t t-if="item == 1">
                                        <td t-if="o.display_total" t-att-rowspan="total_rows" style="font-size:18px;"><span t-field="o.total_training_price"/></td>
                                    </t>
                                </tr>
                                <t t-set="item" t-value="item + 1"/>
                            </t>
                        </tbody>
                    </table>

                    <!-- Course Content -->
                    <div class="row pt-3 pb-2" style="page-break-inside:avoid; display: flex; justify-content: space-between; align-items: flex-start;">
                        <div class="col-auto" style="flex: 1 1 auto;">
                            <br/><br/>
                            <table class="table table-sm" style="background-color:#fff; color: white; width: auto; border: none;">
                                <tbody>

                                </tbody>
                            </table>
                        </div>

                        <!-- الحسابات والمجموع -->
                        <div class="col-auto" style="min-width: 300px; flex: 0 0 auto; margin-left: auto; text-align: left; position: absolute; right: 15px;">
                            <table class="table table-sm table-border" style="background-color:#fff; width: 300px;">
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-if="tax_totals.get('subtotals')">
                                    <t t-foreach="tax_totals.get('subtotals')" t-as="subtotal">
                                        <tr class="border-grey o_subtotal">
                                            <td style="background-color:#fff; font-size:20px;"><strong t-out="subtotal['name']">Untaxed Amount</strong></td>
                                            <td style="background-color:#fff; text-align: right; font-size:20px;">
                                                <span t-att-class="oe_subtotal_footer_separator" t-out="subtotal['formatted_amount']"/>
                                            </td>
                                        </tr>
                                        <t t-set="subtotal_to_show" t-value="subtotal['name']"/>
                                        <t t-call="account.tax_groups_totals"/>
                                    </t>
                                </t>
                                <tr class="border-grey o_total">
                                    <td style="background-color:#fff; font-size:20px;"><strong>Invoice Amount</strong></td>
                                    <td style="background-color:#fff; text-align: right; font-size:15px;">
                                        <span t-out="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                    </td>
                                </tr>
                            </table>
                            <br/><br/>
                        </div>
                    </div>
                    <!-- Terms and Conditions -->
                    <div class="terms-section" style="
                        width:100%;
                        margin-top:24px;
                        margin-bottom:18px;
                        page-break-inside:auto;
                    ">
                        <div style="
                            font-size:24px;
                            font-weight:700;
                            color:#0DCAF0;
                            margin-bottom:12px;
                            padding-bottom:7px;
                            border-bottom:2px solid #0DCAF0;
                        ">
                            Terms and Conditions
                        </div>

                        <style>
                            .terms-content {
                                width: 100%;
                                font-size: 18px;
                                line-height: 1.6;
                                color: #222;
                                text-align: left;
                            }

                            .terms-content p {
                                margin: 0 0 10px 0;
                                line-height: 1.6;
                            }

                            .terms-content h1,
                            .terms-content h2,
                            .terms-content h3,
                            .terms-content h4 {
                                color: #0DCAF0;
                                font-weight: 700;
                                margin: 16px 0 8px 0;
                                page-break-after: avoid;
                            }

                            .terms-content h1 { font-size: 24px; }
                            .terms-content h2 { font-size: 22px; }
                            .terms-content h3 { font-size: 20px; }
                            .terms-content h4 { font-size: 18px; }

                            .terms-content ul,
                            .terms-content ol {
                                margin: 8px 0 12px 24px;
                                padding-left: 16px;
                            }

                            .terms-content li {
                                margin-bottom: 5px;
                                line-height: 1.5;
                            }

                            .terms-content table {
                                width: 100% !important;
                                border-collapse: collapse !important;
                                table-layout: fixed;
                                margin: 14px 0 18px 0;
                                font-size: 16px;
                                page-break-inside: auto;
                            }

                            .terms-content thead {
                                display: table-header-group;
                            }

                            .terms-content tr {
                                page-break-inside: avoid;
                                page-break-after: auto;
                            }

                            .terms-content th {
                                background-color: #0DCAF0 !important;
                                color: #ffffff !important;
                                font-weight: 700;
                                text-align: center;
                                vertical-align: middle;
                                border: 1px solid #8aa6ad !important;
                                padding: 9px 7px !important;
                                word-wrap: break-word;
                            }

                            .terms-content td {
                                background-color: #ffffff;
                                color: #222222;
                                text-align: left;
                                vertical-align: top;
                                border: 1px solid #b8c4c8 !important;
                                padding: 8px 7px !important;
                                line-height: 1.45;
                                word-wrap: break-word;
                                white-space: normal;
                            }

                            .terms-content tbody tr:nth-child(even) td {
                                background-color: #f4f8f9;
                            }

                            .terms-content strong,
                            .terms-content b {
                                font-weight: 700;
                            }

                            .terms-content a {
                                color: #087f9c;
                                text-decoration: underline;
                            }

                            .terms-content blockquote {
                                margin: 12px 0;
                                padding: 10px 14px;
                                border-left: 4px solid #0DCAF0;
                                background-color: #f4f8f9;
                            }
                        </style>

                        <div class="terms-content">
                            <t t-field="o.term_and_cond"/>
                        </div>
                    </div>



                    <!-- الختم والتوقيع -->
                    <div class="row" style="page-break-inside:avoid; position: relative; min-height: 170px;">
                        <div style="position: absolute; bottom: 10px; right: 0; text-align: right; display: block;">
                            <div name="stamp" style="margin-bottom: 5px;">
                                <img t-if="o.company_id.stamp and o.display_stamp" 
                                     t-att-src="image_data_uri(o.company_id.stamp)" 
                                     style="height:170px; width:auto; object-fit:contain;" alt="Stamp"/>
                            </div>
                            <div name="signature">
                                <img t-if="o.company_id.signature and o.display_signature" 
                                     t-att-src="image_data_uri(o.company_id.signature)" 
                                     style="height:200px; width:auto; object-fit:contain;" alt="Signature"/>
                            </div>
                        </div>
                    </div>

                    <!-- بيانات البنك -->
<div class="row pt-3 pb-2" style="page-break-inside:avoid;">
    <div class="col-12">
        <p style="font-size:22px;"><span t-field="o.bank_details" style="font-size:22px;"/></p>
    </div>
</div>

                </t>
            </t>
        </t>
    </template>
</odoo>
