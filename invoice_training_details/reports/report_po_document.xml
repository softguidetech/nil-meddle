
<odoo>
    <template id="report_po_document_training" name="Training PUrchase Order">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="invoice_training_details.custom_invoice_report_layout">
                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>
                    <t t-set="is_clc_order" t-value="'clc' in [(method or '').lower() for method in o.training_course_ids.mapped('payment_method')]"/>

                    <div style="margin:0 0 6px 0; padding:0;">
                        <span t-if="is_clc_order"
                              style="display:block; margin:0; padding:0; font-size:24px; font-weight:500; line-height:1.2; color:#0DCAF0;">
                            Work Order
                        </span>
                        <span t-if="not is_clc_order"
                              style="display:block; margin:0; padding:0; font-size:24px; font-weight:500; line-height:1.2; color:#0DCAF0;">
                            Purchase Order
                        </span>
                    </div>

                    <!-- Vendor + PO details: quotation-style, no boxes -->
                    <table style="
                        width:100%;
                        border-collapse:collapse;
                        border:0 !important;
                        margin:0 0 14px 0;
                        table-layout:fixed;
                    ">
                        <tr>
                            <td style="
                                width:66%;
                                border:0 !important;
                                padding:0 18px 0 0 !important;
                                vertical-align:top;
                                font-size:14px;
                                line-height:1.45;
                            ">
                                <div style="margin:0 0 3px 0;">
                                    <strong>Company Name:</strong>
                                    <span t-if="o.partner_id.is_company == True"
                                          t-field="o.partner_id.name"/>
                                    <span t-if="o.partner_id.is_company == False"
                                          t-field="o.partner_id.parent_id.name"/>
                                </div>

                                <div style="margin:0 0 3px 0;">
                                    <strong>Address:</strong>
                                    <span t-if="o.partner_id.street" t-field="o.partner_id.street"/>
                                    <t t-if="o.partner_id.street2">
                                        <t t-if="o.partner_id.street">, </t>
                                        <span t-field="o.partner_id.street2"/>
                                    </t>
                                    <t t-if="o.partner_id.city">
                                        <t t-if="o.partner_id.street or o.partner_id.street2">, </t>
                                        <span t-field="o.partner_id.city"/>
                                    </t>
                                    <t t-if="o.partner_id.country_id">
                                        <t t-if="o.partner_id.street or o.partner_id.street2 or o.partner_id.city">, </t>
                                        <span t-field="o.partner_id.country_id.name"/>
                                    </t>
                                </div>

                                <div t-if="o.partner_id.email" style="margin:0 0 3px 0;">
                                    <strong>Email:</strong>
                                    <span t-field="o.partner_id.email"/>
                                </div>

                                <div t-if="o.partner_id.is_company == True and o.partner_id.vat"
                                     style="margin:0 0 3px 0;">
                                    <strong>Tax Number:</strong>
                                    <span t-field="o.partner_id.vat"/>
                                </div>

                                <div t-if="o.partner_id.is_company == False and o.partner_id.parent_id.vat"
                                     style="margin:0 0 3px 0;">
                                    <strong>Tax Number:</strong>
                                    <span t-field="o.partner_id.parent_id.vat"/>
                                </div>

                                <div t-if="o.partner_id.is_company == False" style="margin:0;">
                                    <strong>Attention:</strong>
                                    <span t-field="o.partner_id.name"/>
                                </div>
                            </td>

                            <td style="
                                width:34%;
                                border:0 !important;
                                padding:0 !important;
                                vertical-align:top;
                            ">
                                <table style="
                                    width:220px;
                                    margin-left:auto;
                                    border-collapse:collapse;
                                    border:0 !important;
                                    table-layout:fixed;
                                ">
                                    <tr>
                                        <td style="width:48%; border:0 !important; padding:0 8px 4px 0 !important; font-size:14px; line-height:1.35;">
                                            <span t-if="is_clc_order">Work Order</span>
                                            <span t-if="not is_clc_order">Purchase Order</span>
                                        </td>
                                        <td style="width:52%; border:0 !important; padding:0 0 4px 0 !important; font-size:14px; line-height:1.35;">
                                            <span t-if="is_clc_order"
                                                  t-esc="o.name.replace('PO-', 'WO-', 1) if o.name.startswith('PO-') else 'WO-' + o.name"/>
                                            <span t-if="not is_clc_order" t-field="o.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border:0 !important; padding:0 8px 4px 0 !important; font-size:14px; line-height:1.35;">Date</td>
                                        <td style="border:0 !important; padding:0 0 4px 0 !important; font-size:14px; line-height:1.35;">
                                            <span t-field="o.date_order"
                                                  t-options="{&quot;widget&quot;:&quot;date&quot;}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border:0 !important; padding:0 8px 0 0 !important; font-size:14px; line-height:1.35;">Validity Date</td>
                                        <td style="border:0 !important; padding:0 !important; font-size:14px; line-height:1.35;">
                                            <span t-field="o.validity_date"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <style>
                        table[name="training_line_table"] {
                            width:100% !important;
                            border-collapse:collapse !important;
                            table-layout:fixed !important;
                            margin:0 !important;
                        }

                        table[name="training_line_table"] th {
                            background-color:#D9F4FA !important;
                            color:#075E68 !important;
                            text-align:center !important;
                            vertical-align:middle !important;
                            border:1px solid #9DDDE7 !important;
                            font-size:13px !important;
                            font-weight:600 !important;
                            line-height:1.25 !important;
                            padding:5px 4px !important;
                        }

                        table[name="training_line_table"] td {
                            text-align:center !important;
                            vertical-align:middle !important;
                            border:1px solid #CFE5EA !important;
                            font-size:13px !important;
                            font-weight:400 !important;
                            line-height:1.3 !important;
                            padding:5px 4px !important;
                        }

                        table[name="training_line_table"] thead {
                            display:table-header-group !important;
                        }

                        table[name="training_line_table"] tr {
                            page-break-inside:avoid !important;
                        }
                    </style>
                    <t t-set="is_cisco_u_all_access" t-value="'Cisco U All Access' in o.training_course_ids.mapped('training_id.name')"/>
                    <table t-if="o.display_training_table" class="table table-sm o_main_table table-bordered text-center" name="training_line_table">
                        <thead>
                            <tr>
                                <th t-att-style="'width:10%;' if is_cisco_u_all_access else ''" style="font-size:13px; text-align:center; vertical-align:middle;">Item</th>
<th t-att-style="'width:45%;' if is_cisco_u_all_access else ''" style="font-size:13px; text-align:center; vertical-align:middle;">
    <span t-if="is_cisco_u_all_access">Subscription Name</span>
    <span t-if="not is_cisco_u_all_access">Training Name</span>
</th>
<th t-if="o.display_instructor" style="font-size:13px; text-align:center; vertical-align:middle;">Instructor Name</th>
<th t-att-style="'width:45%;' if is_cisco_u_all_access else ''" style="font-size:13px; text-align:center; vertical-align:middle;">
    <span t-if="is_cisco_u_all_access"># Of Subscriptions</span>
    <span t-if="not is_cisco_u_all_access"># Of Students</span>
</th>
<th t-if="not is_cisco_u_all_access" style="font-size:13px; text-align:center; vertical-align:middle;">
    <span t-if="o.display_location">Location</span>
    <span t-elif="o.display_where">Location1</span>
</th>
<th t-if="not is_cisco_u_all_access" style="font-size:13px; text-align:center; vertical-align:middle;">Duration</th>
<th t-if="not is_cisco_u_all_access" style="font-size:13px; text-align:center; vertical-align:middle;">Training Dates</th>
<th t-if="not is_cisco_u_all_access" style="font-size:13px; text-align:center; vertical-align:middle;">
    <span t-if="is_clc_order">Rate Card</span>
    <span t-if="not is_clc_order">Training Price</span>
</th>
<th t-if="o.display_total" style="font-size:13px; text-align:center; vertical-align:middle;">Total Price</th>

                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="item" t-value="1"/>
                            <t t-set="total_rows" t-value="len(o.training_course_ids)"/>
                            <t t-foreach="o.training_course_ids" t-as="training">
                                <tr>
                                    <td style="font-size:13px;"><span t-esc="item"/></td>
                                    <td style="font-size:13px;"><span t-field="training.training_id"/></td>
                                    <td t-if="o.display_instructor" style="font-size:13px;"><span t-field="training.instructor_id.name"/></td>
                                    <td style="font-size:13px;"><span t-field="training.no_of_student"/></td>
                                    <td t-if="not is_cisco_u_all_access" style="font-size:13px;">
                                        <span t-if="o.display_location" t-field="training.location"/>
                                        <span t-if="o.display_location and o.display_where">, </span>
                                        <span t-if="o.display_where" t-field="training.where_location2"/>
                                    </td>
                                    <td t-if="not is_cisco_u_all_access" style="font-size:13px;"><span t-field="training.duration"/></td>
                                    <td t-if="not is_cisco_u_all_access" style="font-size:13px;"><span t-field="training.training_date_start"/> - <span t-field="training.training_date_end"/></td>
                                    <td t-if="not is_cisco_u_all_access" style="font-size:13px;"><span t-field="training.price"/></td>
                                    <t t-if="item == 1">
                                        <td t-if="o.display_total" t-att-rowspan="total_rows" style="font-size:13px;"><span t-field="o.total_training_price"/></td>
                                    </t>
                                </tr>
                                <t t-set="item" t-value="item + 1"/>
                            </t>
                        </tbody>
                    </table>

                    <!-- Totals -->
                    <div style="width:100%; margin:10px 0 14px 0; page-break-inside:avoid;">
                        <table class="table table-sm table-border"
                               style="
                                   background-color:#fff;
                                   width:30%;
                                   margin-left:auto;
                                   margin-right:0;
                                   border-collapse:collapse;
                               ">
                            <t t-set="tax_totals" t-value="o.tax_totals"/>

                            <t t-if="tax_totals.get('subtotals')">
                                <t t-foreach="tax_totals.get('subtotals')" t-as="subtotal">
                                    <tr class="border-grey o_subtotal">
                                        <td style="background-color:#fff; font-size:13px; line-height:1.3; padding:5px 6px;">
                                            <strong t-out="subtotal['name']">Untaxed Amount</strong>
                                        </td>
                                        <td style="background-color:#fff; text-align:right; font-size:13px; line-height:1.3; padding:5px 6px; white-space:nowrap;">
                                            <span t-att-class="oe_subtotal_footer_separator"
                                                  t-out="subtotal['formatted_amount']"/>
                                        </td>
                                    </tr>
                                    <t t-set="subtotal_to_show" t-value="subtotal['name']"/>
                                    <t t-call="account.tax_groups_totals"/>
                                </t>
                            </t>

                            <tr class="border-grey o_total">
                                <td style="background-color:#fff; font-size:13px; line-height:1.3; padding:5px 6px;">
                                    <strong t-if="is_clc_order">NIL ME Invoice Amount</strong>
                                    <strong t-if="not is_clc_order">Partner Invoice Amount</strong>
                                </td>
                                <td style="background-color:#fff; text-align:right; font-size:13px; line-height:1.3; padding:5px 6px; white-space:nowrap;">
                                    <span t-out="o.amount_total"
                                          t-options="{&quot;widget&quot;:&quot;monetary&quot;,&quot;display_currency&quot;:o.currency_id}"/>
                                </td>
                            </tr>
                        </table>
                    </div>

<div class="row pt-3 pb-2">
    <div class="col-12">
        <div t-field="o.term_and_cond" style="width:100%; font-size:13px; line-height:1.4;"/>
    </div>
</div>

                    <div class="row" style="page-break-inside:avoid; position: relative; min-height: 170px;">
                        <div style="position: absolute; bottom: 10px; right: 0; text-align: right; display: block;">
                            <div name="stamp" style="margin-bottom: 5px;">
                                <img t-if="o.company_id.stamp and o.display_stamp" 
                                     t-att-src="image_data_uri(o.company_id.stamp)" 
                                     style="height:170px; width:auto; object-fit:contain;" alt="Stamp"/>
                            </div>
                            <div name="signature">
                                <img t-if="o.company_id.signature and o.display_signature" 
                                     t-att-src="image_data_uri(o.company_id.signature)" 
                                     style="height:200px; width:auto; object-fit:contain;" alt="Signature"/>
                            </div>
                        </div>
                    </div>

<div class="row pt-3 pb-2" style="page-break-inside:avoid;">
    <div class="col-12">
        <p style="font-size:13px; line-height:1.4;"><span t-field="o.bank_details" style="font-size:13px; line-height:1.4;"/></p>
    </div>
</div>

                </t>
            </t>
        </t>
    </template>
</odoo>
