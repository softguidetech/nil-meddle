<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_po_document_training" name="Quotation Professional Service Report Training">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="invoice_training_details.custom_invoice_report_layout">
                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>
                    <div class="row">
                        <div class="col-12">
                            <span style="font-weight: bold; font-size: 12px; color: #17a2b8;">
                                Purchase Order
                            </span>
                        </div>
                    </div>
                    <div class="row pt-3 pb-3">
                        <div class="col-8">
                            <div style="font-size: 12px;">
                                <strong t-if="o.partner_id.is_company == True">Company Name:</strong>
                                <div t-if="o.partner_id.is_company == True" t-field="o.partner_id.name"/>
                                <strong t-if="o.partner_id.is_company == False">Company Name:</strong>
                                <div t-if="o.partner_id.is_company == False" t-field="o.partner_id.parent_id.name"/>
                                
                                <strong t-if="o.partner_id.is_company == True">Address:</strong>
                                <strong t-if="o.partner_id.is_company == False">Address:</strong>
                                <div t-if="o.partner_id.is_company == False">
                                    <span t-field="o.partner_id.city"/>, <span t-field="o.partner_id.country_id.name"/>
                                </div>

                                <div t-if="o.partner_id.is_company == True">
                                    <span t-field="o.partner_id.street"/> <span t-field="o.partner_id.street2"/>
                                </div>
                                <div t-if="o.partner_id.is_company == False">
                                    <span t-field="o.partner_id.street"/> <span t-field="o.partner_id.street2"/>
                                </div>
                                <div t-if="o.partner_id.is_company == True">
                                    <span t-field="o.partner_id.city"/>, <span t-field="o.partner_id.country_id.name"/>
                                </div>
                                <strong t-if="o.partner_id.is_company == True and o.partner_id.vat">Tax Number:</strong>
                                <div t-if="o.partner_id.is_company == True and o.partner_id.vat" t-field="o.partner_id.vat"/>
                                <strong t-if="o.partner_id.is_company == False and o.partner_id.parent_id.vat">Tax Number:</strong>
                                <div t-if="o.partner_id.is_company == False and o.partner_id.parent_id.vat" t-field="o.partner_id.parent_id.vat"/>
                                
                                <strong t-if="o.partner_id.is_company == False">Attention:</strong><br/>
                                <div t-if="o.partner_id.is_company == False" t-field="o.partner_id.name"/>
                            </div>
                        </div>

                        <div class="col-4">
                            <div style="font-size: 12px;">
                                <table class="table table-borderless">
                                    <tr class="p-0">
                                        <td class="p-0">Purchase Order</td>
                                        <td class="p-0"><span t-field="o.name"/></td>
                                    </tr>
                                    <tr class="p-0">
                                        <td class="p-0">Date</td>
                                        <td class="p-0"><span t-field="o.date_order"/></td>
                                    </tr>
                                    <tr class="p-0">
                                        <td class="p-0">Validity Date</td>
                                        <td class="p-0"><span t-field="o.validity_date"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <table t-if="o.display_training_table" class="table table-sm o_main_table table-bordered text-center" name="training_line_table" style="font-size: 12px;">
                        <thead>
                            <tr>
                                <th name="th_item" style="text-align: center; vertical-align: middle;">Item</th>
                                <th name="th_training_name" style="text-align: center; vertical-align: middle;">Training Name</th>
                                <th t-if="o.display_instructor" name="th_training_name" style="text-align: center; vertical-align: middle;">Instructor Name</th>
                                <th name="th_of_students" style="text-align: center; vertical-align: middle;"># Of Students</th>
                                <th name="th_training_name" style="text-align: center; vertical-align: middle;">
                                    <span t-if="o.display_location">Location</span>
                                    <span t-elif="o.display_where">Location1</span>
                                </th>
                                <th name="th_duration" style="text-align: center; vertical-align: middle;">Duration</th>
                                <th name="th_training_date" style="text-align: center; vertical-align: middle;">Training Dates</th>
                                <th name="th_training_date" style="text-align: center; vertical-align: middle;">Training Price</th>
                                <th t-if="o.display_total" name="th_training_date" style="max-width:80px;text-align: center; vertical-align: middle;">Total Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="item" t-value="1"/>
                            <t t-set="total_rows" t-value="len(o.training_course_ids)"/>
                            <t t-foreach="o.training_course_ids" t-as="training">
                                <tr>
                                    <td style="text-align: center; vertical-align: middle;"><span t-esc="item"/></td>
                                    <td style="text-align: left; vertical-align: middle;"><span t-field="training.training_id"/></td>
                                    <td t-if="o.display_instructor" style="text-align: center; vertical-align: middle;"><span t-field="training.instructor_id.name"/></td>
                                    <td style="text-align: center; vertical-align: middle;"><span t-field="training.no_of_student"/></td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span t-if="o.display_location" t-field="training.location"/>
                                        <span t-if="o.display_location and o.display_where">, </span>
                                        <span t-if="o.display_where" t-field="training.where_location2"/>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;"><span t-field="training.duration"/></td>
                                    <td style="text-align: center; vertical-align: middle;"><span t-field="training.training_date_start"/> - <span t-field="training.training_date_end"/></td>
                                    <td style="text-align: center; vertical-align: middle;"><span t-field="training.price"/></td>
                                    <t t-if="item == 1">
                                        <td t-if="o.display_total" t-att-rowspan="total_rows" style="text-align: center; vertical-align: middle;"><span t-field="o.total_training_price"/></td>
                                    </t>
                                </tr>
                                <t t-set="item" t-value="item + 1"/>
                            </t>
                        </tbody>
                    </table>

                    <div class="row pt-3 pb-2" style="page-break-inside:avoid; display: flex; justify-content: space-between; align-items: flex-start; font-size: 12px;">
                        <div class="col-auto" style="flex: 1 1 auto;">
                            <br/><br/>
                            <strong style="color: #0DCAF0;">Course Content:</strong>
                            <table class="table table-sm" style="background-color:#fff; color: white; width: auto; border: none; font-size: 12px;">
                                <tbody>
                                    <t t-foreach="o.training_course_ids" t-as="training">
                                        <tr>
                                            <td style="color: white;">
                                                <a t-att-href="training.hyperlink" target="_blank" style="color: #0ecaf0;">
                                                    <span t-field="training.training_id" style="color: black"/>
                                                </a>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-auto" style="min-width: 300px; flex: 0 0 auto; margin-left: auto; text-align: left; position: absolute; right: 15px;">
                            <table class="table table-sm table-border" style="background-color:#fff; width: 300px; font-size: 12px;">
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-if="tax_totals.get('subtotals')">
                                    <t t-foreach="tax_totals.get('subtotals')" t-as="subtotal">
                                        <tr class="border-grey o_subtotal">
                                            <td style="background-color:#fff;">
                                                <strong t-out="subtotal['name']">Untaxed Amount</strong>
                                            </td>
                                            <td style="background-color:#fff; text-align: right;">
                                                <span t-att-class="oe_subtotal_footer_separator" t-out="subtotal['formatted_amount']"/>
                                            </td>
                                        </tr>
                                        <t t-set="subtotal_to_show" t-value="subtotal['name']"/>
                                        <t t-call="account.tax_groups_totals"/>
                                    </t>
                                </t>
                                <tr class="border-grey o_total">
                                    <td style="background-color:#fff;"><strong>NIL ME Invoice Amount</strong></td>
                                    <td style="background-color:#fff; text-align: right;">
                                        <span t-out="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                    </td>
                                </tr>
                            </table>
                            <br/><br/>
                        </div>
                    </div>

                    <div class="row pt-3 pb-2" style="page-break-inside:avoid; font-size: 12px;">
                        <div class="col-8">
                            <p><span t-field="o.term_and_cond"/></p>
                        </div>
                    </div>

                    <div class="row" style="page-break-inside:avoid; position: relative; min-height: 150px;">
                        <div style="position: absolute; bottom: 10px; right: 0; text-align: right; display: block;">
                            <div name="stamp" style="margin-bottom: 5px;">
                                <img t-if="o.company_id.stamp and o.display_stamp" t-att-src="image_data_uri(o.company_id.stamp)" style="max-height: 150px;" alt="Stamp"/>
                            </div>
                            <div name="signature">
                                <img t-if="o.company_id.signature and o.display_signature" t-att-src="image_data_uri(o.company_id.signature)" style="max-height: 150px;" alt="Signature"/>
                            </div>
                        </div>
                    </div>

                    <div class="row pt-3 pb-2" style="page-break-inside:avoid; font-size: 12px;">
                        <div class="col-12">
                            <p><span t-field="o.bank_details"/></p>
                        </div>
                    </div>

                </t>
            </t>
        </t>
    </template>
</odoo>
