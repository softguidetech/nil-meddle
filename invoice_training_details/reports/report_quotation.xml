<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_quotation_document_training" name="Quotation Report Training">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>

                <t t-call="invoice_training_details.custom_invoice_report_layout">

                    <style>
                        table[name="training_line_table"] th,
                        table[name="training_line_table"] td {
                            text-align: center !important;
                            vertical-align: middle !important;
                        }

                        table[name="training_line_table"] th span,
                        table[name="training_line_table"] td span,
                        table[name="training_line_table"] td div {
                            text-align: center !important;
                            vertical-align: middle !important;
                        }
                    </style>

                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>

                    <!-- العنوان الرئيسي -->
                    <div class="row">
                        <div class="col-18">
                            <span style="font-size:30px; font-weight:bold; color:#0DCAF0;">
                                Quotation
                            </span>
                        </div>
                    </div>

                    <!-- بيانات العميل -->
                    <div class="row pt-3 pb-3">

                        <div class="col-8">
                            <div>

                                <strong
                                    t-if="o.partner_id.is_company == True"
                                    style="font-size:20px;"
                                >
                                    Company Name:
                                </strong>

                                <div
                                    t-if="o.partner_id.is_company == True"
                                    t-field="o.partner_id.name"
                                    style="font-size:20px;"
                                />

                                <strong
                                    t-if="o.partner_id.is_company == False"
                                    style="font-size:20px;"
                                >
                                    Company Name:
                                </strong>

                                <div
                                    t-if="o.partner_id.is_company == False"
                                    t-field="o.partner_id.parent_id.name"
                                    style="font-size:20px;"
                                />

                                <strong style="font-size:20px;">
                                    Address:
                                </strong>

                                <div style="font-size:20px;">
                                    <span t-field="o.partner_id.street"/>
                                    <span t-field="o.partner_id.street2"/>
                                </div>

                                <div style="font-size:20px;">
                                    <span t-field="o.partner_id.city"/>,
                                    <span t-field="o.partner_id.country_id.name"/>
                                </div>

                                <strong
                                    t-if="o.partner_id.is_company == True and o.partner_id.vat"
                                    style="font-size:20px;"
                                >
                                    Tax Number:
                                </strong>

                                <div
                                    t-if="o.partner_id.is_company == True and o.partner_id.vat"
                                    t-field="o.partner_id.vat"
                                    style="font-size:20px;"
                                />

                                <strong
                                    t-if="o.partner_id.is_company == False and o.partner_id.parent_id.vat"
                                    style="font-size:20px;"
                                >
                                    Tax Number:
                                </strong>

                                <div
                                    t-if="o.partner_id.is_company == False and o.partner_id.parent_id.vat"
                                    t-field="o.partner_id.parent_id.vat"
                                    style="font-size:20px;"
                                />

                                <strong
                                    t-if="o.partner_id.is_company == False"
                                    style="font-size:20px;"
                                >
                                    Attention:
                                </strong>

                                <div
                                    t-if="o.partner_id.is_company == False"
                                    t-field="o.partner_id.name"
                                    style="font-size:20px;"
                                />

                            </div>
                        </div>

                        <!-- بيانات الكوتيشن -->
                        <div class="col-4">
                            <div>

                                <table class="table table-borderless">

                                    <tr>
                                        <td style="font-size:20px; vertical-align:middle;">
                                            Quotation
                                        </td>

                                        <td style="font-size:20px; vertical-align:middle;">
                                            <span t-field="o.name"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="font-size:20px; vertical-align:middle;">
                                            Date
                                        </td>

                                        <td style="font-size:20px; vertical-align:middle;">
                                            <span t-field="o.date_order"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="font-size:20px; vertical-align:middle;">
                                            Validity Date
                                        </td>

                                        <td style="font-size:20px; vertical-align:middle;">
                                            <span t-field="o.validity_date"/>
                                        </td>
                                    </tr>

                                </table>

                            </div>
                        </div>

                    </div>

                    <!-- جدول التدريب -->
                    <table
                        t-if="o.display_training_table"
                        class="table table-sm o_main_table table-bordered text-center"
                        name="training_line_table"
                        style="
                            width:100%;
                            text-align:center;
                            vertical-align:middle;
                        "
                    >

                        <thead>
                            <tr>

                                <th style="
                                    font-size:18px;
                                    text-align:center;
                                    vertical-align:middle;
                                ">
                                    Item
                                </th>

                                <th style="
                                    font-size:18px;
                                    text-align:center;
                                    vertical-align:middle;
                                ">
                                    Training Name
                                </th>

                                <th
                                    t-if="o.display_instructor"
                                    style="
                                        font-size:18px;
                                        text-align:center;
                                        vertical-align:middle;
                                    "
                                >
                                    Instructor Name
                                </th>

                                <th style="
                                    font-size:18px;
                                    text-align:center;
                                    vertical-align:middle;
                                ">
                                    # Of Students
                                </th>

                                <th style="
                                    font-size:18px;
                                    text-align:center;
                                    vertical-align:middle;
                                ">
                                    <span t-if="o.display_location">
                                        Location
                                    </span>

                                    <span t-elif="o.display_where">
                                        Location1
                                    </span>
                                </th>

                                <th style="
                                    font-size:18px;
                                    text-align:center;
                                    vertical-align:middle;
                                ">
                                    Duration
                                </th>

                                <th style="
                                    font-size:18px;
                                    text-align:center;
                                    vertical-align:middle;
                                ">
                                    Training Dates
                                </th>

                                <th style="
                                    font-size:18px;
                                    text-align:center;
                                    vertical-align:middle;
                                ">
                                    Training Price
                                </th>

                                <th
                                    t-if="o.display_total"
                                    style="
                                        font-size:18px;
                                        text-align:center;
                                        vertical-align:middle;
                                    "
                                >
                                    Total Price
                                </th>

                            </tr>
                        </thead>

                        <tbody>

                            <t t-set="item" t-value="1"/>

                            <t
                                t-set="total_rows"
                                t-value="len(o.training_course_ids)"
                            />

                            <t
                                t-foreach="o.training_course_ids"
                                t-as="training"
                            >

                                <tr>

                                    <td style="
                                        font-size:18px;
                                        text-align:center;
                                        vertical-align:middle;
                                    ">
                                        <span t-esc="item"/>
                                    </td>

                                    <td style="
                                        font-size:18px;
                                        text-align:center;
                                        vertical-align:middle;
                                    ">
                                        <span t-field="training.training_id"/>
                                    </td>

                                    <td
                                        t-if="o.display_instructor"
                                        style="
                                            font-size:20px;
                                            text-align:center;
                                            vertical-align:middle;
                                        "
                                    >
                                        <span t-field="training.instructor_id.name"/>
                                    </td>

                                    <td style="
                                        font-size:18px;
                                        text-align:center;
                                        vertical-align:middle;
                                    ">
                                        <span t-field="training.no_of_student"/>
                                    </td>

                                    <td style="
                                        font-size:18px;
                                        text-align:center;
                                        vertical-align:middle;
                                    ">

                                        <span
                                            t-if="o.display_location"
                                            t-field="training.location"
                                        />

                                        <span
                                            t-if="o.display_location and o.display_where"
                                        >
                                            ,
                                        </span>

                                        <span
                                            t-if="o.display_where"
                                            t-field="training.where_location2"
                                        />

                                    </td>

                                    <td style="
                                        font-size:18px;
                                        text-align:center;
                                        vertical-align:middle;
                                    ">
                                        <span t-field="training.duration"/>
                                    </td>

                                    <td style="
                                        font-size:18px;
                                        text-align:center;
                                        vertical-align:middle;
                                    ">

                                        <span t-field="training.training_date_start"/>

                                        -

                                        <span t-field="training.training_date_end"/>

                                    </td>

                                    <!-- السعر بعملة الكوتيشن CLC -->
                                    <td style="
                                        font-size:18px;
                                        text-align:center;
                                        vertical-align:middle;
                                    ">

                                        <span
                                            t-out="training.price"
                                            t-options="{
                                                'widget': 'monetary',
                                                'display_currency': o.currency_id
                                            }"
                                        />

                                    </td>

                                    <t t-if="item == 1">

                                        <!-- المجموع بعملة الكوتيشن CLC -->
                                        <td
                                            t-if="o.display_total"
                                            t-att-rowspan="total_rows"
                                            style="
                                                font-size:18px;
                                                text-align:center;
                                                vertical-align:middle;
                                            "
                                        >

                                            <span
                                                t-out="o.total_training_price"
                                                t-options="{
                                                    'widget': 'monetary',
                                                    'display_currency': o.currency_id
                                                }"
                                            />

                                        </td>

                                    </t>

                                </tr>

                                <t
                                    t-set="item"
                                    t-value="item + 1"
                                />

                            </t>

                        </tbody>

                    </table>

                    <!-- Course Content -->
                    <div
                        class="row pt-3 pb-2"
                        style="
                            page-break-inside:avoid;
                            display:flex;
                            justify-content:space-between;
                            align-items:flex-start;
                        "
                    >

                        <div
                            class="col-auto"
                            style="flex:1 1 auto;"
                        >

                            <br/>
                            <br/>

                            <table
                                class="table table-sm"
                                style="
                                    background-color:#fff;
                                    color:white;
                                    width:auto;
                                    border:none;
                                "
                            >
                                <tbody>

                                </tbody>
                            </table>

                        </div>

                        <!-- الحسابات والمجموع -->
                        <div
                            class="col-auto"
                            style="
                                min-width:300px;
                                flex:0 0 auto;
                                margin-left:auto;
                                text-align:left;
                                position:absolute;
                                right:15px;
                            "
                        >

                            <table
                                class="table table-sm table-border"
                                style="
                                    background-color:#fff;
                                    width:300px;
                                "
                            >

                                <t
                                    t-set="tax_totals"
                                    t-value="o.tax_totals"
                                />

                                <t t-if="tax_totals.get('subtotals')">

                                    <t
                                        t-foreach="tax_totals.get('subtotals')"
                                        t-as="subtotal"
                                    >

                                        <tr class="border-grey o_subtotal">

                                            <td style="
                                                background-color:#fff;
                                                font-size:20px;
                                            ">

                                                <strong t-out="subtotal['name']">
                                                    Untaxed Amount
                                                </strong>

                                            </td>

                                            <td style="
                                                background-color:#fff;
                                                text-align:right;
                                                font-size:20px;
                                            ">

                                                <span
                                                    t-att-class="oe_subtotal_footer_separator"
                                                    t-out="subtotal.get('amount', 0.0)"
                                                    t-options="{
                                                        'widget': 'monetary',
                                                        'display_currency': o.currency_id
                                                    }"
                                                />

                                            </td>

                                        </tr>

                                        <t
                                            t-set="subtotal_to_show"
                                            t-value="subtotal['name']"
                                        />

                                        <!-- الضرائب بعملة الكوتيشن CLC -->
                                        <t
                                            t-foreach="tax_totals.get('groups_by_subtotal', {}).get(subtotal['name'], [])"
                                            t-as="tax_group"
                                        >

                                            <tr class="border-grey">

                                                <td style="
                                                    background-color:#fff;
                                                    font-size:20px;
                                                ">

                                                    <span t-out="tax_group.get('tax_group_name')"/>

                                                </td>

                                                <td style="
                                                    background-color:#fff;
                                                    text-align:right;
                                                    font-size:20px;
                                                ">

                                                    <span
                                                        t-out="tax_group.get('tax_group_amount', 0.0)"
                                                        t-options="{
                                                            'widget': 'monetary',
                                                            'display_currency': o.currency_id
                                                        }"
                                                    />

                                                </td>

                                            </tr>

                                        </t>

                                    </t>

                                </t>

                                <tr
                                    t-if="tax_totals.get('rounding_amount', 0) != 0"
                                    class="border-grey"
                                >

                                    <td style="
                                        background-color:#fff;
                                        font-size:20px;
                                    ">
                                        Rounding
                                    </td>

                                    <td style="
                                        background-color:#fff;
                                        text-align:right;
                                        font-size:20px;
                                    ">

                                        <span
                                            t-out="tax_totals.get('rounding_amount', 0.0)"
                                            t-options="{
                                                'widget': 'monetary',
                                                'display_currency': o.currency_id
                                            }"
                                        />

                                    </td>

                                </tr>

                                <tr class="border-grey o_total">

                                    <td style="
                                        background-color:#fff;
                                        font-size:20px;
                                    ">

                                        <strong>
                                            Quotation Amount
                                        </strong>

                                    </td>

                                    <td style="
                                        background-color:#fff;
                                        text-align:right;
                                        font-size:15px;
                                    ">

                                        <span
                                            t-out="o.amount_total"
                                            t-options="{
                                                'widget': 'monetary',
                                                'display_currency': o.currency_id
                                            }"
                                        />

                                    </td>

                                </tr>

                            </table>

                            <br/>
                            <br/>

                        </div>

                    </div>

                    <!-- الشروط -->
                    <!-- مساحة يمين النص مخصصة للختم والتوقيع -->
                    <div
                        class="row pt-3 pb-2"
                        style="
                            page-break-inside:auto;
                            padding-right:250px;
                            min-height:230px;
                        "
                    >

                        <div class="col-12">

                            <p style="
                                font-size:28px;
                                margin-bottom:0;
                                page-break-inside:auto;
                            ">

                                <span
                                    t-field="o.term_and_cond"
                                    style="font-size:22px;"
                                />

                            </p>

                        </div>

                    </div>

                    <!-- الختم والتوقيع في الزاوية السفلية اليمنى -->
                    <!-- لا يحجزان مساحة ولا ينشئان صفحة ثانية -->
                    <div
                        style="
                            position:absolute;
                            top:900px;
                            right:0;
                            width:230px;
                            height:185px;
                            margin:0;
                            padding:0;
                            text-align:right;
                            z-index:9999;
                            overflow:visible;
                        "
                    >

                        <!-- الختم -->
                        <img
                            t-if="o.company_id.stamp and o.display_stamp"
                            t-att-src="image_data_uri(o.company_id.stamp)"
                            alt="Stamp"
                            style="
                                position:absolute;
                                top:0;
                                right:0;
                                display:block;
                                max-width:210px;
                                max-height:165px;
                                width:auto;
                                height:auto;
                                margin:0;
                                padding:0;
                                border:0;
                                z-index:1;
                            "
                        />

                        <!-- التوقيع -->
                        <img
                            t-if="o.company_id.signature and o.display_signature"
                            t-att-src="image_data_uri(o.company_id.signature)"
                            alt="Signature"
                            style="
                                position:absolute;
                                right:0;
                                bottom:0;
                                display:block;
                                max-width:155px;
                                max-height:95px;
                                width:auto;
                                height:auto;
                                margin:0;
                                padding:0;
                                border:0;
                                z-index:2;
                            "
                        />

                    </div>

                    <!-- بيانات البنك -->
                    <div
                        class="row pt-3 pb-2"
                        style="page-break-inside:avoid;"
                    >

                        <div class="col-12">

                            <p style="font-size:22px;">

                                <span
                                    t-field="o.bank_details"
                                    style="font-size:22px;"
                                />

                            </p>

                        </div>

                    </div>

                </t>
            </t>

        </t>
    </template>
</odoo>
