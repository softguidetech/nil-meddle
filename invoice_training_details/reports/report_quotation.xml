<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_quotation_document_training" name="Quotation Report Training">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>

                <t t-call="invoice_training_details.custom_invoice_report_layout">

                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-set="customer_partner"
                       t-value="o.partner_id if o.partner_id.is_company else (o.partner_id.parent_id or o.partner_id)"/>

                    <style>
                        .nil-quotation-root {
                            width: 100%;
                            font-family: inherit;
                            font-size: 15.5px;
                            line-height: 1.5;
                            color: #111;
                        }

                        .nil-quotation-title {
                            color: #0DCAF0;
                            font-size: 29px;
                            font-weight: 600;
                            line-height: 1.1;
                            margin: 0 0 22px 0;
                            padding: 0;
                        }

                        .nil-quotation-meta {
                            width: 100%;
                            border-collapse: collapse;
                            margin: 0 0 22px 0;
                        }

                        .nil-quotation-meta td {
                            border: 0 !important;
                            padding: 3px 0 !important;
                            vertical-align: top !important;
                            font-size: 15.5px !important;
                            line-height: 1.55 !important;
                        }

                        .nil-quotation-meta .label {
                            font-weight: 700;
                            white-space: nowrap;
                            padding-right: 5px !important;
                        }

                        .nil-training-table {
                            width: 100%;
                            border-collapse: collapse !important;
                            table-layout: auto;
                            margin: 4px 0 14px 0 !important;
                        }

                        .nil-training-table thead {
                            display: table-header-group !important;
                        }

                        .nil-training-table thead th {
                            background: #EAF9FC !important;
                            color: #075E68 !important;
                            border: 1px solid #A9DCE5 !important;
                            padding: 9px 7px !important;
                            font-size: 14.5px !important;
                            font-weight: 700 !important;
                            line-height: 1.4 !important;
                            text-align: center !important;
                            vertical-align: middle !important;
                        }

                        .nil-training-table tbody tr {
                            page-break-inside: avoid !important;
                        }

                        .nil-training-table tbody td {
                            border: 1px solid #D0E5EA !important;
                            padding: 9px 7px !important;
                            font-size: 14.5px !important;
                            line-height: 1.45 !important;
                            vertical-align: middle !important;
                            background: #fff !important;
                        }

                        .nil-training-table .text-left {
                            text-align: left !important;
                        }

                        .nil-training-table .text-center {
                            text-align: center !important;
                        }

                        .nil-total-wrap {
                            width: 100%;
                            text-align: right;
                            margin: 10px 0 24px 0;
                            page-break-inside: avoid !important;
                        }

                        .nil-total-table {
                            width: 315px;
                            margin-left: auto;
                            margin-right: 0;
                            border-collapse: collapse;
                        }

                        .nil-total-table td {
                            border: 1px solid #CFE3E8 !important;
                            background: #fff !important;
                            padding: 8px 10px !important;
                            font-size: 14.5px !important;
                            line-height: 1.45 !important;
                        }

                        .nil-total-table .total-label {
                            color: #075E68;
                            font-weight: 700;
                            text-align: left;
                            white-space: nowrap;
                        }

                        .nil-total-table .total-value {
                            font-weight: 700;
                            text-align: right;
                            white-space: nowrap;
                        }

                        .nil-terms,
                        .nil-bank {
                            width: 100%;
                            font-size: 15px !important;
                            line-height: 1.55 !important;
                            margin: 0;
                            padding: 0;
                            page-break-inside: auto !important;
                        }

                        .nil-terms {
                            margin-top: 14px;
                        }

                        .nil-terms *,
                        .nil-bank * {
                            font-family: inherit !important;
                            font-size: 15px !important;
                            line-height: 1.55 !important;
                        }

                        .nil-terms p,
                        .nil-bank p {
                            margin: 0 0 7px 0 !important;
                            padding: 0 !important;
                        }

                        .nil-terms ul,
                        .nil-terms ol,
                        .nil-bank ul,
                        .nil-bank ol {
                            margin: 0 0 7px 0 !important;
                            padding-left: 24px !important;
                        }

                        .nil-terms li,
                        .nil-bank li {
                            margin: 0 0 4px 0 !important;
                            padding: 0 !important;
                        }

                        .nil-bank {
                            margin-top: 16px;
                        }

                        .nil-signature {
                            width: 100%;
                            text-align: right;
                            margin-top: 14px;
                            page-break-inside: avoid !important;
                            page-break-before: avoid !important;
                            white-space: nowrap;
                        }

                        .nil-signature img {
                            display: inline-block;
                            vertical-align: bottom;
                            object-fit: contain;
                        }
                    </style>

                    <div class="nil-quotation-root">

                        <!-- Title -->
                        <div class="nil-quotation-title">
                            Quotation
                        </div>

                        <!-- Customer + quotation details -->
                        <table class="nil-quotation-meta">
                            <tr>
                                <td style="width:66%;">
                                    <table style="width:100%; border-collapse:collapse;">
                                        <tr>
                                            <td class="label" style="width:105px;">Company Name:</td>
                                            <td>
                                                <span t-field="customer_partner.name"/>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td class="label">Address:</td>
                                            <td>
                                                <span t-if="customer_partner.street"
                                                      t-field="customer_partner.street"/>

                                                <t t-if="customer_partner.street2">
                                                    <t t-if="customer_partner.street">, </t>
                                                    <span t-field="customer_partner.street2"/>
                                                </t>

                                                <t t-if="customer_partner.city">
                                                    <t t-if="customer_partner.street or customer_partner.street2">, </t>
                                                    <span t-field="customer_partner.city"/>
                                                </t>

                                                <t t-if="customer_partner.state_id">
                                                    <t t-if="customer_partner.street or customer_partner.street2 or customer_partner.city">, </t>
                                                    <span t-field="customer_partner.state_id.name"/>
                                                </t>

                                                <t t-if="customer_partner.zip">
                                                    <t t-if="customer_partner.street or customer_partner.street2 or customer_partner.city or customer_partner.state_id"> </t>
                                                    <span t-field="customer_partner.zip"/>
                                                </t>

                                                <t t-if="customer_partner.country_id">
                                                    <t t-if="customer_partner.street or customer_partner.street2 or customer_partner.city or customer_partner.state_id or customer_partner.zip">, </t>
                                                    <span t-field="customer_partner.country_id.name"/>
                                                </t>
                                            </td>
                                        </tr>

                                        <tr t-if="o.partner_id.email or customer_partner.email">
                                            <td class="label">Email:</td>
                                            <td>
                                                <span t-if="o.partner_id.email"
                                                      t-field="o.partner_id.email"/>
                                                <span t-else=""
                                                      t-field="customer_partner.email"/>
                                            </td>
                                        </tr>

                                        <tr t-if="customer_partner.vat">
                                            <td class="label">Tax Number:</td>
                                            <td>
                                                <span t-field="customer_partner.vat"/>
                                            </td>
                                        </tr>

                                        <tr t-if="not o.partner_id.is_company">
                                            <td class="label">Attention:</td>
                                            <td>
                                                <span t-field="o.partner_id.name"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>

                                <td style="width:34%; padding-left:34px !important;">
                                    <table style="width:100%; border-collapse:collapse;">
                                        <tr>
                                            <td class="label" style="width:72px;">Quot#:</td>
                                            <td style="white-space:nowrap;">
                                                <span t-if="o.name"
                                                      t-esc="
                                                        o.name
                                                        if o.name.startswith('Q')
                                                        else 'Q' + (
                                                            o.name[2:]
                                                            if o.name.startswith('SO')
                                                            else o.name[1:]
                                                            if o.name.startswith('S')
                                                            else o.name
                                                        )
                                                      "/>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td class="label">DATE:</td>
                                            <td style="white-space:nowrap;">
                                                <span t-field="o.date_order"
                                                      t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>


                        <!-- Training table -->
                        <table t-if="o.display_training_table"
                               class="nil-training-table"
                               name="training_line_table">

                            <thead>
                                <tr>
                                    <th style="width:5%;">Item</th>
                                    <th style="width:36%;">Training Name</th>
                                    <th t-if="o.display_instructor"
                                        style="width:13%;">Instructor Name</th>
                                    <th style="width:10%;"># Of Students</th>
                                    <th style="width:11%;">Location</th>
                                    <th style="width:9%;">Duration</th>
                                    <th style="width:13%;">Training Dates</th>
                                    <th style="width:10%;">Training Price</th>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-set="item" t-value="1"/>

                                <t t-foreach="o.training_course_ids"
                                   t-as="training">

                                    <tr>
                                        <td class="text-center">
                                            <span t-esc="item"/>
                                        </td>

                                        <td class="text-left">
                                            <span t-field="training.training_id"/>

                                            <t t-if="training.hyperlink">
                                                <span> - </span>
                                                <a t-att-href="training.hyperlink"
                                                   target="_blank"
                                                   style="text-decoration:underline;">
                                                    Course Content
                                                </a>
                                            </t>
                                        </td>

                                        <td t-if="o.display_instructor"
                                            class="text-center">
                                            <span t-field="training.instructor_id.name"/>
                                        </td>

                                        <td class="text-center">
                                            <span t-field="training.no_of_student"/>
                                        </td>

                                        <td class="text-center">
                                            <span t-if="o.display_location"
                                                  t-field="training.location"/>
                                            <span t-if="o.display_location and o.display_where and training.location and training.where_location2">, </span>
                                            <span t-if="o.display_where"
                                                  t-field="training.where_location2"/>
                                        </td>

                                        <td class="text-center">
                                            <span t-field="training.duration"/>
                                        </td>

                                        <td class="text-center"
                                            style="white-space:nowrap;">
                                            <span t-field="training.training_date_start"/>
                                            <span> - </span>
                                            <span t-field="training.training_date_end"/>
                                        </td>

                                        <td class="text-center"
                                            style="white-space:nowrap;">
                                            <span t-field="training.price"/>
                                        </td>
                                    </tr>

                                    <t t-set="item" t-value="item + 1"/>
                                </t>
                            </tbody>
                        </table>


                        <!-- Totals -->
                        <div t-if="o.display_total"
                             class="nil-total-wrap">

                            <table class="nil-total-table">
                                <t t-set="tax_totals"
                                   t-value="o.tax_totals"/>

                                <t t-if="tax_totals.get('subtotals')">
                                    <t t-foreach="tax_totals.get('subtotals')"
                                       t-as="subtotal">

                                        <tr>
                                            <td class="total-label">
                                                <span t-out="subtotal['name']"/>
                                            </td>
                                            <td class="total-value">
                                                <span t-out="subtotal['formatted_amount']"/>
                                            </td>
                                        </tr>

                                        <t t-set="subtotal_to_show"
                                           t-value="subtotal['name']"/>

                                        <t t-call="account.tax_groups_totals"/>
                                    </t>
                                </t>

                                <tr>
                                    <td class="total-label">
                                        Total Amount
                                    </td>
                                    <td class="total-value">
                                        <span t-out="o.amount_total"
                                              t-options="{
                                                  &quot;widget&quot;: &quot;monetary&quot;,
                                                  &quot;display_currency&quot;: o.currency_id
                                              }"/>
                                    </td>
                                </tr>
                            </table>
                        </div>


                        <!-- Terms
                             IMPORTANT: term_and_cond is an Html field.
                             Render it directly as a div, not inside p/span.
                        -->
                        <div t-if="o.term_and_cond"
                             class="nil-terms"
                             t-field="o.term_and_cond"/>


                        <!-- Bank details -->
                        <div t-if="o.bank_details"
                             class="nil-bank"
                             t-field="o.bank_details"/>


                        <!-- Signature + Stamp -->
                        <div t-if="(o.company_id.stamp and o.display_stamp) or (o.company_id.signature and o.display_signature)"
                             class="nil-signature">

                            <img t-if="o.company_id.signature and o.display_signature"
                                 t-att-src="image_data_uri(o.company_id.signature)"
                                 style="
                                    max-height:82px;
                                    max-width:140px;
                                    width:auto;
                                    height:auto;
                                    margin-right:6px;
                                 "
                                 alt="Signature"/>

                            <img t-if="o.company_id.stamp and o.display_stamp"
                                 t-att-src="image_data_uri(o.company_id.stamp)"
                                 style="
                                    max-height:92px;
                                    max-width:140px;
                                    width:auto;
                                    height:auto;
                                 "
                                 alt="Stamp"/>
                        </div>

                    </div>

                </t>
            </t>
        </t>
    </template>
</odoo>
