<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_quotation_document_training" name="Quotation Report Training">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <t t-set="lang" t-value="o.partner_id.lang"/>

                <t t-call="invoice_training_details.custom_invoice_report_layout">

                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>

                    <div class="row">
                        <div class="col-12">
                            <span class="h4 text-info">QUOTATION</span>
                        </div>
                    </div>

                    <div class="row pt-3 pb-3">

                        <div class="col-8">
                            <div>

                                <strong t-if="o.partner_id.is_company == True">
                                    Company Name:
                                </strong>
                                <br/>

                                <div
                                    t-if="o.partner_id.is_company == True"
                                    t-field="o.partner_id.name"
                                />

                                <strong t-if="o.partner_id.is_company == False">
                                    Company Name:
                                </strong>
                                <br/>

                                <div
                                    t-if="o.partner_id.is_company == False"
                                    t-field="o.partner_id.parent_id.name"
                                />

                                <strong t-if="o.partner_id.is_company == False">
                                    Attention:
                                </strong>
                                <br/>

                                <div
                                    t-if="o.partner_id.is_company == False"
                                    t-field="o.partner_id.name"
                                />

                            </div>
                        </div>

                        <div class="col-4">
                            <div>

                                <table class="table table-borderless">

                                    <tr class="p-0">
                                        <td class="p-0">QUOTATION</td>
                                        <td class="p-0">
                                            <span t-field="o.name"/>
                                        </td>
                                    </tr>

                                    <tr class="p-0">
                                        <td class="p-0">DATE</td>
                                        <td class="p-0">
                                            <span t-field="o.date_order"/>
                                        </td>
                                    </tr>

                                    <tr class="p-0">
                                        <td class="p-0">DUE DATE</td>
                                        <td class="p-0">
                                            <span t-field="o.validity_date"/>
                                        </td>
                                    </tr>

                                </table>

                            </div>
                        </div>

                    </div>

                    <table
                        t-if="o.display_training_table"
                        class="table table-sm o_main_table table-bordered text-center"
                        name="training_line_table"
                    >

                        <thead>
                            <tr>

                                <th
                                    name="th_item"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Item</span>
                                </th>

                                <th
                                    name="th_training_name"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Training Name</span>
                                </th>

                                <th
                                    t-if="o.display_description"
                                    name="th_description"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Description</span>
                                </th>

                                <th
                                    t-if="o.display_instructor"
                                    name="th_instructor"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Instructor Name</span>
                                </th>

                                <th
                                    name="th_language"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Language</span>
                                </th>

                                <th
                                    name="th_of_students"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span># Of Students</span>
                                </th>

                                <th
                                    t-if="o.display_location"
                                    name="th_location"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Location</span>
                                </th>

                                <th
                                    t-if="o.display_where"
                                    name="th_location_2"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Location1</span>
                                </th>

                                <th
                                    name="th_duration"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Duration</span>
                                </th>

                                <th
                                    name="th_training_date"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Training Dates</span>
                                </th>

                                <th
                                    name="th_training_price"
                                    style="text-align: center; vertical-align: middle;"
                                >
                                    <span>Training Price</span>
                                </th>

                                <th
                                    t-if="o.display_total"
                                    name="th_total_price"
                                    style="max-width:80px; text-align: center; vertical-align: middle;"
                                >
                                    <span>Total Price</span>
                                </th>

                            </tr>
                        </thead>

                        <tbody>

                            <t t-set="item" t-value="1"/>
                            <t
                                t-set="total_rows"
                                t-value="len(o.training_course_ids)"
                            />

                            <t
                                t-foreach="o.training_course_ids"
                                t-as="training"
                            >

                                <tr>

                                    <td
                                        style="text-align: center; vertical-align: middle;"
                                    >
                                        <span t-esc="item"/>
                                    </td>

                                    <td
                                        style="text-align: center; vertical-align: middle;"
                                    >
                                        <span t-field="training.training_id"/>
                                    </td>

                                    <td
                                        t-if="o.display_description"
                                        style="text-align: center; vertical-align: middle;"
                                    >
                                        <span t-field="training.descriptions"/>
                                    </td>

                                    <td
                                        t-if="o.display_instructor"
                                        style="text-align: center; vertical-align: middle;"
                                    >
                                        <span t-field="training.instructor_id.name"/>
                                    </td>

                                    <td
                                        style="text-align: center; vertical-align: middle;"
                                    >
                                        <span t-field="training.train_language"/>
                                    </td>

                                    <td
                                        style="text-align: center; vertical-align: middle;"
                                    >
                                        <span t-field="training.no_of_student"/>
                                    </td>

                                    <td
                                        t-if="o.display_location"
                                        style="text-align: center; vertical-align: middle;"
                                    >
                                        <span t-field="training.location"/>
                                    </td>

                                    <td
                                        t-if="o.display_where"
                                        style="text-align: center; vertical-align: middle;"
                                    >
                                        <span t-field="training.where_location2"/>
                                    </td>

                                    <td
                                        style="text-align: center; vertical-align: middle;"
                                    >
                                        <span t-field="training.duration"/>
                                    </td>

                                    <td
                                        style="text-align: center; vertical-align: middle;"
                                    >
                                        <span t-field="training.training_date_start"/>
                                        -
                                        <span t-field="training.training_date_end"/>
                                    </td>

                                    <td
                                        style="text-align: center; vertical-align: middle;"
                                    >
                                        <span t-field="training.price"/>
                                    </td>

                                    <t t-if="item == 1">

                                        <td
                                            t-if="o.display_total"
                                            t-att-rowspan="total_rows"
                                            style="text-align: center; vertical-align: middle;"
                                        >
                                            <span t-field="o.total_training_price"/>
                                        </td>

                                    </t>

                                </tr>

                                <t t-set="item" t-value="item + 1"/>

                            </t>

                        </tbody>

                    </table>

                    <div
                        class="clearfix"
                        name="so_total_summary"
                    >

                        <div
                            id="total"
                            class="row"
                            name="total"
                        >

                            <div
                                t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto"
                            >

                                <table
                                    class="table table-sm table-borderless"
                                    style="background-color:#fff;"
                                >

                                    <t
                                        t-set="tax_totals"
                                        t-value="o.tax_totals"
                                    />

                                    <t
                                        t-foreach="tax_totals.get('subtotals')"
                                        t-as="subtotal"
                                    >

                                        <tr class="border-black o_subtotal">

                                            <td style="background-color:#fff;">
                                                <strong t-out="subtotal['name']">
                                                    Untaxed Amount
                                                </strong>
                                            </td>

                                            <td
                                                style="background-color:#fff;"
                                                class="text-end"
                                            >
                                                <span
                                                    t-att-class="oe_subtotal_footer_separator"
                                                    t-out="subtotal['formatted_amount']"
                                                >
                                                    27.00
                                                </span>
                                            </td>

                                        </tr>

                                        <t
                                            t-set="subtotal_to_show"
                                            t-value="subtotal['name']"
                                        />

                                        <t t-call="account.tax_groups_totals"/>

                                    </t>

                                    <tr
                                        t-if="'formatted_rounding_amount' in tax_totals and tax_totals.get('rounding_amount') != 0"
                                    >

                                        <td>Rounding</td>

                                        <td class="text-end">
                                            <span
                                                t-out="tax_totals.get('formatted_rounding_amount')"
                                            >
                                                0
                                            </span>
                                        </td>

                                    </tr>

                                    <tr class="border-black o_total">

                                        <td style="background-color:#fff;">
                                            <strong>Total</strong>
                                        </td>

                                        <td
                                            style="background-color:#fff;"
                                            class="text-end"
                                        >
                                            <span
                                                t-out="tax_totals.get('formatted_amount_total')"
                                            >
                                                31.05
                                            </span>
                                        </td>

                                    </tr>

                                </table>

                            </div>

                        </div>

                    </div>

                    <div
                        class="row pt-3 pb-2"
                        style="page-break-inside:avoid;"
                    >

                        <div class="col-8">
                            <p>
                                <span t-field="o.term_and_cond"/>
                            </p>
                        </div>

                    </div>

                    <hr/>

                    <div
                        class="row"
                        style="page-break-inside:avoid;"
                    >

                        <div
                            name="stamp"
                            class="col-4"
                        >

                            <img
                                t-if="o.company_id.stamp and o.display_stamp"
                                class="pt-5"
                                t-att-src="image_data_uri(o.company_id.stamp)"
                                style="max-height: 200px;"
                                alt="Stamp"
                            />

                        </div>

                        <div
                            name="signature"
                            class="col-4"
                        >

                            <img
                                t-if="o.company_id.signature and o.display_signature"
                                class="pt-5"
                                t-att-src="image_data_uri(o.company_id.signature)"
                                style="max-height: 200px;"
                                alt="Signature"
                            />

                        </div>

                    </div>

                    <div
                        class="row pt-3 pb-2"
                        style="page-break-inside:avoid;"
                    >

                        <div class="col-12">
                            <p>
                                <span t-field="o.bank_details"/>
                            </p>
                        </div>

                    </div>

                </t>

            </t>
        </t>
    </template>

</odoo>
