<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="invoice_training_details.NilTermsEditor">
        <div class="nil_terms_editor_pro">

            <div class="nil_terms_toolbar"
                 t-on-mousedown="onToolbarMouseDown">

                <div class="nil_toolbar_group">
                    <button type="button" title="Undo"
                            data-command="undo"
                            t-on-mousedown="execCommand">↶</button>
                    <button type="button" title="Redo"
                            data-command="redo"
                            t-on-mousedown="execCommand">↷</button>
                </div>

                <div class="nil_toolbar_group">
                    <select title="Paragraph style" t-on-change="setBlock">
                        <option value="">Style</option>
                        <option value="p">Paragraph</option>
                        <option value="h2">Heading 1</option>
                        <option value="h3">Heading 2</option>
                        <option value="h4">Heading 3</option>
                    </select>

                    <select title="Font size" t-on-change="setFontSize">
                        <option value="">Font size</option>
                        <option value="11px">11</option>
                        <option value="12px">12</option>
                        <option value="13px">13</option>
                        <option value="14px">14</option>
                        <option value="15px">15</option>
                        <option value="16px">16</option>
                        <option value="18px">18</option>
                        <option value="20px">20</option>
                        <option value="24px">24</option>
                    </select>

                    <select title="Line spacing" t-on-change="setLineHeight">
                        <option value="">Line spacing</option>
                        <option value="1">1.0</option>
                        <option value="1.15">1.15</option>
                        <option value="1.3">1.3</option>
                        <option value="1.5">1.5</option>
                        <option value="1.75">1.75</option>
                        <option value="2">2.0</option>
                    </select>

                    <select title="Paragraph spacing" t-on-change="setParagraphGap">
                        <option value="">Paragraph gap</option>
                        <option value="0">0 px</option>
                        <option value="4">4 px</option>
                        <option value="8">8 px</option>
                        <option value="12">12 px</option>
                        <option value="16">16 px</option>
                        <option value="24">24 px</option>
                    </select>
                </div>

                <div class="nil_toolbar_group">
                    <button type="button" data-command="bold"
                            t-on-mousedown="execCommand"><strong>B</strong></button>
                    <button type="button" data-command="italic"
                            t-on-mousedown="execCommand"><em>I</em></button>
                    <button type="button" data-command="underline"
                            t-on-mousedown="execCommand"><u>U</u></button>
                    <button type="button" data-command="strikeThrough"
                            t-on-mousedown="execCommand"><s>S</s></button>

                    <label class="nil_color_control" title="Text color">
                        A
                        <input type="color" value="#000000"
                               t-on-change="setTextColor"/>
                    </label>

                    <label class="nil_color_control nil_highlight_control" title="Highlight">
                        ▰
                        <input type="color" value="#fff2cc"
                               t-on-change="setHighlight"/>
                    </label>
                </div>

                <div class="nil_toolbar_group">
                    <button type="button" title="Align left"
                            data-command="justifyLeft"
                            t-on-mousedown="execCommand">⇤</button>
                    <button type="button" title="Center"
                            data-command="justifyCenter"
                            t-on-mousedown="execCommand">↔</button>
                    <button type="button" title="Align right"
                            data-command="justifyRight"
                            t-on-mousedown="execCommand">⇥</button>
                    <button type="button" title="Justify"
                            data-command="justifyFull"
                            t-on-mousedown="execCommand">☰</button>

                    <button type="button" title="Bulleted list"
                            data-command="insertUnorderedList"
                            t-on-mousedown="execCommand">• List</button>
                    <button type="button" title="Numbered list"
                            data-command="insertOrderedList"
                            t-on-mousedown="execCommand">1. List</button>
                    <button type="button" title="Outdent"
                            data-command="outdent"
                            t-on-mousedown="execCommand">←</button>
                    <button type="button" title="Indent"
                            data-command="indent"
                            t-on-mousedown="execCommand">→</button>

                    <select title="Left margin" t-on-change="setIndent">
                        <option value="">Margin</option>
                        <option value="0">0</option>
                        <option value="10">10 px</option>
                        <option value="20">20 px</option>
                        <option value="30">30 px</option>
                        <option value="40">40 px</option>
                    </select>
                </div>

                <div class="nil_toolbar_group nil_table_group">
                    <span class="nil_toolbar_caption">TABLE</span>

                    <select title="Insert table" t-on-change="insertTable">
                        <option value="">Insert</option>
                        <option value="2x2">2 × 2</option>
                        <option value="3x2">3 × 2</option>
                        <option value="3x3">3 × 3</option>
                        <option value="4x3">4 × 3</option>
                        <option value="4x4">4 × 4</option>
                        <option value="5x4">5 × 4</option>
                    </select>

                    <button type="button" title="Add row below"
                            t-on-mousedown.prevent="addRow">+ Row</button>
                    <button type="button" title="Delete current row"
                            t-on-mousedown.prevent="deleteRow">− Row</button>
                    <button type="button" title="Add column to the right"
                            t-on-mousedown.prevent="addColumn">+ Col</button>
                    <button type="button" title="Delete current column"
                            t-on-mousedown.prevent="deleteColumn">− Col</button>
                    <button type="button" title="Merge with cell on the right"
                            t-on-mousedown.prevent="mergeRight">Merge →</button>
                    <button type="button" title="Split merged cell"
                            t-on-mousedown.prevent="splitCell">Split</button>
                    <button type="button" title="Toggle header cell"
                            t-on-mousedown.prevent="toggleHeaderCell">TH/TD</button>

                    <select title="Cell padding" t-on-change="setCellPadding">
                        <option value="">Padding</option>
                        <option value="0">0 px</option>
                        <option value="4">4 px</option>
                        <option value="6">6 px</option>
                        <option value="8">8 px</option>
                        <option value="10">10 px</option>
                        <option value="12">12 px</option>
                        <option value="16">16 px</option>
                    </select>

                    <select title="Border width" t-on-change="setBorderWidth">
                        <option value="">Border</option>
                        <option value="0">None</option>
                        <option value="1">1 px</option>
                        <option value="2">2 px</option>
                        <option value="3">3 px</option>
                    </select>

                    <label class="nil_color_control" title="Current cell background">
                        Cell
                        <input type="color" value="#ffffff"
                               t-on-change="setCellBackground"/>
                    </label>

                    <select title="Cell vertical alignment" t-on-change="setCellVerticalAlign">
                        <option value="">V Align</option>
                        <option value="top">Top</option>
                        <option value="middle">Middle</option>
                        <option value="bottom">Bottom</option>
                    </select>

                    <select title="Table width" t-on-change="setTableWidth">
                        <option value="">Width</option>
                        <option value="50%">50%</option>
                        <option value="75%">75%</option>
                        <option value="100%">100%</option>
                    </select>

                    <select title="Table alignment" t-on-change="setTableAlign">
                        <option value="">Table align</option>
                        <option value="left">Left</option>
                        <option value="center">Center</option>
                        <option value="right">Right</option>
                    </select>
                </div>

                <div class="nil_toolbar_group">
                    <button type="button"
                            title="Remove text formatting"
                            t-on-mousedown.prevent="clearFormatting">
                        Clear formatting
                    </button>
                </div>
            </div>

            <div class="nil_terms_editor_surface"
                 contenteditable="true"
                 spellcheck="true"
                 t-ref="editor"
                 t-on-input="onEditorInput"
                 t-on-blur="onEditorBlur"
                 t-on-keyup="rememberSelection"
                 t-on-mouseup="rememberSelection">
            </div>

            <div class="nil_terms_hint">
                Table controls work on the cell where the cursor is placed.
            </div>
        </div>
    </t>
</templates>
