<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_am_pricing_form" model="ir.ui.view">
        <field name="name">am.pricing.form</field>
        <field name="model">am.pricing</field>
        <field name="arch" type="xml">
            <form string="AM Pricing" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="lead_id"/>
                            <field name="account_manager_id"/>
                            <field name="sent_by_id"/>
                            <field name="sent_at"/>
                        </group>
                        <group>
                            <field name="markup_pct" groups="base.group_system"/>
                            <field name="currency_id"/>
                            <field name="subtotal"/>
                            <field name="vat_amount"/>
                            <field name="total"/>
                        </group>
                    </group>

                    <separator string="Pricing Sent to Account Manager"/>

                    <field name="line_ids" nolabel="1">
                        <tree create="false" delete="false" edit="false">
                            <field name="training_name"/>
                            <field name="description" optional="show"/>
                            <field name="delivery_type"/>
                            <field name="students"/>
                            <field name="price_before_vat"/>
                            <field name="vat_rate"/>
                            <field name="vat_amount"/>
                            <field name="total"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_am_pricing_tree" model="ir.ui.view">
        <field name="name">am.pricing.tree</field>
        <field name="model">am.pricing</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false" edit="false">
                <field name="sent_at"/>
                <field name="account_manager_id"/>
                <field name="sent_by_id"/>
                <field name="markup_pct" groups="base.group_system"/>
                <field name="subtotal"/>
                <field name="vat_amount"/>
                <field name="total"/>
            </tree>
        </field>
    </record>

    <record id="view_am_pricing_wizard_form" model="ir.ui.view">
        <field name="name">am.pricing.wizard.form</field>
        <field name="model">am.pricing.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Pricing to Account Manager">
                <group>
                    <group>
                        <field name="lead_id"/>
                        <field name="account_manager_id"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group>
                        <field name="markup_pct"/>
                        <field name="currency_id"/>
                    </group>
                </group>

                <div class="alert alert-info" role="alert">
                    Select only the Cash trainings you want to send.
                    The Account Manager receives selling prices only. LCP costs are not included.
                </div>

                <field name="line_ids" nolabel="1">
                    <tree editable="bottom" create="false" delete="false">
                        <field name="selected"/>
                        <field name="training_name" readonly="1"/>
                        <field name="description" readonly="1" optional="show"/>
                        <field name="delivery_type" readonly="1"/>
                        <field name="students" readonly="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="cost_amount" column_invisible="1"/>
                        <field name="vat_rate" readonly="1"/>
                        <field name="price_before_vat" readonly="1"/>
                        <field name="vat_amount" readonly="1"/>
                        <field name="total" readonly="1"/>
                    </tree>
                </field>

                <group class="oe_subtotal_footer oe_right">
                    <field name="subtotal" readonly="1"/>
                    <field name="vat_amount" readonly="1"/>
                    <field name="total" readonly="1" class="oe_subtotal_footer_separator"/>
                </group>

                <footer>
                    <button name="action_send"
                            type="object"
                            string="Send to Account Manager"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="crm_lead_view_form_am_pricing" model="ir.ui.view">
        <field name="name">crm.lead.form.am.pricing</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="invoice_training_details.crm_lead_view_form_lcp_per_training"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_open_am_pricing_wizard"
                        type="object"
                        string="Send Pricing to AM"
                        class="oe_highlight"
                        groups="base.group_system"
                        invisible="not has_cash_training"/>
            </xpath>

            <xpath expr="//sheet/notebook" position="inside">
                <page string="AM Pricing" name="am_pricing">
                    <field name="am_pricing_ids" nolabel="1" readonly="1">
                        <tree create="false" delete="false" edit="false">
                            <field name="sent_at"/>
                            <field name="account_manager_id"/>
                            <field name="sent_by_id"/>
                            <field name="markup_pct" groups="base.group_system"/>
                            <field name="subtotal"/>
                            <field name="vat_amount"/>
                            <field name="total"/>
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
