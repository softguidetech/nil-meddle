<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_reveal_lead_opportunity_form_training" model="ir.ui.view">

        <field name="name">crm.lead.inherited.crm.training</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>

        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_new_purchase_order"
                        type="object"
                        string="New PO"
                        class="oe_highlight"
                        groups="purchase.group_purchase_user"
                        invisible="not has_cash_training"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_purchase_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        groups="purchase.group_purchase_user"
                        invisible="purchase_order_count == 0">
                    <field name="purchase_order_count"
                           widget="statinfo"
                           string="Purchase Orders"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="instructor_id"/>
                <field name="has_cash_training" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ordering_partner_id"/>
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="before">

                <!-- ===================================================== -->
                <!-- TRAINING -->
                <!-- ===================================================== -->

                <page id="training" name="Training">

                    <group>
                        <field name="training_name"/>
                    </group>

                    <field name="training_course_ids">

                        <tree editable="bottom">

                            <field name="training_id" width="15"/>

                            <field name="cost_clc" width="15"/>

                            <field name="location" width="15"/>

                            <field name="where_location2" width="15"/>

                            <field name="payment_method" width="10"/>

                            <field name="no_of_student" width="5"/>

                            <field name="duration" width="5"/>

                            <field name="training_date_start" width="10"/>

                            <field name="training_date_end" width="10"/>

                            <field name="price"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>

                        </tree>

                    </field>

                    <group>

                        <group>
                            <field name="total_training_price"/>
                        </group>

                    </group>

                </page>


                <!-- ===================================================== -->
                <!-- COST DETAILS -->
                <!-- ===================================================== -->

                <page id="clcs" name="Costs Details">

                    <group>

                        <button name="action_create_cost_line"
                                type="object"
                                string="Add Cost Line"
                                class="oe_highlight"/>

                    </group>


                    <field name="cost_details_ids" nolabel="1">

                        <tree editable="bottom">

                            <!-- Hidden helper used for EnterOne CLC condition -->
                            <field name="is_clc"
                                   column_invisible="1"/>


                            <!-- Learning Partner -->
                            <field name="learning_partner"
                                   string="Learning Partner"
                                   width="140"/>


                            <!-- Logistics -->
                            <field name="total_price_all"
                                   string="Logistics Cost"
                                   width="120"
                                   readonly="1"/>


                            <!-- Instructor -->
                            <field name="ins_time"
                                   string="Instructor"
                                   width="110"/>


                            <!-- Total Costs -->
                            <field name="margin1"
                                   string="Total Costs"
                                   width="120"
                                   readonly="1"/>


                            <!-- NIL ME Share -->
                            <field name="nilme_share"
                                   string="NIL ME Share $"
                                   width="130"
                                   readonly="1"/>


                            <!-- Partner Share -->
                            <field name="training_vendor"
                                   string="Partner Share"
                                   width="120"
                                   readonly="learning_partner == 'EnterOne' and is_clc"
                                   force_save="1"/>


                            <!-- Margin -->
                            <field name="margin"
                                   string="Margin (%)"
                                   widget="percentage"
                                   width="100"
                                   readonly="1"/>


                            <!-- Sales Commission -->
                            <field name="sales_commission"
                                   string="Sales Commission (5%)"
                                   width="150"
                                   readonly="1"/>

                        </tree>

                    </field>

                </page>


                <!-- ===================================================== -->
                <!-- PROFESSIONAL SERVICES -->
                <!-- ===================================================== -->

                <page id="pro" name="Professional Services">

                    <group>
                        <field name="ordering_partner_id"/>
                    </group>

                    <field name="pro_service_ids">

                        <tree editable="bottom">

                            <field name="training_id"/>

                            <field name="end_customer_id"/>

                            <field name="cisco_am"/>

                            <field name="con_per"/>

                            <field name="duration"/>

                            <field name="training_date_end"/>

                            <field name="price"/>

                        </tree>

                    </field>

                    <group>

                        <group>
                            <field name="total_service_price"/>
                        </group>

                    </group>

                </page>


                <!-- ===================================================== -->
                <!-- EXTRA INFORMATION -->
                <!-- ===================================================== -->

                <page id="extra_information" string="Extra Information">

                    <group>

                        <group>

                            <field name="clcs_qty"/>

                            <field name="tr_expiry_date"/>

                            <field name="poref"/>

                            <field name="invref"/>

                        </group>

                    </group>

                </page>


                <!-- ===================================================== -->
                <!-- LOGISTICS -->
                <!-- ===================================================== -->

                <page id="logistics" string="Logistics">

                    <group>

                        <field name="ctrng"/>

                        <field name="venue"/>

                        <field name="uber"/>

                    </group>


                    <field name="ticket_ids">

                        <tree editable="bottom">

                            <field name="airline_id"/>

                            <field name="origin_id"/>

                            <field name="destination_id"/>

                            <field name="date"/>

                            <field name="duration"/>

                            <field name="time_from"
                                   widget="timesheet_uom"/>

                            <field name="time_to"
                                   widget="timesheet_uom"/>

                            <field name="stop"/>

                            <field name="class_type_id"/>

                            <field name="currency_id"/>

                            <field name="price"/>

                        </tree>

                    </field>


                    <field name="hotel_ids">

                        <tree editable="bottom">

                            <field name="hotel_id"/>

                            <field name="date_from"/>

                            <field name="date_to"/>

                            <field name="nights"/>

                            <field name="location"/>

                            <field name="pax"/>

                            <field name="des"/>

                            <field name="room_type"/>

                            <field name="currency_id"/>

                            <field name="price_without_tax"/>

                            <field name="tax"/>

                            <field name="price"/>

                        </tree>

                    </field>


                    <group string="Visa Details">

                        <field name="visa"/>

                        <field name="start_date"/>

                        <field name="to_date"/>

                        <field name="book_details_id"
                               widget="many2many_binary"/>

                        <field name="details"/>

                        <field name="cost"/>

                    </group>


                    <group>

                        <field name="total_price_all"/>

                    </group>

                </page>

            </xpath>


            <!-- ========================================================= -->
            <!-- EXPECTED REVENUE IN USD -->
            <!-- ========================================================= -->

            <xpath expr="//field[@name='expected_revenue']"
                   position="attributes">

                <attribute name="widget">monetary</attribute>

                <attribute name="options">
                    {'currency_field': 'currency_id'}
                </attribute>

            </xpath>


            <xpath expr="//field[@name='expected_revenue']"
                   position="after">

                <field name="currency_id"
                       invisible="1"/>

            </xpath>

        </field>

    </record>

    <record id="purchase_order_form_crm_opportunity_link" model="ir.ui.view">
        <field name="name">purchase.order.form.crm.opportunity.link</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="crm_lead_id" readonly="1"/>
                <field name="end_customer_id" readonly="1"/>
                <field name="is_training_order" invisible="1"/>
            </xpath>

            <xpath expr="//page[@name='products']" position="after">
                <page string="Training Details"
                      name="training_details"
                      invisible="not is_training_order">
                    <field name="training_course_ids" readonly="1">
                        <tree>
                            <field name="training_id"/>
                            <field name="no_of_student"/>
                            <field name="duration"/>
                            <field name="training_date_start"/>
                            <field name="training_date_end"/>
                            <field name="location"/>
                            <field name="where_location2"/>
                            <field name="payment_method"/>
                            <field name="price"/>
                            <field name="instructor_id"/>
                            <field name="descriptions"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="account_move_form_crm_opportunity_link" model="ir.ui.view">
        <field name="name">account.move.form.crm.opportunity.link</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="crm_lead_id" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
