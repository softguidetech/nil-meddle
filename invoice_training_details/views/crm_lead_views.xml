<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_reveal_lead_opportunity_form_training" model="ir.ui.view">

        <field name="name">crm.lead.inherited.crm.training</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>

        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_new_purchase_order"
                        type="object"
                        string="New PO"
                        class="oe_highlight"
                        groups="purchase.group_purchase_user"
                        invisible="not has_cash_training"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_purchase_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        groups="purchase.group_purchase_user"
                        invisible="purchase_order_count == 0">
                    <field name="purchase_order_count"
                           widget="statinfo"
                           string="Purchase Orders"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="instructor_id"/>
                <field name="has_cash_training" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ordering_partner_id"/>
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="before">

                <!-- ===================================================== -->
                <!-- TRAINING -->
                <!-- ===================================================== -->

                <page id="training" name="Training">

                    <group>
                        <field name="training_name"/>
                    </group>

                    <field name="training_course_ids">

                        <tree editable="bottom">

                            <field name="training_id" width="15"/>

                            <field name="cost_clc" width="15"/>

                            <field name="location" width="15"/>

                            <field name="where_location2" width="15"/>

                            <field name="payment_method" width="10"/>

                            <field name="no_of_student" width="5"/>

                            <field name="duration" width="5"/>

                            <field name="training_date_start" width="10"/>

                            <field name="training_date_end" width="10"/>

                            <field name="price"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>

                        </tree>

                    </field>

                    <group>

                        <group>
                            <field name="total_training_price"/>
                        </group>

                    </group>

                </page>


                <!-- ===================================================== -->
                <!-- COST DETAILS -->
                <!-- ===================================================== -->

                <page id="clcs" name="Costs Details">

                    <group>

                        <button name="action_create_cost_line"
                                type="object"
                                string="Add Cost Line"
                                class="oe_highlight"/>

                    </group>


                    <field name="cost_details_ids" nolabel="1">

                        <tree editable="bottom">

                            <!-- Hidden helper used for EnterOne CLC condition -->
                            <field name="is_clc"
                                   column_invisible="1"/>


                            <!-- Learning Partner -->
                            <field name="learning_partner"
                                   string="Learning Partner"
                                   width="140"/>


                            <!-- Logistics -->
                            <field name="total_price_all"
                                   string="Logistics Cost"
                                   width="120"
                                   readonly="1"/>


                            <!-- Instructor -->
                            <field name="ins_time"
                                   string="Instructor"
                                   width="110"/>


                            <!-- Total Costs -->
                            <field name="margin1"
                                   string="Total Costs"
                                   width="120"
                                   readonly="1"/>


                            <!-- NIL ME Share -->
                            <field name="nilme_share"
                                   string="NIL ME Share $"
                                   width="130"
                                   readonly="1"/>


                            <!-- Partner Share -->
                            <field name="training_vendor"
                                   string="Partner Share"
                                   width="120"
                                   readonly="learning_partner == 'EnterOne' and is_clc"
                                   force_save="1"/>


                            <!-- Margin -->
                            <field name="margin"
                                   string="Margin (%)"
                                   widget="percentage"
                                   width="100"
                                   readonly="1"/>


                            <!-- Sales Commission -->
                            <field name="sales_commission"
                                   string="Sales Commission (5%)"
                                   width="150"
                                   readonly="1"/>

                        </tree>

                    </field>

                </page>


                <!-- ===================================================== -->
                <!-- PROFESSIONAL SERVICES -->
                <!-- ===================================================== -->

                <page id="pro" name="Professional Services">

                    <group>
                        <field name="ordering_partner_id"/>
                    </group>

                    <field name="pro_service_ids">

                        <tree editable="bottom">

                            <field name="training_id"/>

                            <field name="end_customer_id"/>

                            <field name="cisco_am"/>

                            <field name="con_per"/>

                            <field name="duration"/>

                            <field name="training_date_end"/>

                            <field name="price"/>

                        </tree>

                    </field>

                    <group>

                        <group>
                            <field name="total_service_price"/>
                        </group>

                    </group>

                </page>


                <!-- ===================================================== -->
                <!-- EXTRA INFORMATION -->
                <!-- ===================================================== -->

                <page id="extra_information" string="Extra Information">

                    <group>

                        <group>

                            <field name="clcs_qty"/>

                            <field name="tr_expiry_date"/>

                            <field name="poref"/>

                            <field name="invref"/>

                        </group>

                    </group>

                </page>


                <!-- ===================================================== -->
                <!-- LOGISTICS -->
                <!-- ===================================================== -->

                <page id="logistics" string="Logistics">

                    <group>

                        <field name="ctrng"/>

                        <field name="venue"/>

                        <field name="uber"/>

                    </group>


                    <field name="ticket_ids">

                        <tree editable="bottom">

                            <field name="airline_id"/>

                            <field name="origin_id"/>

                            <field name="destination_id"/>

                            <field name="date"/>

                            <field name="duration"/>

                            <field name="time_from"
                                   widget="timesheet_uom"/>

                            <field name="time_to"
                                   widget="timesheet_uom"/>

                            <field name="stop"/>

                            <field name="class_type_id"/>

                            <field name="currency_id"/>

                            <field name="price"/>

                        </tree>

                    </field>


                    <field name="hotel_ids">

                        <tree editable="bottom">

                            <field name="hotel_id"/>

                            <field name="date_from"/>

                            <field name="date_to"/>

                            <field name="nights"/>

                            <field name="location"/>

                            <field name="pax"/>

                            <field name="des"/>

                            <field name="room_type"/>

                            <field name="currency_id"/>

                            <field name="price_without_tax"/>

                            <field name="tax"/>

                            <field name="price"/>

                        </tree>

                    </field>


                    <group string="Visa Details">

                        <field name="visa"/>

                        <field name="start_date"/>

                        <field name="to_date"/>

                        <field name="book_details_id"
                               widget="many2many_binary"/>

                        <field name="details"/>

                        <field name="cost"/>

                    </group>


                    <group>

                        <field name="total_price_all"/>

                    </group>

                </page>

            </xpath>


            <!-- ========================================================= -->
            <!-- EXPECTED REVENUE IN USD -->
            <!-- ========================================================= -->

            <xpath expr="//field[@name='expected_revenue']"
                   position="attributes">

                <attribute name="widget">monetary</attribute>

                <attribute name="options">
                    {'currency_field': 'currency_id'}
                </attribute>

            </xpath>


            <xpath expr="//field[@name='expected_revenue']"
                   position="after">

                <field name="currency_id"
                       invisible="1"/>

            </xpath>

        </field>

    </record>

    <record id="purchase_order_form_crm_opportunity_link" model="ir.ui.view">
        <field name="name">purchase.order.form.crm.opportunity.link</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="crm_lead_id" readonly="1"/>
                <field name="end_customer_id" readonly="1"/>
                <field name="is_training_order" invisible="1"/>
            </xpath>

            <xpath expr="//sheet/notebook" position="inside">
                <page string="Training"
                      name="training"
                      invisible="not is_training_order">
                    <field name="training_course_ids">
                        <tree editable="bottom">
                            <field name="training_id"/>
                            <field name="descriptions"/>
                            <field name="cost_clc"/>
                            <field name="hyperlink"/>
                            <field name="instructor_id"/>
                            <field name="location"/>
                            <field name="where_location2"/>
                            <field name="payment_method"/>
                            <field name="no_of_student"/>
                            <field name="duration"/>
                            <field name="training_date_start"/>
                            <field name="training_date_end"/>
                            <field name="price"/>
                        </tree>
                    </field>

                    <group string="Terms and Conditions">
                        <field name="term_and_cond"
                               nolabel="1"
                               colspan="2"/>
                    </group>

                    <group>
                        <group string="Report PDF Element Display">
                            <field name="display_training_table"/>
                            <field name="display_signature"/>
                            <field name="display_stamp"/>
                        </group>

                        <group string="Column Display">
                            <field name="display_description"/>
                            <field name="display_instructor"/>
                            <field name="display_location"/>
                            <field name="display_where"/>
                            <field name="display_total"/>
                            <field name="display_downpayment"/>
                            <field name="display_due_amount"/>
                        </group>
                    </group>

                    <group invisible="not display_downpayment and not display_due_amount">
                        <field name="half_advance_payment_before"
                               invisible="not display_downpayment"/>
                        <field name="half_payment_after"
                               invisible="not display_due_amount"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="account_move_form_crm_opportunity_link" model="ir.ui.view">
        <field name="name">account.move.form.crm.opportunity.link</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="crm_lead_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <template id="purchase_training_print_block">
        <t t-if="o.is_training_order">
            <style>
                table[name="purchase_training_line_table"] thead th {
                    background-color: #EAF9FC !important;
                    color: #075E68 !important;
                }
                .purchase-training-text,
                .purchase-training-text * {
                    font-size: 16px !important;
                    font-family: inherit !important;
                }
            </style>

            <div style="height: 30px;"/>

            <div t-if="o.end_customer_id" style="margin-bottom: 10px;">
                <strong>End Customer: </strong>
                <span t-field="o.end_customer_id"/>
            </div>

            <table t-if="o.display_training_table and o.training_course_ids"
                   class="table table-sm o_main_table table-bordered text-center"
                   name="purchase_training_line_table">
                <thead>
                    <tr>
                        <th style="text-align: center; vertical-align: middle;">
                            <span>Item</span>
                        </th>
                        <th style="text-align: center; vertical-align: middle;">
                            <span>Training Name</span>
                        </th>
                        <th t-if="o.display_description"
                            style="text-align: center; vertical-align: middle;">
                            <span>Description</span>
                        </th>
                        <th t-if="o.display_instructor"
                            style="text-align: center; vertical-align: middle;">
                            <span>Instructor Name</span>
                        </th>
                        <th style="text-align: center; vertical-align: middle;">
                            <span># Of Students</span>
                        </th>
                        <th t-if="o.display_location or o.display_where"
                            style="text-align: center; vertical-align: middle;">
                            <span>Location</span>
                        </th>
                        <th style="text-align: center; vertical-align: middle;">
                            <span>Duration</span>
                        </th>
                        <th style="text-align: center; vertical-align: middle;">
                            <span>Training Dates</span>
                        </th>
                        <th style="text-align: center; vertical-align: middle;">
                            <span>Training Price</span>
                        </th>
                        <th t-if="o.display_total"
                            style="text-align: center; vertical-align: middle;">
                            <span>Total Price</span>
                        </th>
                        <th t-if="o.display_downpayment"
                            style="text-align: center; vertical-align: middle;">
                            <span>Advance Payment</span>
                        </th>
                        <th t-if="o.display_due_amount"
                            style="text-align: center; vertical-align: middle;">
                            <span>Due Amount</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="item" t-value="1"/>
                    <t t-set="total_rows" t-value="len(o.training_course_ids)"/>

                    <tr t-foreach="o.training_course_ids" t-as="training">
                        <td style="text-align: center; vertical-align: middle;">
                            <span t-esc="item"/>
                        </td>
                        <td style="text-align: left; vertical-align: middle;">
                            <span t-field="training.training_id"/>
                        </td>
                        <td t-if="o.display_description"
                            style="text-align: left; vertical-align: middle;">
                            <span t-field="training.descriptions"/>
                        </td>
                        <td t-if="o.display_instructor"
                            style="text-align: center; vertical-align: middle;">
                            <span t-field="training.instructor_id"/>
                        </td>
                        <td style="text-align: center; vertical-align: middle;">
                            <span t-field="training.no_of_student"/>
                        </td>
                        <td t-if="o.display_location or o.display_where"
                            style="text-align: center; vertical-align: middle;">
                            <span t-if="o.display_location"
                                  t-field="training.location"/>
                            <span t-if="o.display_location and o.display_where">, </span>
                            <span t-if="o.display_where"
                                  t-field="training.where_location2"/>
                        </td>
                        <td style="text-align: center; vertical-align: middle;">
                            <span t-field="training.duration"/>
                        </td>
                        <td style="text-align: center; vertical-align: middle;">
                            <span t-field="training.training_date_start"/>
                            <span> - </span>
                            <span t-field="training.training_date_end"/>
                        </td>
                        <td style="text-align: center; vertical-align: middle;">
                            <span t-field="training.price"/>
                        </td>
                        <t t-if="item == 1">
                            <td t-if="o.display_total"
                                t-att-rowspan="total_rows"
                                style="text-align: center; vertical-align: middle;">
                                <span t-field="o.total_training_price"/>
                            </td>
                            <td t-if="o.display_downpayment"
                                t-att-rowspan="total_rows"
                                style="text-align: center; vertical-align: middle;">
                                <span t-field="o.half_advance_payment_before"/>
                            </td>
                            <td t-if="o.display_due_amount"
                                t-att-rowspan="total_rows"
                                style="text-align: center; vertical-align: middle;">
                                <span t-field="o.half_payment_after"/>
                            </td>
                        </t>
                        <t t-set="item" t-value="item + 1"/>
                    </tr>
                </tbody>
            </table>

            <div class="row pt-3 pb-2"
                 t-if="o.term_and_cond"
                 style="page-break-inside: avoid;">
                <div class="col-8 purchase-training-text"
                     style="width: 600px;">
                    <div t-field="o.term_and_cond"
                         style="text-align: justify; margin: 0;"/>
                </div>
            </div>

            <div t-if="(o.company_id.stamp and o.display_stamp) or (o.company_id.signature and o.display_signature)"
                 class="row"
                 style="page-break-inside: avoid; position: relative; min-height: 170px;">
                <div style="position: absolute; bottom: 0; right: 0; text-align: right; white-space: nowrap;">
                    <img t-if="o.company_id.signature and o.display_signature"
                         t-att-src="image_data_uri(o.company_id.signature)"
                         style="max-height: 120px; max-width: 180px; width: auto; height: auto; object-fit: contain; vertical-align: bottom; display: inline-block; margin-right: 8px;"
                         alt="Signature"/>
                    <img t-if="o.company_id.stamp and o.display_stamp"
                         t-att-src="image_data_uri(o.company_id.stamp)"
                         style="max-height: 135px; max-width: 165px; width: auto; height: auto; object-fit: contain; vertical-align: bottom; display: inline-block;"
                         alt="Stamp"/>
                </div>
            </div>
        </t>
    </template>

    <template id="purchase_order_training_print"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="invoice_training_details.purchase_training_print_block"/>
        </xpath>
    </template>

    <template id="purchase_rfq_training_print"
              inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="invoice_training_details.purchase_training_print_block"/>
        </xpath>
    </template>

</odoo>
