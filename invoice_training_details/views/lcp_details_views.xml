<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Keep old child-form XML IDs safe for database upgrades. -->
    <record id="view_training_course_lcp_form" model="ir.ui.view">
        <field name="name">training.course.lcp.form</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <form string="Training Reference" create="false" delete="false">
                <sheet>
                    <group>
                        <field name="training_id" readonly="1"/>
                        <field name="no_of_student" readonly="1"/>
                        <field name="duration" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_training_course_lcp_input_form" model="ir.ui.view">
        <field name="name">
            training.course.lcp.input.form
        </field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <form string="Training Reference" create="false" delete="false">
                <sheet>
                    <group>
                        <field name="training_id" readonly="1"/>
                        <field name="no_of_student" readonly="1"/>
                        <field name="duration" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="crm_lead_view_form_lcp_details" model="ir.ui.view">

        <field name="name">
            crm.lead.form.lcp.details
        </field>

        <field name="model">crm.lead</field>

        <field name="inherit_id" ref="crm.crm_lead_view_form"/>

        <field name="arch" type="xml">

            <xpath expr="//page[@name='internal_notes']" position="before">

                <page name="lcp_details" string="LCP Details" class="o_lcp_dashboard">

                    <div class="o_lcp_hero">
        <div class="o_lcp_hero_icon">
            <i class="fa fa-line-chart"/>
        </div>
        <div>
            <div class="o_lcp_hero_title">LCP Financial Overview</div>
            <div class="o_lcp_hero_subtitle">
                Pricing, delivery costs and profitability in one place
            </div>
        </div>
    </div>

    <div class="o_lcp_section_header">
        <div>
            <span class="o_lcp_section_kicker">SETUP</span>
            <div class="o_lcp_section_name">Pricing &amp; Delivery Inputs</div>
        </div>
    </div>

    <div class="o_lcp_input_grid">

        <div class="o_lcp_input_card o_lcp_input_commercial">
            <div class="o_lcp_input_card_header">
                <span class="o_lcp_icon_box"><i class="fa fa-briefcase"/></span>
                <div>
                    <div class="o_lcp_input_card_title">Commercial</div>
                    <div class="o_lcp_input_card_hint">Partner and payment setup</div>
                </div>
            </div>

            <div class="o_lcp_field_row">
                <div class="o_lcp_field_label">Learning Partner</div>
                <field name="lcp_cost_learning_partner" readonly="1" nolabel="1" class="o_lcp_field_control"/>
            </div>

            <div class="o_lcp_field_row" invisible="lcp_payment_method != 'clc'">
                <div class="o_lcp_field_label">SO#</div>
                <field name="so_no" nolabel="1" class="o_lcp_field_control"/>
            </div>

            <div class="o_lcp_field_row">
                <div class="o_lcp_field_label">Payment Method</div>
                <field name="lcp_payment_method" readonly="1" nolabel="1" class="o_lcp_field_control o_lcp_payment_badge"/>
            </div>
        </div>

        <div class="o_lcp_input_card o_lcp_input_pricing">
            <div class="o_lcp_input_card_header">
                <span class="o_lcp_icon_box"><i class="fa fa-usd"/></span>
                <div>
                    <div class="o_lcp_input_card_title">Training Pricing</div>
                    <div class="o_lcp_input_card_hint">Revenue and seat pricing</div>
                </div>
            </div>

            <field name="currency_id" invisible="1"/>

            <div class="o_lcp_field_row o_lcp_revenue_row">
                <div class="o_lcp_field_label">Training Value</div>
                <field name="total_training_price" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" nolabel="1" class="o_lcp_field_control o_lcp_big_value"/>
            </div>

            <div class="o_lcp_field_row">
                <div class="o_lcp_field_label">VAT %</div>
                <field name="lcp_vat_rate" nolabel="1" class="o_lcp_field_control"/>
            </div>

            <div class="o_lcp_field_row" invisible="lcp_payment_method != 'clc'">
                <div class="o_lcp_field_label">CLCs / Seat</div>
                <field name="lcp_clcs_per_seat" nolabel="1" class="o_lcp_field_control"/>
            </div>

            <div class="o_lcp_field_row" invisible="lcp_payment_method != 'cash'">
                <div class="o_lcp_field_label">USD / Seat</div>
                <field name="lcp_clcs_per_seat" nolabel="1" class="o_lcp_field_control"/>
            </div>

            <div class="o_lcp_field_row" invisible="lcp_payment_method != 'clc'">
                <div class="o_lcp_field_label">Rate Card / Seat</div>
                <field name="lcp_rate_card_per_seat" nolabel="1" class="o_lcp_field_control"/>
            </div>
        </div>

        <div class="o_lcp_input_card o_lcp_input_instructor">
            <div class="o_lcp_input_card_header">
                <span class="o_lcp_icon_box"><i class="fa fa-user"/></span>
                <div>
                    <div class="o_lcp_input_card_title">Instructor</div>
                    <div class="o_lcp_input_card_hint">Source, trainer and delivery cost</div>
                </div>
            </div>

            <div class="o_lcp_field_row">
                <div class="o_lcp_field_label">Instructor From</div>
                <field name="lcp_instructor_source" nolabel="1" class="o_lcp_field_control"/>
            </div>

            <div class="o_lcp_field_row">
                <div class="o_lcp_field_label">Instructor</div>
                <field name="instructor_id" nolabel="1" class="o_lcp_field_control"/>
            </div>

            <div class="o_lcp_field_row" invisible="lcp_instructor_source != 'nil_me'">
                <div class="o_lcp_field_label">Instructor Rate</div>
                <field name="lcp_instructor_md_rate" nolabel="1" class="o_lcp_field_control"/>
            </div>

            <div class="o_lcp_field_row" invisible="lcp_instructor_source != 'vendor'">
                <div class="o_lcp_field_label">Vendor Instructor / Day</div>
                <field name="lcp_vendor_instructor_day" nolabel="1" class="o_lcp_field_control"/>
            </div>
        </div>

        <div class="o_lcp_input_card o_lcp_input_onsite">
            <div class="o_lcp_input_card_header">
                <span class="o_lcp_icon_box"><i class="fa fa-map-marker"/></span>
                <div>
                    <div class="o_lcp_input_card_title">On-site Costs</div>
                    <div class="o_lcp_input_card_hint">Travel and local delivery inputs</div>
                </div>
            </div>

            <div class="o_lcp_field_row" invisible="lcp_is_online">
                <div class="o_lcp_field_label">Uber / Day</div>
                <field name="lcp_uber_day_rate" nolabel="1" class="o_lcp_field_control"/>
            </div>

            <div class="o_lcp_field_row" invisible="lcp_instructor_source != 'nil_me'">
                <div class="o_lcp_field_label">Per Diem / Day</div>
                <field name="lcp_per_diem_rate" nolabel="1" class="o_lcp_field_control"/>
            </div>

            <div class="o_lcp_field_row" invisible="lcp_instructor_source != 'nil_me'">
                <div class="o_lcp_field_label">Per Diem Days</div>
                <field name="lcp_per_diem_days" nolabel="1" class="o_lcp_field_control"/>
            </div>

            <div class="o_lcp_field_row" invisible="lcp_is_online">
                <div class="o_lcp_field_label">Venue</div>
                <field name="venue" nolabel="1" class="o_lcp_field_control"/>
            </div>

            <div class="o_lcp_field_row" invisible="lcp_is_online">
                <div class="o_lcp_field_label">Catering</div>
                <field name="ctrng" nolabel="1" class="o_lcp_field_control"/>
            </div>

            <div class="o_lcp_online_note" invisible="not lcp_is_online">
                <i class="fa fa-globe"/>
                Online training: on-site logistics are hidden.
            </div>
        </div>
    </div>

    <div class="o_lcp_section_header o_lcp_summary_heading">
        <div>
            <span class="o_lcp_section_kicker">RESULTS</span>
            <div class="o_lcp_section_name">LCP Summary</div>
        </div>
    </div>

    <div class="o_lcp_summary_grid">

        <div class="o_lcp_summary_card o_lcp_card_training">
            <div class="o_lcp_summary_header">
                <span class="o_lcp_summary_icon"><i class="fa fa-graduation-cap"/></span>
                <div>
                    <div class="o_lcp_summary_title">Training Totals</div>
                    <div class="o_lcp_summary_note">Course delivery metrics</div>
                </div>
            </div>

            <div class="o_lcp_summary_line">
                <span>Total Training Days</span>
                <strong><field name="lcp_total_days" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_line">
                <span>Total Seats</span>
                <strong><field name="lcp_total_seats" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_line o_lcp_metric_accent" invisible="lcp_payment_method != 'clc'">
                <span>Total CLCs + VAT</span>
                <strong><field name="lcp_total_clcs_with_vat" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_line" invisible="lcp_payment_method != 'clc'">
                <span>Total Rate Card</span>
                <strong><field name="lcp_total_rate_card" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_line" invisible="lcp_instructor_source != 'nil_me'">
                <span>Total Instructor Cost</span>
                <strong><field name="lcp_total_instructor_md" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_line" invisible="lcp_instructor_source != 'nil_me'">
                <span>Total Per Diem</span>
                <strong><field name="lcp_total_per_diem" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_line" invisible="lcp_instructor_source != 'vendor'">
                <span>Vendor Instructor / Day</span>
                <strong><field name="lcp_vendor_instructor_day" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_line" invisible="lcp_instructor_source != 'vendor'">
                <span>Total Vendor Instructor</span>
                <strong><field name="lcp_total_vendor_instructor" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_line" invisible="lcp_is_online">
                <span>Uber Logistics (Days + 2)</span>
                <strong><field name="lcp_total_uber_estimate" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>
        </div>

        <div class="o_lcp_summary_card o_lcp_card_logistics" invisible="lcp_is_online">
            <div class="o_lcp_summary_header">
                <span class="o_lcp_summary_icon"><i class="fa fa-plane"/></span>
                <div>
                    <div class="o_lcp_summary_title">Logistics</div>
                    <div class="o_lcp_summary_note">Actual delivery expenses</div>
                </div>
            </div>

            <div class="o_lcp_summary_line">
                <span>Tickets</span>
                <strong><field name="lcp_ticket_total" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_line">
                <span>Hotels</span>
                <strong><field name="lcp_hotel_total" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_line">
                <span>Venue</span>
                <strong><field name="venue" nolabel="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_line">
                <span>Catering</span>
                <strong><field name="ctrng" nolabel="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_line">
                <span>Uber</span>
                <strong><field name="uber" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>
        </div>

        <div class="o_lcp_summary_card o_lcp_card_profit">
            <div class="o_lcp_summary_header">
                <span class="o_lcp_summary_icon"><i class="fa fa-pie-chart"/></span>
                <div>
                    <div class="o_lcp_summary_title">Profitability</div>
                    <div class="o_lcp_summary_note">Partner share and NIL ME result</div>
                </div>
            </div>

            <div class="o_lcp_summary_line">
                <span>Learning Partner</span>
                <strong><field name="lcp_cost_learning_partner" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_line">
                <span>Partner Share</span>
                <strong><field name="lcp_partner_share" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_line o_lcp_cost_row">
                <span>Total Costs</span>
                <strong><field name="lcp_total_costs" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_divider"/>

            <div class="o_lcp_summary_line o_lcp_profit_row">
                <span>NIL ME Profit</span>
                <strong><field name="lcp_nilme_profit" nolabel="1" readonly="1" class="oe_inline"/></strong>
            </div>

            <div class="o_lcp_summary_line o_lcp_margin_row">
                <span>Profit Margin</span>
                <strong>
                    <field name="lcp_profit_margin" nolabel="1" readonly="1" widget="percentage" class="oe_inline"/>
                </strong>
            </div>
        </div>

    </div>
<field name="lcp_cost_detail_count" invisible="1"/>

                    <field name="lcp_is_online" invisible="1"/>

                    <field name="lcp_has_onsite" invisible="1"/>

                </page>

            </xpath>

        </field>

    </record>

</odoo>
