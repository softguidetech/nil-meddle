<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_view_form_lcp_details" model="ir.ui.view">
        <field name="name">crm.lead.form.lcp.details</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>

        <field name="arch" type="xml">

            <xpath expr="//page[@name='internal_notes']"
                   position="before">

                <page name="lcp_details"
                      string="LCP Details">

                    <!-- ================================================= -->
                    <!-- 1. PRICING SETUP -->
                    <!-- ================================================= -->

                    <separator string="1. Pricing Setup"/>

                    <group col="3">

                        <group>
                            <field name="ordering_partner_id"
                                   string="Ordering Partner"/>

                            <field name="learnig_partner"
                                   string="Learning Partner"/>

                            <field name="so_no"
                                   string="SO#"/>
                        </group>

                        <group>
                            <field name="currency_id"
                                   invisible="1"/>

                            <field name="total_training_price"
                                   string="Training Value"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>

                            <field name="lcp_vat_rate"/>

                            <field name="lcp_instructor_source"/>

                            <field name="instructor_id"
                                   string="Instructor"/>
                        </group>

                        <group>
                            <field name="lcp_uber_day_rate"/>

                            <field name="lcp_per_diem_rate"/>

                            <field name="venue"/>

                            <field name="ctrng"
                                   string="Catering"/>
                        </group>

                    </group>


                    <!-- ================================================= -->
                    <!-- 2. LCP SUMMARY -->
                    <!-- ================================================= -->

                    <separator string="2. LCP Summary"/>

                    <div class="row g-3 mt-1 mb-3">

                        <!-- Training Totals -->
                        <div class="col-12 col-lg-4">

                            <div class="border rounded p-3 h-100">

                                <div class="fw-bold fs-5 mb-3">
                                    A. Training Totals
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Total Training Days</span>
                                    <strong>
                                        <field name="lcp_total_days"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Total Seats</span>
                                    <strong>
                                        <field name="lcp_total_seats"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Total CLCs + VAT</span>
                                    <strong>
                                        <field name="lcp_total_clcs_with_vat"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Total Rate Card</span>
                                    <strong>
                                        <field name="lcp_total_rate_card"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Instructor Cost</span>
                                    <strong>
                                        <field name="lcp_total_instructor_cost"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Per Diem</span>
                                    <strong>
                                        <field name="lcp_total_per_diem"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <span>Uber Logistics (Days + 2)</span>
                                    <strong>
                                        <field name="lcp_total_uber_estimate"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                            </div>

                        </div>


                        <!-- Existing Logistics -->
                        <div class="col-12 col-lg-4">

                            <div class="border rounded p-3 h-100">

                                <div class="fw-bold fs-5 mb-3">
                                    B. Existing Logistics
                                </div>

                                <div class="text-muted small mb-3">
                                    Pulled directly from the existing CRM Lead.
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Tickets</span>
                                    <strong>
                                        <field name="lcp_ticket_total"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Hotels</span>
                                    <strong>
                                        <field name="lcp_hotel_total"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Venue</span>
                                    <strong>
                                        <field name="venue"
                                               nolabel="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Catering</span>
                                    <strong>
                                        <field name="ctrng"
                                               nolabel="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <span>Uber (Auto-updated)</span>
                                    <strong>
                                        <field name="uber"
                                               nolabel="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                            </div>

                        </div>


                        <!-- Cost Details Result -->
                        <div class="col-12 col-lg-4">

                            <div class="border rounded p-3 h-100">

                                <div class="fw-bold fs-5 mb-3">
                                    C. Cost Details Result
                                </div>

                                <div class="text-muted small mb-3">
                                    Current result from the existing Cost Details engine.
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Learning Partner</span>
                                    <strong>
                                        <field name="lcp_cost_learning_partner"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Partner Share</span>
                                    <strong>
                                        <field name="lcp_partner_share"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Total Costs</span>
                                    <strong>
                                        <field name="lcp_total_costs"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <hr/>

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-bold">
                                        NIL ME Profit
                                    </span>
                                    <strong class="fs-5">
                                        <field name="lcp_nilme_profit"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <span class="fw-bold">
                                        Profit Margin
                                    </span>
                                    <strong class="fs-5">
                                        <field name="lcp_profit_margin"
                                               nolabel="1"
                                               readonly="1"
                                               widget="percentage"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="alert alert-warning mt-2"
                         role="alert"
                         invisible="lcp_cost_detail_count &lt;= 1">

                        This Lead has more than one Cost Details line.
                        LCP mirrors the first Cost Details result so the
                        existing lead-level logistics are not duplicated.

                    </div>

                    <field name="lcp_cost_detail_count"
                           invisible="1"/>

                </page>

            </xpath>

        </field>

    </record>

</odoo>
