<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- EXISTING TRAINING LINE: LCP INPUT FORM -->
    <!-- No course creation. Used only when clicking an existing card. -->
    <!-- ========================================================= -->

    <record id="view_training_course_lcp_input_form"
            model="ir.ui.view">

        <field name="name">
            training.course.lcp.input.form
        </field>

        <field name="model">
            training.course
        </field>

        <field name="arch"
               type="xml">

            <form string="LCP Cost Inputs"
                  create="false"
                  delete="false">

                <sheet>

                    <group string="Training Reference">

                        <group>
                            <field name="training_id"
                                   readonly="1"/>

                            <field name="payment_method"
                                   readonly="1"/>

                            <field name="location"
                                   readonly="1"/>
                        </group>

                        <group>
                            <field name="lcp_days"
                                   readonly="1"/>

                            <field name="no_of_student"
                                   string="Seats"
                                   readonly="1"/>

                            <field name="clcs_qty"
                                   string="CLCs / Seat"
                                   readonly="payment_method != 'clc'"/>
                        </group>

                    </group>

                    <group string="Cost Inputs">

                        <group>
                            <field name="lcp_currency_id"
                                   invisible="1"/>

                            <field name="lcp_rate_card"/>
                        </group>

                        <group>
                            <field name="lcp_instructor_rate_day"/>
                        </group>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- CRM LEAD: LCP DETAILS -->
    <!-- ========================================================= -->

    <record id="crm_lead_view_form_lcp_details"
            model="ir.ui.view">

        <field name="name">
            crm.lead.form.lcp.details
        </field>

        <field name="model">
            crm.lead
        </field>

        <field name="inherit_id"
               ref="crm.crm_lead_view_form"/>

        <field name="arch"
               type="xml">

            <xpath expr="//page[@name='internal_notes']"
                   position="before">

                <page name="lcp_details"
                      string="LCP Details">

                    <!-- ============================================= -->
                    <!-- 1. PRICING SETUP -->
                    <!-- ============================================= -->

                    <separator string="1. Pricing Setup"/>

                    <group col="3">

                        <group>
                            <field name="ordering_partner_id"
                                   string="Ordering Partner"/>

                            <field name="learnig_partner"
                                   string="Learning Partner"/>

                            <field name="so_no"
                                   string="SO#"/>
                        </group>

                        <group>
                            <field name="currency_id"
                                   invisible="1"/>

                            <field name="total_training_price"
                                   string="Training Value"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>

                            <field name="lcp_vat_rate"/>

                            <field name="lcp_instructor_source"/>

                            <field name="instructor_id"
                                   string="Instructor"/>
                        </group>

                        <group>
                            <field name="lcp_uber_day_rate"/>

                            <field name="lcp_per_diem_rate"/>

                            <field name="venue"/>

                            <field name="ctrng"
                                   string="Catering"/>
                        </group>

                    </group>


                    <!-- ============================================= -->
                    <!-- 2. COURSE COST INPUTS -->
                    <!-- Existing Training lines only. No Add/Delete. -->
                    <!-- ============================================= -->

                    <separator string="2. Course Cost Inputs"/>

                    <field name="training_course_ids"
                           mode="kanban"
                           nolabel="1"
                           class="o_lcp_input_cards"
                           context="{
                               'form_view_ref':
                               'invoice_training_details.view_training_course_lcp_input_form'
                           }">

                        <kanban create="false"
                                delete="false"
                                quick_create="false"
                                records_draggable="false">

                            <field name="training_id"/>
                            <field name="payment_method"/>
                            <field name="location"/>
                            <field name="lcp_days"/>
                            <field name="no_of_student"/>
                            <field name="clcs_qty"/>
                            <field name="lcp_currency_id"/>
                            <field name="lcp_rate_card"/>
                            <field name="lcp_instructor_rate_day"/>

                            <templates>

                                <t t-name="kanban-box">

                                    <div class="oe_kanban_global_click o_lcp_input_card">

                                        <div class="d-flex justify-content-between align-items-start mb-2">

                                            <div>
                                                <div class="fw-bold fs-5">
                                                    <field name="training_id"/>
                                                </div>

                                                <div class="text-muted small mt-1">
                                                    Click to enter costing inputs
                                                </div>
                                            </div>

                                            <div class="text-end">
                                                <span class="badge rounded-pill text-bg-light me-1">
                                                    <field name="payment_method"/>
                                                </span>

                                                <span class="badge rounded-pill text-bg-light">
                                                    <field name="location"/>
                                                </span>
                                            </div>

                                        </div>

                                        <div class="o_lcp_card_values">

                                            <div class="o_lcp_value_box">
                                                <span>Days</span>
                                                <strong>
                                                    <field name="lcp_days"/>
                                                </strong>
                                            </div>

                                            <div class="o_lcp_value_box">
                                                <span>Seats</span>
                                                <strong>
                                                    <field name="no_of_student"/>
                                                </strong>
                                            </div>

                                            <t t-if="record.payment_method.raw_value == 'clc'">
                                                <div class="o_lcp_value_box">
                                                    <span>CLCs / Seat</span>
                                                    <strong>
                                                        <field name="clcs_qty"/>
                                                    </strong>
                                                </div>
                                            </t>

                                            <div class="o_lcp_value_box">
                                                <span>Rate Card / Seat</span>
                                                <strong>
                                                    <field name="lcp_rate_card"/>
                                                </strong>
                                            </div>

                                            <div class="o_lcp_value_box">
                                                <span>Instructor / Day</span>
                                                <strong>
                                                    <field name="lcp_instructor_rate_day"/>
                                                </strong>
                                            </div>

                                        </div>

                                    </div>

                                </t>

                            </templates>

                        </kanban>

                    </field>


                    <!-- ============================================= -->
                    <!-- 3. LCP SUMMARY -->
                    <!-- ============================================= -->

                    <separator string="3. LCP Summary"/>

                    <div class="row g-3 mt-1 mb-3">

                        <!-- TRAINING TOTALS -->
                        <div class="col-12 col-lg-4">

                            <div class="border rounded p-3 h-100">

                                <div class="fw-bold fs-5 mb-3">
                                    Training Totals
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Total Training Days</span>
                                    <strong>
                                        <field name="lcp_total_days"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Total Seats</span>
                                    <strong>
                                        <field name="lcp_total_seats"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Total CLCs + VAT</span>
                                    <strong>
                                        <field name="lcp_total_clcs_with_vat"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Total Rate Card</span>
                                    <strong>
                                        <field name="lcp_total_rate_card"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Instructor Cost</span>
                                    <strong>
                                        <field name="lcp_total_instructor_cost"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Per Diem</span>
                                    <strong>
                                        <field name="lcp_total_per_diem"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <span>Uber Logistics</span>
                                    <strong>
                                        <field name="lcp_total_uber_estimate"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                            </div>

                        </div>


                        <!-- LOGISTICS -->
                        <div class="col-12 col-lg-4">

                            <div class="border rounded p-3 h-100">

                                <div class="fw-bold fs-5 mb-3">
                                    Logistics
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Tickets</span>
                                    <strong>
                                        <field name="lcp_ticket_total"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Hotels</span>
                                    <strong>
                                        <field name="lcp_hotel_total"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Venue</span>
                                    <strong>
                                        <field name="venue"
                                               nolabel="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Catering</span>
                                    <strong>
                                        <field name="ctrng"
                                               nolabel="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <span>Uber</span>
                                    <strong>
                                        <field name="uber"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                            </div>

                        </div>


                        <!-- PROFIT -->
                        <div class="col-12 col-lg-4">

                            <div class="border rounded p-3 h-100">

                                <div class="fw-bold fs-5 mb-3">
                                    Profit Margin
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Learning Partner</span>
                                    <strong>
                                        <field name="lcp_cost_learning_partner"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Partner Share</span>
                                    <strong>
                                        <field name="lcp_partner_share"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Total Costs</span>
                                    <strong>
                                        <field name="lcp_total_costs"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <hr/>

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-bold">
                                        NIL ME Profit
                                    </span>

                                    <strong class="fs-5">
                                        <field name="lcp_nilme_profit"
                                               nolabel="1"
                                               readonly="1"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <span class="fw-bold">
                                        Profit Margin
                                    </span>

                                    <strong class="fs-5">
                                        <field name="lcp_profit_margin"
                                               nolabel="1"
                                               readonly="1"
                                               widget="percentage"
                                               class="oe_inline"/>
                                    </strong>
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="alert alert-warning mt-2"
                         role="alert"
                         invisible="lcp_cost_detail_count &lt;= 1">

                        This Lead has more than one Cost Details line.
                        LCP mirrors the first Cost Details result so the
                        existing lead-level costs are not duplicated.

                    </div>

                    <field name="lcp_cost_detail_count"
                           invisible="1"/>

                </page>

            </xpath>

        </field>

    </record>

</odoo>
