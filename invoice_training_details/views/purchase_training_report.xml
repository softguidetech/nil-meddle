<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--
        TRAINING PURCHASE ORDER PRINT
        - Applies ONLY to purchase.report_purchaseorder_document
        - Training PO uses the SAME custom layout used by the quotation report
        - Normal/non-training POs keep the original Odoo Purchase Order report
        - No RFQ / Sales / Quotation templates are modified
    -->

    <template id="purchase_order_training_report_only"
              inherit_id="purchase.report_purchaseorder_document">

        <!--
            For a training PO, do not render the native Odoo Purchase layout/body.
            For every normal PO, leave the native report untouched.
        -->
        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-if">not o.is_training_order</attribute>
        </xpath>

        <!--
            Training PO: render with exactly the same custom external layout
            used by reports/report_quotation.xml
        -->
        <xpath expr="//t[@t-call='web.external_layout']" position="after">

            <t t-if="o.is_training_order"
               t-call="invoice_training_details.custom_invoice_report_layout">

                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>

                <t t-set="vendor_partner"
                   t-value="o.partner_id if o.partner_id.is_company else (o.partner_id.parent_id or o.partner_id)"/>

                <t t-set="is_clc_order"
                   t-value="'clc' in [(method or '').lower() for method in o.training_course_ids.mapped('payment_method')]"/>

                <t t-set="is_cisco_u_all_access"
                   t-value="'Cisco U All Access' in o.training_course_ids.mapped('training_id.name')"/>

                <style>
                    /* Compact visual proportions matching the reference PO */
                    table[name="training_line_table"] {
                        width: 100%;
                        border-collapse: collapse;
                        margin-top: 8px;
                        margin-bottom: 0;
                    }

                    table[name="training_line_table"] thead th {
                        background-color: #D9F4FA !important;
                        color: #075E68 !important;
                        border: 1px solid #9DDDE7 !important;
                        text-align: center !important;
                        vertical-align: middle !important;
                        font-size: 12px !important;
                        font-weight: 700 !important;
                        line-height: 1.2 !important;
                        padding: 5px 4px !important;
                    }

                    table[name="training_line_table"] td {
                        border: 1px solid #D3E8EC !important;
                        text-align: center !important;
                        vertical-align: middle !important;
                        font-size: 12px !important;
                        line-height: 1.25 !important;
                        padding: 5px 4px !important;
                    }

                    .purchase-training-text,
                    .purchase-training-text * {
                        font-size: 13px !important;
                        font-family: inherit !important;
                        line-height: 1.35 !important;
                    }

                    .purchase-vendor-block,
                    .purchase-vendor-block * {
                        font-size: 13px !important;
                        line-height: 1.35 !important;
                    }

                    .purchase-meta,
                    .purchase-meta td {
                        font-size: 13px !important;
                        line-height: 1.35 !important;
                    }

                    /* Move the corporate footer visually down for this report only */
                    .footer.o_standard_footer {
                        transform: translateY(22mm) !important;
                    }
                </style>


                <!-- ===================================================== -->
                <!-- TITLE - SAME STYLE AS QUOTATION                      -->
                <!-- ===================================================== -->

                <div class="row" style="margin:0 0 4px 0; padding:0;">
                    <div class="col-12"
                         style="margin:0; padding-top:0; padding-bottom:0;">

                        <span style="display:block; margin:0; padding:0; font-size:24px; font-weight:600; color:#0DCAF0;">

                            <t t-if="is_clc_order">Work Order</t>
                            <t t-else="">Purchase Order</t>

                        </span>

                    </div>
                </div>


                <!-- ===================================================== -->
                <!-- VENDOR DETAILS + PO DETAILS                          -->
                <!-- SAME STRUCTURE AS QUOTATION PRINT                    -->
                <!-- ===================================================== -->

                <div class="row"
                     style="margin-top:14px; padding-top:0; padding-bottom:8px;">

                    <!-- VENDOR -->
                    <div class="col-8 purchase-vendor-block">
                        <div>

                            <div style="margin:0 0 1px 0;">
                                <strong>Company Name:</strong>
                            </div>
                            <div style="margin:0 0 4px 0;">
                                <span t-field="vendor_partner.name"/>
                            </div>

                            <div style="margin:0 0 1px 0;">
                                <strong>Address:</strong>
                            </div>
                            <div style="margin:0 0 1px 0;">
                                <span t-if="vendor_partner.street"
                                      t-field="vendor_partner.street"/>
                                <t t-if="vendor_partner.street2">
                                    <t t-if="vendor_partner.street">, </t>
                                    <span t-field="vendor_partner.street2"/>
                                </t>
                            </div>
                            <div style="margin:0 0 3px 0;">
                                <span t-if="vendor_partner.city"
                                      t-field="vendor_partner.city"/>
                                <t t-if="vendor_partner.state_id">
                                    <t t-if="vendor_partner.city">, </t>
                                    <span t-field="vendor_partner.state_id.name"/>
                                </t>
                                <t t-if="vendor_partner.zip">
                                    <t t-if="vendor_partner.city or vendor_partner.state_id"> </t>
                                    <span t-field="vendor_partner.zip"/>
                                </t>
                                <t t-if="vendor_partner.country_id">
                                    <t t-if="vendor_partner.city or vendor_partner.state_id or vendor_partner.zip">, </t>
                                    <span t-field="vendor_partner.country_id.name"/>
                                </t>
                            </div>

                            <div t-if="o.partner_id.email or vendor_partner.email"
                                 style="margin:0 0 3px 0;">
                                <strong>Email:</strong>
                                <span t-if="o.partner_id.email"
                                      t-field="o.partner_id.email"/>
                                <span t-else=""
                                      t-field="vendor_partner.email"/>
                            </div>

                            <div t-if="vendor_partner.vat"
                                 style="margin:0 0 3px 0;">
                                <strong>Tax Number:</strong>
                                <span t-field="vendor_partner.vat"/>
                            </div>

                            <div t-if="not o.partner_id.is_company"
                                 style="margin:0 0 3px 0;">
                                <strong>Attention:</strong>
                                <span t-field="o.partner_id.name"/>
                            </div>

                        </div>
                    </div>

                    <!-- PO INFORMATION -->
                    <div class="col-4 purchase-meta">
                        <table class="table table-borderless"
                               style="margin:0; width:100%;">

                            <tr class="p-0">
                                <td class="p-0"
                                    style="vertical-align:middle; width:52%;">
                                    <span t-if="is_clc_order">Work Order</span>
                                    <span t-else="">Purchase Order</span>
                                </td>
                                <td class="p-0"
                                    style="vertical-align:middle;">
                                    <span t-if="is_clc_order"
                                          t-esc="o.name.replace('PO-', 'WO-', 1) if o.name.startswith('PO-') else ('WO-' + o.name if not o.name.startswith('WO-') else o.name)"/>
                                    <span t-else=""
                                          t-field="o.name"/>
                                </td>
                            </tr>

                            <tr class="p-0">
                                <td class="p-0"
                                    style="vertical-align:middle;">
                                    Date
                                </td>
                                <td class="p-0"
                                    style="vertical-align:middle;">
                                    <span t-field="o.date_order"/>
                                </td>
                            </tr>

                        </table>
                    </div>

                </div>
                <!-- Compact spacing before training table -->
                <div style="height:6px;"></div>


                <!-- ===================================================== -->
                <!-- TRAINING TABLE ONLY                                   -->
                <!-- NO PURCHASE ORDER PRODUCT / ORDER LINES               -->
                <!-- ===================================================== -->

                <table t-if="o.display_training_table and o.training_course_ids"
                       class="table table-sm o_main_table table-bordered text-center"
                       name="training_line_table">

                    <thead>
                        <tr>

                            <th name="th_item">
                                <span>Item</span>
                            </th>

                            <th name="th_training_name">
                                <span t-if="is_cisco_u_all_access">
                                    Subscription Name
                                </span>
                                <span t-else="">
                                    Training Name
                                </span>
                            </th>

                            <th t-if="o.display_description"
                                name="th_description">
                                <span>Description</span>
                            </th>

                            <th t-if="o.display_instructor"
                                name="th_instructor">
                                <span>Instructor Name</span>
                            </th>

                            <th name="th_students">
                                <span t-if="is_cisco_u_all_access">
                                    # Of Subscriptions
                                </span>
                                <span t-else="">
                                    # Of Students
                                </span>
                            </th>

                            <th t-if="not is_cisco_u_all_access and (o.display_location or o.display_where)"
                                name="th_location">
                                <span>Location</span>
                            </th>

                            <th t-if="not is_cisco_u_all_access"
                                name="th_duration">
                                <span>Duration</span>
                            </th>

                            <th t-if="not is_cisco_u_all_access"
                                name="th_training_dates">
                                <span>Training Dates</span>
                            </th>
<th t-if="o.display_downpayment"
                                name="th_advance_payment">
                                <span>Advance Payment</span>
                            </th>

                            <th t-if="o.display_due_amount"
                                name="th_due_amount">
                                <span>Due Amount</span>
                            </th>

                        </tr>
                    </thead>


                    <tbody>

                        <t t-set="item" t-value="1"/>
                        <t t-set="total_rows" t-value="len(o.training_course_ids)"/>

                        <t t-foreach="o.training_course_ids"
                           t-as="training">

                            <tr>

                                <td>
                                    <span t-esc="item"/>
                                </td>


                                <!-- TRAINING / SUBSCRIPTION NAME -->
                                <td style="text-align:left !important;">

                                    <a t-if="training.hyperlink"
                                       t-att-href="training.hyperlink"
                                       style="color:inherit; text-decoration:none;">

                                        <span t-field="training.training_id"/>

                                    </a>

                                    <span t-else=""
                                          t-field="training.training_id"/>

                                </td>


                                <!-- DESCRIPTION -->
                                <td t-if="o.display_description"
                                    style="text-align:left !important;">
                                    <span t-field="training.descriptions"/>
                                </td>


                                <!-- INSTRUCTOR -->
                                <td t-if="o.display_instructor">
                                    <span t-field="training.instructor_id.name"/>
                                </td>


                                <!-- STUDENTS / SUBSCRIPTIONS -->
                                <td>
                                    <span t-field="training.no_of_student"/>
                                </td>


                                <!-- LOCATION -->
                                <td t-if="not is_cisco_u_all_access and (o.display_location or o.display_where)">

                                    <span t-if="o.display_location"
                                          t-field="training.location"/>

                                    <span t-if="o.display_location and o.display_where and training.location and training.where_location2">
                                        ,
                                    </span>

                                    <span t-if="o.display_where"
                                          t-field="training.where_location2"/>

                                </td>


                                <!-- DURATION -->
                                <td t-if="not is_cisco_u_all_access">
                                    <span t-field="training.duration"/>
                                </td>


                                <!-- TRAINING DATES -->
                                <td t-if="not is_cisco_u_all_access">

                                    <span t-field="training.training_date_start"/>

                                    <span t-if="training.training_date_start and training.training_date_end">
                                        -
                                    </span>

                                    <span t-field="training.training_date_end"/>

                                </td>


                                <!-- ROW-SPANNED SELECTED TOTALS -->
                                <t t-if="item == 1">
<td t-if="o.display_downpayment"
                                        t-att-rowspan="total_rows">
                                        <span t-field="o.half_advance_payment_before"/>
                                    </td>

                                    <td t-if="o.display_due_amount"
                                        t-att-rowspan="total_rows">
                                        <span t-field="o.half_payment_after"/>
                                    </td>

                                </t>

                            </tr>

                            <t t-set="item" t-value="item + 1"/>

                        </t>

                    </tbody>

                </table>


                <!-- ===================================================== -->
                <!-- TOTAL / END CUSTOMER / TERMS                          -->
                <!-- ===================================================== -->

                <div t-if="o.display_total"
                     style="
                        margin-top:6px;
                        display:flex;
                        justify-content:flex-end;
                        page-break-inside:avoid;
                     ">

                    <table class="table table-sm"
                           style="
                                width:270px;
                                margin:0;
                                border-collapse:collapse;
                           ">
                        <tr>
                            <td style="
                                border:1px solid #D3E8EC;
                                font-size:13px;
                                font-weight:600;
                                padding:5px 7px;
                                background:#fff;
                            ">
                                <span t-if="is_clc_order">NIL ME Invoice Amount</span>
                                <span t-else="">Partner Invoice Amount</span>
                            </td>
                            <td style="
                                border:1px solid #D3E8EC;
                                font-size:13px;
                                text-align:right;
                                white-space:nowrap;
                                padding:5px 7px;
                                background:#fff;
                            ">
                                <span t-field="o.total_training_price"/>
                            </td>
                        </tr>
                    </table>

                </div>


                <div t-if="o.end_customer_id"
                     class="purchase-training-text"
                     style="margin:10px 0 0 0;">

                    <strong>End Customer:</strong>
                    <span t-field="o.end_customer_id"/>

                </div>


                <!-- Terms are always shown directly after the content above -->
                <div class="purchase-training-text"
                     style="
                        margin-top:14px;
                        padding:0;
                        page-break-inside:avoid;
                        width:100%;
                     ">

                    <div style="font-weight:700; margin:0 0 4px 0;">
                        Terms &amp; Conditions:
                    </div>

                    <div t-if="o.term_and_cond"
                         t-field="o.term_and_cond"
                         style="
                            width:100%;
                            text-align:justify;
                            margin:0;
                            padding:0;
                         "/>

                </div>


                <!-- ===================================================== -->
                <!-- SIGNATURE + STAMP - SAME POSITION AS QUOTATION       -->
                <!-- ===================================================== -->

                <div t-if="(o.company_id.stamp and o.display_stamp) or (o.company_id.signature and o.display_signature)"
                     class="row"
                     style="
                        page-break-inside:avoid;
                        position:relative;
                        min-height:245px;
                        margin-top:10px;
                     ">

                    <div style="
                        position:absolute;
                        bottom:0;
                        right:0;
                        text-align:right;
                        white-space:nowrap;
                     ">

                        <img t-if="o.company_id.signature and o.display_signature"
                             t-att-src="image_data_uri(o.company_id.signature)"
                             style="
                                max-height:120px;
                                max-width:180px;
                                width:auto;
                                height:auto;
                                object-fit:contain;
                                vertical-align:bottom;
                                display:inline-block;
                                margin-right:8px;
                             "
                             alt="Signature"/>

                        <img t-if="o.company_id.stamp and o.display_stamp"
                             t-att-src="image_data_uri(o.company_id.stamp)"
                             style="
                                max-height:135px;
                                max-width:165px;
                                width:auto;
                                height:auto;
                                object-fit:contain;
                                vertical-align:bottom;
                                display:inline-block;
                             "
                             alt="Stamp"/>

                    </div>

                </div>

            </t>

        </xpath>

    </template>

</odoo>
