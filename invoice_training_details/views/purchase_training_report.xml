<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="purchase_order_training_report_only"
              inherit_id="purchase.report_purchaseorder_document">
        <!-- Entirely independent manual PO rendering. It inherits only the
             proven web.external_layout node, never fragile stock header XPaths.
             The original CRM and training reports stay as they were. -->
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <t t-if="not o.is_training_order and not o.crm_lead_id"
               t-call="invoice_training_details.custom_invoice_report_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <t t-set="address" t-value="False"/>
                <t t-set="information_block" t-value="False"/>
                <div class="page nil-manual-purchase-page">
                    <style type="text/css">
                        .nil-manual-purchase-page {
                            font-family: Arial, Helvetica, sans-serif !important;
                            font-size: 16px !important;
                            line-height: 1.4 !important;
                        }
                        .nil-manual-purchase-page .nil-manual-po-title {
                            margin: 2px 0 20px 0 !important;
                            color: #0DCAF0 !important;
                            font-size: 30px !important;
                            font-weight: 700 !important;
                        }
                        .nil-manual-purchase-page .nil-manual-po-partner {
                            margin: 0 0 15px 0 !important;
                            font-size: 16px !important;
                        }
                        .nil-manual-purchase-page .nil-manual-po-meta {
                            width: 100% !important;
                            border-collapse: collapse !important;
                            margin: 0 !important;
                        }
                        .nil-manual-purchase-page .nil-manual-po-meta td {
                            background:#fff !important;
                            padding: 2px 3px !important;
                            border: 0 !important;
                            font-size: 16px !important;
                            vertical-align: top !important;
                        }
                        .nil-manual-purchase-page .nil-manual-po-meta td:last-child {
                            text-align:right !important;
                            white-space: nowrap !important;
                        }
                        .nil-manual-purchase-page table.nil-manual-po-products {
                            display: table !important;
                            width:100% !important;
                            min-width:100% !important;
                            max-width:100% !important;
                            table-layout:fixed !important;
                            border-collapse:collapse !important;
                        }
                        .nil-manual-purchase-page table.nil-manual-po-products thead th,
                        .nil-manual-purchase-page table.nil-manual-po-products thead th * {
                            background:#D9F4FA !important;
                            color:#075E68 !important;
                            font-size:16px !important;
                            font-weight:700 !important;
                        }
                        .nil-manual-purchase-page table.nil-manual-po-products td,
                        .nil-manual-purchase-page table.nil-manual-po-products td * {
                            font-size:16px !important;
                            line-height:1.35 !important;
                        }
                        .nil-manual-purchase-page table.nil-manual-po-products th {
                            background:#D9F4FA !important;
                            border:1px solid #9DDDE7 !important;
                            padding:7px 5px !important;
                            text-align:center !important;
                            vertical-align:middle !important;
                            word-wrap:break-word;
                        }
                        .nil-manual-purchase-page table.nil-manual-po-products td {
                            background:#fff !important;
                            border:1px solid #CFE5EA !important;
                            padding:7px 5px !important;
                            vertical-align:middle !important;
                            overflow-wrap:break-word;
                            word-wrap:break-word;
                        }
                        .nil-manual-purchase-page table.nil-manual-po-products td#product {
                            text-align:left !important;
                            white-space:normal !important;
                        }
                        .nil-manual-purchase-page table.nil-manual-po-products tbody tr {
                            page-break-inside: avoid !important;
                        }
                        .nil-manual-purchase-page table.nil-manual-po-totals tr,
                        .nil-manual-purchase-page table.nil-manual-po-totals td,
                        .nil-manual-purchase-page table.nil-manual-po-totals td *,
                        .nil-manual-purchase-page table.nil-manual-po-totals th,
                        .nil-manual-purchase-page table.nil-manual-po-totals th * {
                            background:#fff !important;
                            background-color:#fff !important;
                            font-size:16px !important;
                        }
                        .nil-manual-purchase-page table.nil-manual-po-totals td,
                        .nil-manual-purchase-page table.nil-manual-po-totals th {
                            border:1px solid #CFE5EA !important;
                            padding:6px 9px !important;
                        }
                        .nil-manual-purchase-page table.nil-manual-po-totals td:last-child {
                            text-align:right !important;
                            font-weight:700 !important;
                        }
                    </style>
                    <h2 class="nil-manual-po-title">
                        <t t-if="o.state in ['draft', 'sent', 'to approve']">Request for Quotation</t>
                        <t t-elif="o.state in ['purchase', 'done']">Purchase Order</t>
                        <t t-else="">Cancelled Purchase Order</t>
                    </h2>
                    <div class="row nil-manual-po-partner" style="page-break-inside:avoid;">
                        <div class="col-8" style="padding-left:0;">
                            <div><strong>Company Name:</strong></div>
                            <div t-if="o.partner_id.is_company" t-field="o.partner_id.name"/>
                            <div t-else="" t-field="o.partner_id.parent_id.name"/>
                            <div style="margin-top:6px;"><strong>Address:</strong></div>
                            <div t-field="o.partner_id"
                                 t-options='{"widget":"contact","fields":["address","phone","vat"],"no_marker":True,"phone_icons":False}'/>
                            <div t-if="not o.partner_id.is_company">
                                <strong>Attention:</strong> <span t-field="o.partner_id.name"/>
                            </div>
                            <div t-if="o.partner_id.email">
                                <strong>Email:</strong> <span t-field="o.partner_id.email"/>
                            </div>
                            <div t-if="o.dest_address_id">
                                <strong>Shipping address:</strong>
                                <span t-field="o.dest_address_id"
                                      t-options='{"widget":"contact","fields":["address","name","phone"],"no_marker":True}'/>
                            </div>
                        </div>
                        <div class="col-4" style="padding-right:0;">
                            <table class="nil-manual-po-meta table table-borderless">
                                <tr><td>Purchase Order</td><td><span t-field="o.name"/></td></tr>
                                <tr t-if="o.state in ['purchase', 'done'] and o.date_approve">
                                    <td>Date</td><td><span t-field="o.date_approve" t-options='{"widget":"date","format":"dd/MM/yy"}'/></td>
                                </tr>
                                <tr t-elif="o.date_order">
                                    <td>Date</td><td><span t-field="o.date_order" t-options='{"widget":"date","format":"dd/MM/yy"}'/></td>
                                </tr>
                                <tr t-if="o.partner_ref">
                                    <td>Reference</td><td><span t-field="o.partner_ref"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <table class="nil-manual-po-products table table-sm table-bordered" name="nil_manual_purchase_items" style="width:100% !important; min-width:100% !important; max-width:100% !important; table-layout:fixed !important; border-collapse:collapse !important; margin-top:12px; margin-bottom:0;">
                                    <colgroup>
                                        <col style="width:35%;"/>
                                        <col style="width:13%;"/>
                                        <col style="width:9%;"/>
                                        <col style="width:12%;"/>
                                        <col style="width:7%;"/>
                                        <col style="width:10%;"/>
                                        <col style="width:14%;"/>
                                    </colgroup>
                                    <thead style="display:table-header-group;">
                                        <tr>
                                            <th name="th_description"><strong>Description</strong></th>
                                            <th name="th_date_req" class="text-center"><strong>Date Req.</strong></th>
                                            <th name="th_quantity" class="text-end"><strong>Qty</strong></th>
                                            <th name="th_price_unit" class="text-end"><strong>Unit Price</strong></th>
                                            <th name="th_discount" class="text-end"><strong>Disc.</strong></th>
                                            <th name="th_taxes" class="text-end"><strong>Taxes</strong></th>
                                            <th name="th_subtotal" class="text-end">
                                                <strong>Amount</strong>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="current_subtotal" t-value="0"/>
                                        <t t-foreach="o.order_line" t-as="line">
                                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                    
                                            <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                                <t t-if="not line.display_type">
                                                    <td id="product">
                                                        <span t-field="line.name"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-field="line.date_planned"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-field="line.product_qty"/>
                                                        <span t-field="line.product_uom.name" groups="uom.group_uom"/>
                                                        <span t-if="line.product_packaging_id">
                                                            (<span t-field="line.product_packaging_qty" t-options='{"widget": "integer"}'/> <span t-field="line.product_packaging_id"/>)
                                                        </span>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-field="line.price_unit"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <span class="text-align-bottom"><span t-field="line.discount"/>%</span>
                                                    </td>
                                                    <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.taxes_id])"/>
                                                    <td name="td_taxes" t-attf-class="text-end {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                                        <span t-out="taxes">Tax 15%</span>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-field="line.price_subtotal"
                                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                </t>
                                                <t t-if="line.display_type == 'line_section'">
                                                    <td colspan="99" id="section">
                                                        <span t-field="line.name"/>
                                                    </td>
                                                    <t t-set="current_section" t-value="line"/>
                                                    <t t-set="current_subtotal" t-value="0"/>
                                                </t>
                                                <t t-if="line.display_type == 'line_note'">
                                                    <td colspan="99" id="note">
                                                        <span t-field="line.name"/>
                                                    </td>
                                                </t>
                                            </tr>
                                            <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type == 'line_section')">
                                                <tr class="is-subtotal text-end">
                                                    <td colspan="99" id="subtotal">
                                                        <strong class="mr16">Subtotal</strong>
                                                        <span
                                                            t-esc="current_subtotal"
                                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                        />
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                    <tfoot style="display:table-row-group;">
                                        <tr class="nil-manual-po-total-row" style="page-break-inside:avoid;">
                                            <td colspan="7" style="background:#fff !important; border:1px solid #CFE5EA !important; padding:0 !important;">
                                                <table class="nil-manual-po-totals" align="right"
                                                       style="width:42% !important; min-width:265px !important; max-width:100% !important; border-collapse:collapse !important; margin:0 !important; float:right;">
                                                    <t t-set="tax_totals" t-value="o.tax_totals"/>
                                                    <t t-call="purchase.document_tax_totals"/>
                                                </table>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                    <div t-if="o.notes" style="margin-top:20px; font-size:16px;">
                        <p t-field="o.notes"/>
                    </div>
                </div>
            </t>
        </xpath>
        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-if">not o.is_training_order and o.crm_lead_id</attribute>
            <attribute name="t-call">invoice_training_details.custom_invoice_report_layout</attribute>
        </xpath>

        <xpath expr="//t[@t-call='invoice_training_details.custom_invoice_report_layout']" position="after">
            <t t-if="o.is_training_order"
               t-call="invoice_training_details.custom_invoice_report_layout">

                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <t t-set="vendor_partner"
                   t-value="o.partner_id if o.partner_id.is_company else (o.partner_id.parent_id or o.partner_id)"/>
                <t t-set="is_instructor_po" t-value="o.po_training_type == 'instructor'"/>
                <t t-set="is_clc_order"
                   t-value="not is_instructor_po and 'clc' in [(m or '').lower() for m in o.training_course_ids.mapped('payment_method')]"/>
                <t t-set="is_cisco_u_all_access"
                   t-value="not is_instructor_po and any('cisco u' in (name or '').lower() for name in o.training_course_ids.mapped('training_id.name'))"/>

                <style>
                    .po-vendor-info, .po-vendor-info * {font-size:16px !important; line-height:1.45 !important;}
                    .po-meta, .po-meta td {font-size:16px !important; line-height:1.45 !important;}
                    .po-text, .po-text * {font-size:15px !important; line-height:1.5 !important;}
                    table[name="training_line_table"], table[name="instructor_line_table"] {
                        width:100%; border-collapse:collapse; margin-top:10px; margin-bottom:0;
                    }
                    table[name="training_line_table"] th, table[name="instructor_line_table"] th {
                        background-color:#D9F4FA !important; color:#075E68 !important;
                        border:1px solid #9DDDE7 !important; text-align:center !important;
                        vertical-align:middle !important; font-size:15px !important;
                        font-weight:700 !important; line-height:1.35 !important; padding:8px 6px !important;
                    }
                    table[name="training_line_table"] td, table[name="instructor_line_table"] td {
                        border:1px solid #CFE5EA !important; text-align:center !important;
                        vertical-align:middle !important; font-size:15px !important;
                        line-height:1.4 !important; padding:8px 6px !important;
                    }
                    .amount-box {width:34%; margin-left:auto; margin-right:0; border-collapse:collapse; margin-top:6px;}
                    .amount-box td {border:1px solid #CFE5EA !important; background:#fff !important; font-size:15px !important; padding:6px 8px !important;}

                    /* Multi-page behavior */
                    table[name="training_line_table"] thead,
                    table[name="instructor_line_table"] thead {
                        display: table-header-group !important;
                    }

                    table[name="training_line_table"] tr,
                    table[name="instructor_line_table"] tr,
                    .amount-box tr {
                        page-break-inside: avoid !important;
                    }

                    .po-terms {
                        margin-top: 30px;
                        page-break-inside: auto !important;
                    }

                    .po-terms p {
                        margin-top: 0 !important;
                        margin-bottom: 5px !important;
                    }

                    .po-signature-block {
                        margin-top: 14px;
                        text-align: right;
                        white-space: nowrap;
                        page-break-inside: avoid !important;
                        page-break-before: avoid !important;
                    }

                    .po-signature-block img {
                        display: inline-block;
                        vertical-align: bottom;
                    }
                </style>

                <div class="row" style="margin:0 0 4px 0; padding:0;">
                    <div class="col-12" style="margin:0; padding:0;">
                        <span style="font-size:30px; font-weight:700; color:#0DCAF0;">
                            <t t-if="is_clc_order">Work Order</t>
                            <t t-else="">Purchase Order</t>
                        </span>
                    </div>
                </div>

                <div class="row" style="margin-top:18px; padding-bottom:12px;">
                    <div class="col-8 po-vendor-info">
                        <div>
                            <strong>
                                <span t-if="is_instructor_po">Service Provider:</span>
                                <span t-else="">Company Name:</span>
                            </strong>
                        </div>
                        <div style="margin-bottom:4px;">
                            <span t-if="is_instructor_po and o.instructor_id"
                                  t-field="o.instructor_id.name"/>
                            <span t-else=""
                                  t-field="vendor_partner.name"/>
                        </div>
                        <t t-if="vendor_partner.street or vendor_partner.street2 or vendor_partner.city or vendor_partner.zip">
                            <div><strong>Address:</strong></div>
                            <div>
                                <span t-if="vendor_partner.street" t-field="vendor_partner.street"/>
                                <t t-if="vendor_partner.street2">
                                    <t t-if="vendor_partner.street">, </t>
                                    <span t-field="vendor_partner.street2"/>
                                </t>
                            </div>
                            <div style="margin-bottom:3px;">
                                <span t-if="vendor_partner.city" t-field="vendor_partner.city"/>
                                <t t-if="vendor_partner.state_id">
                                    <t t-if="vendor_partner.city">, </t>
                                    <span t-field="vendor_partner.state_id.name"/>
                                </t>
                                <t t-if="vendor_partner.zip">
                                    <t t-if="vendor_partner.city or vendor_partner.state_id"> </t>
                                    <span t-field="vendor_partner.zip"/>
                                </t>
                                <t t-if="vendor_partner.country_id">
                                    <t t-if="vendor_partner.city or vendor_partner.state_id or vendor_partner.zip">, </t>
                                    <span t-field="vendor_partner.country_id.name"/>
                                </t>
                            </div>
                        </t>
                        <div t-if="o.partner_id.email or vendor_partner.email">
                            <strong>Email:</strong>
                            <span t-if="o.partner_id.email" t-field="o.partner_id.email"/>
                            <span t-else="" t-field="vendor_partner.email"/>
                        </div>
                        <div t-if="vendor_partner.vat"><strong>Tax Number:</strong> <span t-field="vendor_partner.vat"/></div>
                    </div>
                    <div class="col-4 po-meta">
                        <table class="table table-borderless" style="margin:0; width:100%;">
                            <tr>
                                <td style="width:52%;"><span t-if="is_clc_order">Work Order</span><span t-else="">Purchase Order</span></td>
                                <td>
                                    <span t-if="is_clc_order" t-esc="o.name.replace('PO-', 'WO-', 1) if o.name.startswith('PO-') else ('WO-' + o.name if not o.name.startswith('WO-') else o.name)"/>
                                    <span t-else="" t-field="o.name"/>
                                </td>
                            </tr>
                            <tr><td>Date</td><td><span t-field="o.date_order" t-options="{&quot;widget&quot;:&quot;date&quot;}"/></td></tr>
                            <tr t-if="o.partner_ref"><td>Reference</td><td><span t-field="o.partner_ref"/></td></tr>
                        </table>
                    </div>
                </div>

                <!-- Training Vendor PO -->
                <t t-if="not is_instructor_po">
                    <table t-if="o.display_training_table and o.training_course_ids"
                           class="table table-sm table-bordered" name="training_line_table">
                        <thead><tr>
                            <th>Item</th>
                            <th><span t-if="is_cisco_u_all_access">Subscription Name</span><span t-else="">Training Name</span></th>
                            <th t-if="o.display_description">Description</th>
                            <th t-if="o.display_instructor">Instructor Name</th>
                            <th><span t-if="is_cisco_u_all_access"># Of Subscriptions</span><span t-else=""># Of Students</span></th>
                            <th t-if="not is_cisco_u_all_access and (o.display_location or o.display_where)">Location</th>
                            <th t-if="not is_cisco_u_all_access">Duration</th>
                            <th t-if="not is_cisco_u_all_access">Training Dates</th>
                        </tr></thead>
                        <tbody>
                            <t t-set="item" t-value="1"/>
                            <t t-foreach="o.training_course_ids" t-as="training">
                                <tr>
                                    <td><span t-esc="item"/></td>
                                    <td style="text-align:left !important;">
                                        <a t-if="training.hyperlink" t-att-href="training.hyperlink" style="color:inherit; text-decoration:none;"><span t-field="training.training_id"/></a>
                                        <span t-else="" t-field="training.training_id"/>
                                    </td>
                                    <td t-if="o.display_description" style="text-align:left !important;"><span t-field="training.descriptions"/></td>
                                    <td t-if="o.display_instructor"><span t-field="training.instructor_id.name"/></td>
                                    <td><span t-field="training.no_of_student"/></td>
                                    <td t-if="not is_cisco_u_all_access and (o.display_location or o.display_where)">
                                        <span t-if="o.display_location" t-field="training.location"/>
                                        <span t-if="o.display_location and o.display_where and training.location and training.where_location2">, </span>
                                        <span t-if="o.display_where" t-field="training.where_location2"/>
                                    </td>
                                    <td t-if="not is_cisco_u_all_access"><span t-field="training.duration"/></td>
                                    <td t-if="not is_cisco_u_all_access"><span t-field="training.training_date_start"/> <span t-if="training.training_date_start and training.training_date_end">-</span> <span t-field="training.training_date_end"/></td>
                                </tr>
                                <t t-set="item" t-value="item + 1"/>
                            </t>
                        </tbody>
                    </table>

                    <table t-if="o.display_total" class="amount-box">
                        <tr>
                            <td style="width:66%; color:#075E68; font-weight:700; white-space:nowrap;">
                                <span t-if="is_clc_order">NIL ME Invoice Amount</span><span t-else="">Partner Invoice Amount</span>
                            </td>
                            <td style="width:34%; text-align:right; font-weight:700; white-space:nowrap;">
                                <span t-out="o.amount_total" t-options="{&quot;widget&quot;:&quot;monetary&quot;,&quot;display_currency&quot;:o.currency_id}"/>
                            </td>
                        </tr>
                    </table>
                </t>

                <!-- Instructor PO -->
                <t t-if="is_instructor_po">
                    <table class="table table-sm table-bordered" name="instructor_line_table">
                        <thead><tr>
                            <th>Training Name</th><th>Instructor</th><th>From</th><th>To</th><th>Days</th><th>Daily Rate</th><th>Total</th>
                        </tr></thead>
                        <tbody><tr>
                            <td style="text-align:left !important;"><span t-field="o.instructor_training_course_id.training_id"/></td>
                            <td><span t-field="o.instructor_id.name"/></td>
                            <td><span t-field="o.instructor_from"/></td>
                            <td><span t-field="o.instructor_to"/></td>
                            <td><span t-field="o.instructor_days"/></td>
                            <td style="white-space:nowrap;"><span t-field="o.instructor_daily_rate" t-options="{&quot;widget&quot;:&quot;monetary&quot;,&quot;display_currency&quot;:o.currency_id}"/></td>
                            <td style="white-space:nowrap; font-weight:700;"><span t-out="o.amount_total" t-options="{&quot;widget&quot;:&quot;monetary&quot;,&quot;display_currency&quot;:o.currency_id}"/></td>
                        </tr></tbody>
                    </table>
                </t>

                <div t-if="o.end_customer_id" class="po-text" style="margin-top:10px;">
                    <strong>End Customer:</strong> <span t-field="o.end_customer_id"/>
                </div>

                <div class="po-text po-terms">
                    <div style="color:#075E68; font-size:16px; font-weight:700; margin-bottom:8px;">Terms &amp; Conditions:</div>
                    <div t-if="o.term_and_cond"
                         t-field="o.term_and_cond"
                         style="text-align:justify; margin:0; padding:0;"/>
                </div>

                <div t-if="is_instructor_po"
                     class="po-text"
                     style="
                         margin-top:16px;
                         page-break-inside:avoid;
                         width:100%;
                     ">

                    <div style="margin:0;">
                        <strong>Instructor Name:</strong>
                        <span t-if="o.instructor_id"
                              t-field="o.instructor_id.name"/>
                    </div>

                    <!-- Space reserved for handwritten signature -->
                    <div style="height:55px;"></div>

                    <div style="margin:0;">
                        <strong>Instructor Signature:</strong>
                        <span style="
                            display:inline-block;
                            width:220px;
                            margin-left:8px;
                            border-bottom:1px solid #000;
                            height:18px;
                            vertical-align:bottom;
                         ">&#160;</span>
                    </div>

                </div>

                <div t-if="(o.company_id.stamp and o.display_stamp) or (o.company_id.signature and o.display_signature)"
                     class="po-signature-block">
                    <img t-if="o.company_id.signature and o.display_signature"
                         t-att-src="image_data_uri(o.company_id.signature)"
                         style="max-height:95px; max-width:155px; width:auto; height:auto; object-fit:contain; margin-right:8px;"
                         alt="Signature"/>
                    <img t-if="o.company_id.stamp and o.display_stamp"
                         t-att-src="image_data_uri(o.company_id.stamp)"
                         style="max-height:130px; max-width:175px; width:auto; height:auto; object-fit:contain;"
                         alt="Stamp"/>
                </div>

            </t>
        </xpath>
    </template>
</odoo>
