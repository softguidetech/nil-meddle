<odoo>
    <template id="zatca_invoice" name="ZATCA Invoice Report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="invoice_training_details.custom_invoice_report_layout">
                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>
                    <div class="row">
                        <div class="col-12">
                            <span class="h4 text-info">TAX INVOICE / فاتورة ضريبية</span>
                        </div>
                    </div>

                    <div class="row pt-3 pb-3">
                        <div class="col-8">
                            <strong t-if="o.partner_id.is_company == True">Company Name / اسم الشركة:</strong><br/>
                            <div t-if="o.partner_id.is_company == True" t-field="o.partner_id.name"/>
                            <strong t-if="o.partner_id.is_company == False">Company Name / اسم الشركة:</strong><br/>
                            <div t-if="o.partner_id.is_company == False" t-field="o.partner_id.parent_id.name"/>
                            TAX#: / الرقم الضريبي: <strong t-field="o.partner_id.vat"/><br/>
                            <strong t-if="o.partner_id.is_company == False">Attention / للإنتباه:</strong><br/>
                            <div t-if="o.partner_id.is_company == False" t-field="o.partner_id.name"/>
                        </div>
                        <div class="col-4">
                            <div>
                                <table class="table table-borderless">
                                    <tr class="p-0">
                                        <td class="p-0">INVOICE / الفاتورة</td>
                                        <td class="p-0"><span t-field="o.name"/></td>
                                    </tr>
                                    <tr class="p-0">
                                        <td class="p-0">Date / التاريخ</td>
                                        <td class="p-0"><span t-field="o.invoice_date"/></td>
                                    </tr>
                                    <tr class="p-0" t-if="o.invoice_payment_term_id">
                                        <td class="p-0">Payment Terms / شروط الدفع</td>
                                        <td class="p-0"><span t-field="o.invoice_payment_term_id"/></td>
                                    </tr>
                                    <tr class="p-0">
                                        <td class="p-0">Due Date / تاريخ الاستحقاق</td>
                                        <td class="p-0"><span t-field="o.invoice_date_due"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <table class="table table-sm o_main_table table-borderless" name="invoice_line_table">
                        <thead class="bg-light text-info">
                            <tr>
                                <th name="th_description" class="text-start"><span>DESCRIPTION / الوصف</span></th>
                                <th name="th_quantity" class="text-end"><span>QTY / الكمية</span></th>
                                <th name="th_rate" class="text-end"><span>RATE / السعر</span></th>
                                <th name="th_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes / الضرائب</span></th>
                                <th name="th_amount" class="text-end"><span>Taxable Amount / المبلغ الخاضع للضريبة</span></th>
                                <th name="th_amount" class="text-end"><span>Total Tax.inc / إجمالي الضريبة شاملة</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <tr>
                                    <td class="text-start" style="max-width:50px;"><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                                    <td name="td_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                        <span t-out="taxes" id="line_tax_ids">Tax / ضريبة</span>
                                    </td>
                                    <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                    <td class="text-end"><span t-field="line.price_total"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Course Details Table -->
                    <div class="row pt-3 pb-2">
                        <div class="col-12">
                            Training Courses Details: / تفاصيل الدورات التدريبية: <span t-field="o.training_name"/>
                        </div>
                    </div>

                    <table t-if="o.display_training_table" class="table table-sm o_main_table table-bordered text-center" name="training_line_table">
                        <thead>
                            <tr>
                                <th name="th_item" style="text-align: center; vertical-align: middle;"><span>Item / العنصر</span></th>
                                <th name="th_training_name" style="text-align: center; vertical-align: middle;"><span>Training Name / اسم الدورة التدريبية</span></th>
                                <th t-if="o.display_description" name="th_training_name" style="text-align: center; vertical-align: middle;"><span>Description / الوصف</span></th>
                                <th t-if="o.display_instructor" name="th_training_name" style="text-align: center; vertical-align: middle;"><span>Instructor Name / اسم المدرب</span></th>
                                <th name="th_training_name" style="text-align: center; vertical-align: middle;"><span>Language / اللغة</span></th>
                                <th name="th_of_students" style="text-align: center; vertical-align: middle;"><span># Of Students / عدد الطلاب</span></th>
                                <th t-if="o.display_location" name="th_training_name" style="text-align: center; vertical-align: middle;"><span>Location / الموقع</span></th>
                                <th t-if="o.display_where" name="th_training_name" style="text-align: center; vertical-align: middle;"><span>Where? / أين؟</span></th>
                                <th name="th_duration" style="text-align: center; vertical-align: middle;"><span>Duration / المدة</span></th>
                                <th name="th_training_date" style="text-align: center; vertical-align: middle;"><span>Training Dates / تواريخ الدورة</span></th>
                                <th name="th_training_date" style="text-align: center; vertical-align: middle;"><span>Training Price / سعر الدورة</span></th>

                                <th t-if="o.display_total" name="th_training_date" style="max-width:80px;text-align: center; vertical-align: middle;"> <span>Total Price / السعر الإجمالي</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="item" t-value="1"/>
                            <t t-set="total_rows" t-value="len(o.training_course_ids)"/>
                            <t t-foreach="o.training_course_ids" t-as="training">
                                <tr>
                                    <td style="text-align: center; vertical-align: middle;"><span t-esc="item"/></td>
                                    <td style="text-align: center; vertical-align: middle;"><span t-field="training.training_id"/></td>
                                    <td t-if="o.display_description" style="text-align: center; vertical-align: middle;"><span t-field="training.descriptions"/></td>
                                    <td t-if="o.display_instructor" style="text-align: center; vertical-align: middle;"><span t-field="training.instructor_id.name"/></td>
                                    <td style="text-align: center; vertical-align: middle;"><span t-field="training.train_language"/></td>
                                    <td style="text-align: center; vertical-align: middle;"><span t-field="training.no_of_student"/></td>
                                    <td t-if="o.display_location" style="text-align: center; vertical-align: middle;"><span t-field="training.location"/></td>
                                    <td t-if="o.display_where" style="text-align: center; vertical-align: middle;"><span t-field="training.where"/></td>
                                    <td style="text-align: center; vertical-align: middle;"><span t-field="training.duration"/></td>
                                    <td style="text-align: center; vertical-align: middle;"><span t-field="training.training_date"/></td>
                                    <td style="text-align: center; vertical-align: middle;"><span t-field="training.training_price"/></td>
                                    <td t-if="o.display_total" style="text-align: center; vertical-align: middle;"><span t-field="training.total_price"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                </t>
            </t>
        </t>
    </template>
</odoo>
