<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sales_commission_tree" model="ir.ui.view">
        <field name="name">nil.sales.commission.tree</field>
        <field name="model">nil.sales.commission</field>
        <field name="arch" type="xml">
            <tree string="Commission Ledger"
                  create="1"
                  edit="1"
                  delete="1"
                  decoration-success="state == 'paid'"
                  decoration-warning="state == 'draft'"
                  decoration-muted="state == 'excluded'">

                <field name="commission_date"
                       string="Invoice Date"/>

                <field name="invoice_id"/>

                <field name="invoice_state"
                       optional="show"/>

                <field name="salesperson_id"
                       string="Commission For"/>

                <field name="lead_id"
                       optional="show"/>

                <field name="customer_id"/>

                <field name="currency_id"
                       column_invisible="1"/>

                <field name="training_value"
                       sum="Total Training Value"/>

                <field name="commission_rate"/>

                <field name="commission_amount"
                       sum="Total Commission"/>

                <field name="state"
                       widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'paid'"
                       decoration-muted="state == 'excluded'"/>

                <field name="auto_key"
                       string="Type"
                       optional="show"/>

                <field name="is_auto_ruba"
                       column_invisible="1"/>

                <field name="payment_date"
                       optional="show"/>

                <field name="move_id"
                       optional="show"/>

            </tree>
        </field>
    </record>

    <record id="view_sales_commission_form" model="ir.ui.view">
        <field name="name">nil.sales.commission.form</field>
        <field name="model">nil.sales.commission</field>
        <field name="arch" type="xml">

            <form string="Sales Commission"
                  create="1"
                  edit="1"
                  delete="1">

                <header>

                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>

                    <button name="action_exclude"
                            type="object"
                            string="Exclude"
                            invisible="state in ('paid', 'excluded')"/>

                    <button name="action_reset_draft"
                            type="object"
                            string="Reset to Draft"
                            invisible="state == 'draft'"/>

                    <button name="action_mark_paid"
                            type="object"
                            string="Mark Paid"
                            class="oe_highlight"
                            invisible="state != 'pending'"/>

                    <button name="action_open_move"
                            type="object"
                            string="Journal Entry"
                            invisible="not move_id"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,pending,paid,excluded"/>

                </header>

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   readonly="1"/>
                        </h1>
                    </div>

                    <group>

                        <group string="Invoice / Deal Reference">

                            <field name="invoice_id"
                                   readonly="state == 'paid'"/>

                            <field name="invoice_state"
                                   readonly="1"/>

                            <field name="lead_id"
                                   readonly="state == 'paid'"/>

                            <field name="customer_id"
                                   readonly="state == 'paid'"/>

                            <field name="commission_date"
                                   string="Invoice Date"
                                   readonly="state == 'paid'"/>

                        </group>

                        <group string="Commission">

                            <field name="auto_key"
                                   invisible="1"/>

                            <field name="is_auto_ruba"
                                   invisible="1"/>

                            <field name="excluded_by_invoice"
                                   invisible="1"/>

                            <field name="salesperson_id"
                                   string="Commission For"
                                   readonly="state == 'paid' or auto_key in ('ruba', 'salesperson')"/>

                            <field name="commission_rate"
                                   readonly="state == 'paid' or auto_key in ('ruba', 'salesperson')"/>

                            <field name="currency_id"
                                   readonly="state == 'paid'"/>

                            <field name="training_value"
                                   readonly="state == 'paid'"/>

                            <field name="commission_amount"
                                   readonly="1"/>

                            <field name="aed_currency_id"
                                   invisible="1"/>

                            <field name="commission_amount_aed"
                                   string="Commission Amount AED (3.6725)"
                                   readonly="1"/>

                        </group>

                    </group>

                    <separator string="Profit Margin"
                               invisible="not lead_id"/>

                    <div class="d-flex flex-wrap gap-2 w-100 mt-2 mb-3"
                         invisible="not lead_id"
                         style="width: 100%;">

                        <div class="border rounded p-2 bg-light"
                             style="flex: 0 1 180px; min-width: 180px; max-width: 210px;">
                            <div class="text-muted fw-bold mb-1">
                                Learning Partner
                            </div>
                            <div class="fs-5 fw-bold">
                                <field name="profit_learning_partner"
                                       nolabel="1"
                                       readonly="1"/>
                            </div>
                        </div>

                        <div class="border rounded p-2 bg-light"
                             style="flex: 0 1 180px; min-width: 180px; max-width: 210px;">
                            <div class="text-muted fw-bold mb-1">
                                Total Costs
                            </div>
                            <div class="fs-5 fw-bold">
                                <field name="profit_total_costs"
                                       nolabel="1"
                                       readonly="1"/>
                            </div>
                        </div>

                        <div class="border rounded p-2 bg-light"
                             style="flex: 0 1 180px; min-width: 180px; max-width: 210px;">
                            <div class="text-muted fw-bold mb-1">
                                NIL ME Share $
                            </div>
                            <div class="fs-5 fw-bold">
                                <field name="profit_nilme_share"
                                       nolabel="1"
                                       readonly="1"/>
                            </div>
                        </div>

                        <div class="border rounded p-2 bg-light"
                             style="flex: 0 1 180px; min-width: 180px; max-width: 210px;">
                            <div class="text-muted fw-bold mb-1">
                                Margin (%)
                            </div>
                            <div class="fs-5 fw-bold">
                                <field name="profit_margin_pct"
                                       nolabel="1"
                                       readonly="1"
                                       widget="percentage"/>
                            </div>
                        </div>

                    </div>

                    <group string="Payment / Accounting"
                           invisible="state in ('draft', 'excluded', 'cancelled')">

                        <group>

                            <field name="company_id"
                                   readonly="state == 'paid'"/>

                            <field name="payment_journal_id"
                                   readonly="state == 'paid'"/>

                            <field name="expense_account_id"
                                   readonly="state == 'paid'"/>

                            <field name="payment_account_id"
                                   readonly="state == 'paid'"/>

                        </group>

                        <group>

                            <field name="payment_date"
                                   readonly="1"/>

                            <field name="move_id"
                                   readonly="1"/>

                        </group>

                    </group>

                    <group>
                        <field name="notes"
                               placeholder="Optional notes..."/>
                    </group>

                </sheet>

            </form>

        </field>
    </record>

    <record id="view_sales_commission_search" model="ir.ui.view">
        <field name="name">nil.sales.commission.search</field>
        <field name="model">nil.sales.commission</field>
        <field name="arch" type="xml">

            <search string="Commission Ledger">

                <field name="name"/>
                <field name="invoice_id"/>
                <field name="salesperson_id"/>
                <field name="lead_id"/>
                <field name="customer_id"/>

                <separator/>

                <filter name="draft"
                        string="Draft"
                        domain="[('state', '=', 'draft')]"/>

                <filter name="approved"
                        string="Approved"
                        domain="[('state', '=', 'pending')]"/>

                <filter name="paid"
                        string="Paid"
                        domain="[('state', '=', 'paid')]"/>

                <filter name="excluded"
                        string="Excluded"
                        domain="[('state', '=', 'excluded')]"/>

                <filter name="ruba_auto"
                        string="Ruba 1.5%"
                        domain="[('auto_key', '=', 'ruba')]"/>

                <filter name="fixed_sales"
                        string="Loudy / Baraa Fixed"
                        domain="[('auto_key', '=', 'salesperson')]"/>

                <separator/>

                <filter name="group_salesperson"
                        string="Commission For"
                        context="{'group_by': 'salesperson_id'}"/>

                <filter name="group_customer"
                        string="Customer"
                        context="{'group_by': 'customer_id'}"/>

                <filter name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"/>

                <filter name="group_invoice_state"
                        string="Invoice Status"
                        context="{'group_by': 'invoice_state'}"/>

                <filter name="group_month"
                        string="Month"
                        context="{'group_by': 'commission_date:month'}"/>

            </search>

        </field>
    </record>

    <record id="view_sales_commission_pivot" model="ir.ui.view">
        <field name="name">nil.sales.commission.pivot</field>
        <field name="model">nil.sales.commission</field>
        <field name="arch" type="xml">

            <pivot string="Commission Analysis">
                <field name="salesperson_id"
                       type="row"/>
                <field name="commission_date"
                       interval="month"
                       type="col"/>
                <field name="commission_amount"
                       type="measure"/>
                <field name="training_value"
                       type="measure"/>
            </pivot>

        </field>
    </record>

    <record id="action_sales_commission" model="ir.actions.act_window">
        <field name="name">Commission Ledger</field>
        <field name="res_model">nil.sales.commission</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="search_view_id"
               ref="view_sales_commission_search"/>
        <!-- Excluded rows disappear from the normal working ledger. -->
        <field name="domain">[('state', '!=', 'excluded')]</field>
    </record>

    <record id="action_sales_commission_excluded" model="ir.actions.act_window">
        <field name="name">Excluded Invoices</field>
        <field name="res_model">nil.sales.commission</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id"
               ref="view_sales_commission_search"/>
        <!-- Dedicated place to recover excluded rows. -->
        <field name="domain">[('state', '=', 'excluded')]</field>
    </record>

    <record id="action_sales_commission_analysis" model="ir.actions.act_window">
        <field name="name">Commission Analysis</field>
        <field name="res_model">nil.sales.commission</field>
        <field name="view_mode">pivot,tree,form</field>
        <field name="search_view_id"
               ref="view_sales_commission_search"/>
    </record>

    <menuitem id="menu_nil_commission_root"
              name="Commissions"
              parent="crm.crm_menu_root"
              sequence="18"
              groups="nil_sales_commission.group_nil_commission_manager"/>

    <menuitem id="menu_nil_commission_ledger"
              name="Commission Ledger"
              parent="menu_nil_commission_root"
              action="action_sales_commission"
              sequence="1"
              groups="nil_sales_commission.group_nil_commission_manager"/>

    <menuitem id="menu_nil_commission_excluded"
              name="Excluded Invoices"
              parent="menu_nil_commission_root"
              action="action_sales_commission_excluded"
              sequence="2"
              groups="nil_sales_commission.group_nil_commission_manager"/>

    <menuitem id="menu_nil_commission_analysis"
              name="Analysis"
              parent="menu_nil_commission_root"
              action="action_sales_commission_analysis"
              sequence="3"
              groups="nil_sales_commission.group_nil_commission_manager"/>

</odoo>
